---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';

type Props = {
	title: string;
	description: string;
	tags: string[];
	image?: string;
	category?: string;
	featured?: boolean;
	link: string;
	linkLabel: string;
	repoUrl?: string;
	liveUrl?: string;
};

const {
	title,
	description,
	tags,
	image,
	category,
	featured,
	link,
	linkLabel,
	repoUrl,
	liveUrl
} = Astro.props as Props;

const isExternalLink = link.startsWith('https://') || link.startsWith('http://');
---

<Card as="article" hover={true} class:list={['project-card', { 'card-glow': featured }]} padding="compact">
	{
		image ? (
			<div class="project-card-media">
				<img class="project-card-image" src={image} alt={title} loading="lazy" />
			</div>
		) : null
	}
	{category ? <p class="project-card-category">{category}</p> : null}
	<h3 class="heading-reset">{title}</h3>
	<p class="muted-copy">{description}</p>
	<div class="tag-row">
		{tags.map((tag) => (
			<Tag>{tag}</Tag>
		))}
	</div>
	<div class="action-row">
		<Button
			variant="secondary"
			href={link}
			target={isExternalLink ? '_blank' : undefined}
			rel={isExternalLink ? 'noreferrer' : undefined}
		>
			{linkLabel}
		</Button>
	</div>
</Card>

<style>
	.project-card-category {
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-weight: 700;
		font-size: 0.75rem;
		line-height: 1;
		color: var(--color-accent);
		margin: 0;
	}
</style>
