---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
import { isExternalHref, sanitizeHref } from '../../lib/url';

type Props = {
	title: string;
	description: string;
	tags: string[];
	image?: string;
	featured?: boolean;
	link: string;
	repoUrl?: string;
	liveUrl?: string;
};

const {
	title,
	description,
	tags,
	image,
	featured,
	link,
	repoUrl,
	liveUrl
} = Astro.props as Props;

const projectUrl = sanitizeHref(liveUrl ?? link);
const isExternalProjectLink = isExternalHref(projectUrl);
const githubUrl = repoUrl && repoUrl !== projectUrl ? sanitizeHref(repoUrl) : undefined;
const isExternalGithubLink = githubUrl ? isExternalHref(githubUrl) : false;
---

<Card as="article" hover={false} class:list={['project-card', { 'card-glow': featured }]} padding="compact">
	{
		image ? (
			<div class="project-card-media">
				<img class="project-card-image" src={image} alt={title} loading="lazy" />
			</div>
		) : null
	}
	<h3 class="heading-reset">{title}</h3>
	<p class="muted-copy">{description}</p>
	<div class="tag-row">
		{tags.map((tag) => (
			<Tag class="project-skill-tag" hover={false}>{tag}</Tag>
		))}
	</div>
	<div class="action-row">
			<Button
				variant="secondary"
				href={projectUrl}
				target={isExternalProjectLink ? '_blank' : undefined}
				rel={isExternalProjectLink ? 'noopener noreferrer' : undefined}
			>
				View Project
			</Button>
		{githubUrl ? (
				<Button
					variant="secondary"
					href={githubUrl}
					target={isExternalGithubLink ? '_blank' : undefined}
					rel={isExternalGithubLink ? 'noopener noreferrer' : undefined}
				>
				View on GitHub
			</Button>
		) : null}
	</div>
</Card>

<style>
	.project-card :global(.project-skill-tag),
	.project-card :global(.project-skill-tag:hover),
	.project-card :global(.project-skill-tag:focus-visible) {
		transform: none;
		background: color-mix(in srgb, var(--color-accent) 12%, transparent);
	}
</style>
