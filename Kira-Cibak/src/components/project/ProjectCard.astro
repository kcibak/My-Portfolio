---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';

type Props = {
	title: string;
	description: string;
	tags: string[];
	image?: string;
	link: string;
	linkLabel: string;
};

const {
	title,
	description,
	tags,
	image,
	link,
	linkLabel
} = Astro.props as Props;

const isExternalLink = link.startsWith('https://') || link.startsWith('http://');
---

<Card as="article" class="project-card" padding="compact">
	{
		image ? (
			<div class="project-card-media">
				<img class="project-card-image" src={image} alt={title} loading="lazy" />
			</div>
		) : null
	}
	<h3 class="heading-reset">{title}</h3>
	<p class="muted-copy">{description}</p>
	<div class="tag-row">
		{tags.map((tag) => (
			<Tag>{tag}</Tag>
		))}
	</div>
	<Button
		variant="secondary"
		href={link}
		target={isExternalLink ? '_blank' : undefined}
		rel={isExternalLink ? 'noreferrer' : undefined}
	>
		{linkLabel}
	</Button>
</Card>
