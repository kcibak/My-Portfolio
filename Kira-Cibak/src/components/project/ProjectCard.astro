---
import Button from '../ui/Button.astro';

type Props = {
	title: string;
	description: string;
	tags: string[];
	href: string;
	imageLabel?: string;
	imageSize?: 'small' | 'medium' | 'large';
	ctaLabel?: string;
	density?: 'default' | 'cozy';
};

const {
	title,
	description,
	tags,
	href,
	imageLabel = 'Project image placeholder',
	imageSize = 'small',
	ctaLabel = 'Read case study',
	density = 'default'
} = Astro.props as Props;
---

<article class:list={['card', 'project-card', density === 'cozy' && 'project-card-cozy']}>
	<div class:list={[
		'placeholder-image',
		imageSize === 'small' && 'placeholder-image-small',
		imageSize === 'medium' && 'placeholder-image-medium',
		imageSize === 'large' && 'placeholder-image-large'
	]}>{imageLabel}</div>
	<h3 class="heading-reset">{title}</h3>
	<p class="muted-copy">{description}</p>
	<div class="tag-row-tight">
		{tags.map((tag) => (
			<span class="tag">{tag}</span>
		))}
	</div>
	<Button variant="secondary" href={href}>
		{ctaLabel}
	</Button>
</article>
