---
import Card from '../ui/Card.astro';

type Props = {
	title: string;
	description: string;
};

const {
	title,
	description
} = Astro.props as Props;
---

<Card class="project-feature-card" padding="dense">
	<h3 class="heading-tight">{title}</h3>
	<p class="muted-copy">{description}</p>
</Card>
