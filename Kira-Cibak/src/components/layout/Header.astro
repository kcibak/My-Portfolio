---
import ThemeToggleButton from '../ui/ThemeToggleButton.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
	{ href: '/about', label: 'About' },
	{ href: '/skills', label: 'Skills & Experience' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/contact', label: 'Contact' }
];

const resumeHref = '/Kira%20Cibak_2025.pdf';

const socials = [
	{ href: 'https://www.linkedin.com/in/kira-cibak/', label: 'LinkedIn', icon: 'linkedin' },
	{ href: 'https://github.com/kcibak', label: 'GitHub', icon: 'github' }
];

const emailAddress = 'kiracibakcodes@gmail.com';
---

	<header class="dome-header" id="site-header">
		<div class="desktop-theme-toggle">
			<ThemeToggleButton />
		</div>
	<button
		class="mobile-toggle"
		id="mobile-menu-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="mobile-menu"
		aria-label="Open navigation menu"
	>
		<svg class="toggle-icon" aria-hidden="true" viewBox="0 0 64 64" width="24" height="24">
			<path d="M32 4 8 32l24 28 24-28L32 4Z" fill="currentColor" />
			<path d="M32 4 18 32l14 28 14-28L32 4Z" fill="currentColor" opacity="0.4" />
			<circle cx="32" cy="20" r="4" fill="var(--color-bg)" />
		</svg>
	</button>
	<div class="nav-shell">
		<div class="social-bar">
			{socials.map((link) => (
				<a class="social-icon" href={link.href} aria-label={link.label} target="_blank" rel="noreferrer">
					{link.icon === 'linkedin' ? (
						<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
							<path d="M6.94 9.75V18" />
							<circle cx="6.94" cy="6.94" r="1.44" />
							<path d="M12 18v-5.21c0-1.53 1.24-2.77 2.77-2.77s2.77 1.24 2.77 2.77V18" />
						</svg>
					) : (
						<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
							<path d="M9 19c-4 1-4-2-6-2m12 4v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7a5.44 5.44 0 0 0-1.5-3.75 5.07 5.07 0 0 0-.09-3.77S18.16-1 15 1.38a13.38 13.38 0 0 0-6 0C5-1 3.09 1 3.09 1a5.07 5.07 0 0 0-.09 3.77A5.44 5.44 0 0 0 1.5 8.5c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 7 18.13V22" />
						</svg>
					)}
				</a>
			))}
			<a
				class="social-icon resume-link"
				href={resumeHref}
				aria-label="View Resume"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
					<path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z" />
					<path d="M14 2v5h5" />
					<path d="M9 13h6" />
					<path d="M9 17h6" />
				</svg>
				<span class="copy-tooltip" id="resume-tooltip" role="tooltip" aria-hidden="true">View resume</span>
			</a>
			<button
				class="social-icon copy"
				id="email-copy"
				type="button"
				aria-label={`Copy ${emailAddress}`}
				data-email={emailAddress}
			>
				<span class="sr-only">Copy email address</span>
				<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
					<path d="m3 8 7.89 4.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/>
				</svg>
				<span class="copy-tooltip" id="email-tooltip" role="tooltip" aria-hidden="true"></span>
			</button>
		</div>
		<a href="/" class="brand">Kira Cibak</a>
		<div class="nav-balance" aria-hidden="true"></div>
	</div>
	<nav id="parabola-menu" class="parabola-menu" aria-label="Primary navigation">
		{links.map((link, index) => (
			<a
			href={link.href}
			style={`--arc-offset:${Math.abs((links.length - 1) / 2 - index)};`}
			{...(currentPath === link.href || currentPath.startsWith(link.href + '/') ? { 'aria-current': 'page' } : {})}
		>{link.label}</a>
		))}
	</nav>

	<div
		id="mobile-menu"
		class="mobile-menu"
		inert
		role="dialog"
		aria-modal="true"
		aria-label="Navigation menu"
		aria-hidden="true"
		tabindex="-1"
	>
		<button type="button" class="mobile-menu__close" data-mobile-menu-close aria-label="Close navigation menu">
			<svg class="toggle-icon mobile-menu__close-icon" aria-hidden="true" viewBox="0 0 64 64" width="24" height="24">
				<path d="M32 4 8 32l24 28 24-28L32 4Z" fill="currentColor" />
				<path d="M32 4 18 32l14 28 14-28L32 4Z" fill="currentColor" opacity="0.4" />
				<circle cx="32" cy="20" r="4" fill="var(--color-bg)" />
			</svg>
		</button>

		<nav class="mobile-menu__nav" aria-label="Mobile navigation">
			{links.map((link) => (
				<a
					href={link.href}
					{...(currentPath === link.href || currentPath.startsWith(link.href + '/') ? { 'aria-current': 'page' } : {})}
				>{link.label}</a>
			))}
		</nav>

		<div class="mobile-menu__socials">
			{socials.map((link) => (
				<a class="social-icon" href={link.href} aria-label={link.label} target="_blank" rel="noreferrer">
					{link.icon === 'linkedin' ? (
						<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
							<path d="M6.94 9.75V18" />
							<circle cx="6.94" cy="6.94" r="1.44" />
							<path d="M12 18v-5.21c0-1.53 1.24-2.77 2.77-2.77s2.77 1.24 2.77 2.77V18" />
						</svg>
					) : (
						<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
							<path d="M9 19c-4 1-4-2-6-2m12 4v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7a5.44 5.44 0 0 0-1.5-3.75 5.07 5.07 0 0 0-.09-3.77S18.16-1 15 1.38a13.38 13.38 0 0 0-6 0C5-1 3.09 1 3.09 1a5.07 5.07 0 0 0-.09 3.77A5.44 5.44 0 0 0 1.5 8.5c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 7 18.13V22" />
						</svg>
					)}
				</a>
			))}
			<a
				class="social-icon"
				href={resumeHref}
				aria-label="View Resume"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
					<path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z" />
					<path d="M14 2v5h5" />
					<path d="M9 13h6" />
					<path d="M9 17h6" />
				</svg>
			</a>
			<button
				class="social-icon copy"
				id="email-copy-mobile"
				type="button"
				aria-label={`Copy ${emailAddress}`}
				data-email={emailAddress}
			>
				<span class="sr-only">Copy email address</span>
				<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
					<path d="m3 8 7.89 4.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/>
				</svg>
				<span class="copy-tooltip" id="email-tooltip-mobile" role="tooltip" aria-hidden="true"></span>
			</button>
			<div class="mobile-menu__theme-toggle">
				<ThemeToggleButton />
			</div>
		</div>
	</div>

	<div id="mobile-backdrop" class="mobile-backdrop" aria-hidden="true"></div>
</header>

<style>
	:global(.dome-header) {
		position: sticky;
		top: 0;
		width: 100%;
		z-index: 70;
		backdrop-filter: blur(18px);
		background: var(--color-nav);
		border-bottom: 1px solid var(--color-border);
		height: 96px;
		box-shadow: var(--shadow-soft);
		transition: height 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}

	:global(html.dark .dome-header) {
		box-shadow: var(--shadow-soft);
	}

	@media (min-width: 721px) {
		:global(html.dark .dome-header) {
			border-bottom: none;
		}
	}

	:global(.theme-toggle) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		border-radius: var(--radius);
		transition: opacity 0.18s ease;
	}

	.desktop-theme-toggle {
		position: absolute;
		right: 1.2rem;
		top: 50%;
		transform: translateY(-50%);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		z-index: 75;
	}

	.mobile-menu__theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-left: auto;
	}

	:global(.theme-toggle:hover),
	:global(.theme-toggle:focus-visible) {
		opacity: 0.75;
		outline: none;
	}

	:global(.theme-toggle__img) {
		position: absolute;
		inset: 0;
		width: 30px;
		height: 30px;
		object-fit: contain;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	:global(.theme-toggle__icon-frame) {
		position: relative;
		width: 30px;
		height: 30px;
		display: block;
	}

	:global(html[data-theme='light'] .theme-toggle__img--light),
	:global(html[data-theme='dark'] .theme-toggle__img--dark) {
		opacity: 1;
	}

	.nav-shell {
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 1.4rem 1.2rem 1rem;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		transition: padding 0.2s ease, grid-template-columns 0.2s ease;
	}

	.social-bar {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.55rem;
		position: relative;
		z-index: 65;
	}

	.social-icon {
		height: 44px;
		width: 44px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		position: relative;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
		background: var(--color-card);
		color: var(--color-ink);
		box-shadow: var(--shadow-soft);
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
		cursor: pointer;
	}

	.social-icon:hover,
	.social-icon:focus-visible {
		transform: translateY(-1px);
		box-shadow: var(--shadow-soft);
		border-color: var(--color-accent);
		outline: none;
	}

	.copy {
		position: relative;
	}

	.copy-tooltip {
		position: absolute;
		left: 50%;
		top: auto;
		bottom: -2.75rem;
		transform: translateX(-50%) translateY(8px);
		padding: 0.4rem 0.7rem;
		border-radius: var(--radius);
		background: var(--color-ink);
		color: var(--color-bg);
		font-size: var(--type-size-small);
		line-height: var(--type-line-small);
		font-weight: 700;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease, transform 0.2s ease;
		white-space: nowrap;
		box-shadow: var(--shadow-soft);
		z-index: 80;
	}

	.copy-tooltip.show {
		opacity: 1;
		transform: translateX(-50%) translateY(0);
	}

	.brand {
		justify-self: center;
		font-weight: 800;
		font-size: var(--type-size-h2);
		line-height: var(--type-line-h2);
		letter-spacing: -0.03em;
		color: var(--color-ink);
		text-decoration: none;
		transition: transform 0.2s ease;
	}

	.nav-balance {
		justify-self: end;
		width: 44px;
		height: 44px;
	}

	:global(.dome-header.is-condensed) {
		height: 72px;
	}

	:global(.dome-header.is-condensed) .nav-shell {
		grid-template-columns: 1fr;
		padding: 1rem 1.2rem 0.6rem;
	}

	:global(.dome-header.is-condensed) .brand {
		justify-self: center;
		text-align: center;
		transform: none;
	}

	:global(.dome-header.is-condensed) .social-bar {
		opacity: 0;
		pointer-events: none;
		transform: translateY(-6px);
		transition: opacity 0.16s ease, transform 0.16s ease;
		display: none;
	}

	.dome-header {
		position: sticky;
	}

	.parabola-menu {
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		transform: translateY(0) scale(1);
		width: 100%;
		height: clamp(84px, 6vw, 119px);
		opacity: 1;
		pointer-events: auto;
		transition: transform 0.28s ease, opacity 0.28s ease;
		z-index: 60;
		clip-path: ellipse(100% 75% at 50% 0%);
		border-radius: 0 0 var(--radius) var(--radius);
		background: var(--color-nav);
		border: none;
		box-shadow: var(--shadow-soft);
		backdrop-filter: blur(14px);
		display: flex;
		align-items: center;
		justify-content: space-evenly;
		gap: clamp(0.7rem, 2vw, 2rem);
		padding: 0.2rem 2rem 2rem;
		flex-wrap: nowrap;
		overflow-x: auto;
		isolation: isolate;
		--parabola-edge-width: 0px;
		--parabola-edge-highlight-width: 0px;
	}

	:global(.dome-header.is-condensed) .parabola-menu {
		height: clamp(72px, 5.2vw, 96px);
		padding: 0.1rem 1.6rem 1.35rem;
		gap: clamp(0.5rem, 1.5vw, 1.4rem);
	}

	.parabola-menu::before,
	.parabola-menu::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 1;
	}

	.parabola-menu::before {
		background: transparent;
		-webkit-mask: radial-gradient(
			100% 75% at 50% 0%,
			transparent calc(100% - var(--parabola-edge-width)),
			#000 calc(100% - var(--parabola-edge-width))
		);
		mask: radial-gradient(
			100% 75% at 50% 0%,
			transparent calc(100% - var(--parabola-edge-width)),
			#000 calc(100% - var(--parabola-edge-width))
		);
	}

	.parabola-menu::after {
		background: transparent;
		-webkit-mask: radial-gradient(
			100% 75% at 50% 0%,
			transparent calc(100% - var(--parabola-edge-highlight-width)),
			#000 calc(100% - var(--parabola-edge-highlight-width))
		);
		mask: radial-gradient(
			100% 75% at 50% 0%,
			transparent calc(100% - var(--parabola-edge-highlight-width)),
			#000 calc(100% - var(--parabola-edge-highlight-width))
		);
		opacity: 0.98;
	}

	.parabola-menu a {
		font-weight: 500;
		font-size: calc(var(--type-size-body) * 1.15);
		line-height: var(--type-line-body);
		padding: 0.6rem 1rem;
		border-radius: var(--radius);
		color: var(--color-ink);
		transition: opacity 0.1s ease, transform 0.12s ease-out;
		white-space: nowrap;
		letter-spacing: 0.02em;
		position: relative;
		z-index: 3;
		overflow: hidden;
		isolation: isolate;
	}

	:global(.dome-header.is-condensed) .parabola-menu a {
		font-size: calc(var(--type-size-body) * 1.03);
		padding: 0.45rem 0.8rem;
		opacity: 0.86;
	}

	.parabola-menu a::before {
		content: '';
		position: absolute;
		inset: -70% -90%;
		background:
			linear-gradient(
				120deg,
				var(--color-nav-shimmer-0) 0%,
				var(--color-nav-shimmer-1) 28%,
				var(--color-nav-shimmer-2) 42%,
				var(--color-nav-shimmer-3) 56%,
				var(--color-nav-shimmer-4) 70%,
				var(--color-nav-shimmer-5) 84%,
				var(--color-nav-shimmer-0) 100%
			),
			radial-gradient(circle at 28% 50%, var(--color-nav-shimmer-2), var(--color-transparent) 60%),
			radial-gradient(circle at 72% 40%, var(--color-nav-shimmer-3), var(--color-transparent) 65%);
		transform: translateX(-80%);
		opacity: 0;
		filter: blur(1.2px);
		transition: opacity 0s;
		pointer-events: none;
	}

	.parabola-menu a:hover::before,
	.parabola-menu a:focus-visible::before {
		opacity: 1;
		animation: nav-shimmer 2.2s ease-in-out infinite;
	}

	.parabola-menu a:hover,
	.parabola-menu a:focus-visible {
		transform: scale(1.03);
	}

	.parabola-menu a[aria-current='page'] {
		transform: scale(1.03);
	}

	.parabola-menu a[aria-current='page']::before {
		opacity: 1;
		transform: translateX(0);
		animation: none;
	}

	.parabola-menu a:focus-visible {
		outline: 2px solid var(--color-focus-ring);
		outline-offset: 0;
	}

	@keyframes nav-shimmer {
		0% {
			transform: translateX(-80%);
		}
		100% {
			transform: translateX(120%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.parabola-menu a:hover::before,
		.parabola-menu a:focus-visible::before {
			animation: none;
			transform: translateX(0);
			opacity: 0.35;
		}

		.parabola-menu a[aria-current='page']::before {
			opacity: 1;
			transform: translateX(0);
			animation: none;
		}
	}

	/* ── Hidden by default on desktop; revealed inside the mobile media query ── */
	.mobile-toggle {
		display: none;
	}

	.mobile-menu {
		display: none;
		position: fixed;
		top: 0;
		right: 0;
		height: 100dvh;
		width: min(320px, 85vw);
		z-index: 1000;
		flex-direction: column;
		background: var(--color-card);
		border-left: 1px solid var(--color-border);
		box-shadow: -4px 0 32px rgba(0, 0, 0, 0.18);
		transform: translateX(100%);
		transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		padding: calc(env(safe-area-inset-top, 0px) + 5rem) 0 1rem;
		overflow: hidden;
	}

	.mobile-menu.is-open {
		transform: translateX(0);
	}

	.mobile-menu__close {
		position: absolute;
		top: calc(env(safe-area-inset-top, 0px) + 0.9rem);
		right: 1rem;
		width: 44px;
		height: 44px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
		background: var(--color-card);
		color: var(--color-ink);
		box-shadow: var(--shadow-soft);
		cursor: pointer;
		flex-shrink: 0;
	}

	.mobile-menu__close:hover,
	.mobile-menu__close:focus-visible {
		border-color: var(--color-accent);
		outline: none;
	}

	.mobile-menu__close:focus-visible {
		outline: 2px solid var(--color-focus-ring);
		outline-offset: 2px;
	}

	.mobile-menu__nav {
		display: flex;
		flex-direction: column;
		padding: 0.5rem 0 0;
	}

	.mobile-menu__nav a {
		display: block;
		padding: 0.85rem 1.5rem;
		font-size: calc(var(--type-size-body) * 1.2);
		font-weight: 500;
		color: var(--color-ink);
		text-decoration: none;
		letter-spacing: 0.01em;
		border-bottom: 1px solid var(--color-border);
		transition: background 0.15s ease, color 0.15s ease;
	}

	.mobile-menu__nav a:first-child {
		border-top: 1px solid var(--color-border);
	}

	.mobile-menu__nav a:hover,
	.mobile-menu__nav a:focus-visible {
		background: var(--color-bg);
		color: var(--color-accent);
		outline: none;
	}

	.mobile-menu__nav a[aria-current='page'] {
		color: var(--color-accent);
		font-weight: 700;
	}

	.mobile-menu__socials {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding: 1rem 1.5rem 0;
		border-top: 1px solid var(--color-border);
		margin-top: auto;
	}

	#email-tooltip-mobile {
		top: auto;
		bottom: calc(100% + 0.5rem);
		transform: translateX(-50%) translateY(-8px);
	}

	#email-tooltip-mobile.show {
		transform: translateX(-50%) translateY(0);
	}

	.mobile-backdrop {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 999;
		background: rgba(0, 0, 0, 0.38);
		backdrop-filter: blur(2px);
		-webkit-backdrop-filter: blur(2px);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.28s ease;
	}

	.mobile-backdrop.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	/* ── Toggle button base ── */
	.mobile-toggle {
		position: absolute;
		right: 1.2rem;
		top: 50%;
		transform: translateY(-50%);
		display: none;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		z-index: 75;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
		background: var(--color-card);
		color: var(--color-ink);
		box-shadow: var(--shadow-soft);
		cursor: pointer;
		transition: border-color 0.18s ease, color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
	}

	.mobile-toggle:hover,
	.mobile-toggle:focus-visible {
		border-color: var(--color-accent);
		outline: none;
	}

	.toggle-icon {
		transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s ease;
		color: var(--color-ink);
	}

	.mobile-toggle .toggle-icon {
		color: var(--color-accent);
	}

	.mobile-toggle[aria-expanded='true'] .toggle-icon {
		transform: rotate(135deg);
	}

	.mobile-menu.is-open .mobile-menu__close-icon {
		transform: rotate(135deg);
		color: var(--color-accent);
	}

	@media (max-width: 720px) {
		.nav-shell {
			grid-template-columns: 1fr;
			row-gap: 0.75rem;
		}

		.social-bar,
		.parabola-menu,
		.nav-balance,
		.desktop-theme-toggle {
			display: none;
		}

		.brand {
			justify-self: center;
			text-align: center;
		}

		.mobile-toggle {
			display: inline-flex;
		}

		.mobile-backdrop {
			display: block;
		}

		.mobile-menu {
			display: flex;
		}
	}
</style>

<script>
	import {
		getThemeMode,
		initializeThemeStore,
		subscribeToThemeMode,
		toggleThemeMode,
		type ThemeMode
	} from '../../lib/theme';

	const header = document.getElementById('site-header');
	const copyBtn = document.getElementById('email-copy');
	const emailTooltip = document.getElementById('email-tooltip');
	const resumeLink = document.querySelector('.resume-link');
	const resumeTooltip = document.getElementById('resume-tooltip');
	const emailAddress = copyBtn?.dataset.email ?? '';
	let lastScrollY = window.scrollY;
	let ticking = false;
	let isShowingFeedback = false;
	const themeToggleButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
	);

	const syncThemeToggleButton = (button: HTMLButtonElement, mode: ThemeMode) => {
		button.dataset.mode = mode;
		button.setAttribute(
			'aria-label',
			mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
		);
	};

	const setCondensed = (condensed: boolean) => {
		if (!header) return;
		if (condensed) {
			header.classList.add('is-condensed');
		} else {
			header.classList.remove('is-condensed');
		}
	};

	const handleScroll = () => {
		const currentY = window.scrollY;
		const delta = currentY - lastScrollY;
		if (Math.abs(delta) < 8) return;
		if (currentY <= 0) {
			setCondensed(false);
			lastScrollY = currentY;
			return;
		}
		if (delta > 0) {
			setCondensed(true);
		} else {
			setCondensed(false);
		}
		lastScrollY = currentY;
	};

	window.addEventListener(
		'scroll',
		() => {
			if (!ticking) {
				window.requestAnimationFrame(() => {
					handleScroll();
					ticking = false;
				});
				ticking = true;
			}
		},
		{ passive: true }
	);

	handleScroll();

	if (themeToggleButtons.length > 0) {
		initializeThemeStore();
		const applyThemeToggleState = (mode: ThemeMode = getThemeMode()) => {
			themeToggleButtons.forEach((button) => syncThemeToggleButton(button, mode));
		};

		applyThemeToggleState();
		const unsubscribeThemeToggle = subscribeToThemeMode((mode) => applyThemeToggleState(mode));

		themeToggleButtons.forEach((button) => {
			button.addEventListener('click', () => {
				toggleThemeMode();
			});
		});

		window.addEventListener(
			'pagehide',
			() => {
				unsubscribeThemeToggle();
			},
			{ once: true }
		);
	}

	const showTooltip = (el: HTMLElement | null) => {
		if (!el) return;
		el.classList.add('show');
		el.setAttribute('aria-hidden', 'false');
		el.setAttribute('role', 'tooltip');
		el.removeAttribute('aria-live');
	};

	const hideTooltip = (el: HTMLElement | null) => {
		if (!el) return;
		el.classList.remove('show');
		el.setAttribute('aria-hidden', 'true');
	};

	if (resumeLink && resumeTooltip) {
		resumeLink.addEventListener('mouseenter', () => showTooltip(resumeTooltip));
		resumeLink.addEventListener('mouseleave', () => hideTooltip(resumeTooltip));
		resumeLink.addEventListener('focus', () => showTooltip(resumeTooltip));
		resumeLink.addEventListener('blur', () => hideTooltip(resumeTooltip));
	}

	const copyEmail = async () => {
		try {
			await navigator.clipboard.writeText(emailAddress);
			if (!emailTooltip) return;
			emailTooltip.textContent = 'Email copied!';
			emailTooltip.setAttribute('role', 'status');
			emailTooltip.setAttribute('aria-live', 'polite');
			showTooltip(emailTooltip);
			isShowingFeedback = true;
			setTimeout(() => {
				emailTooltip.textContent = '';
				emailTooltip.setAttribute('role', 'tooltip');
				emailTooltip.removeAttribute('aria-live');
				isShowingFeedback = false;
				hideTooltip(emailTooltip);
			}, 1600);
		} catch (error) {
			console.error('Could not copy email', error);
		}
	};

	if (copyBtn && emailTooltip) {
		copyBtn.addEventListener('mouseenter', () => {
			if (isShowingFeedback) return;
			emailTooltip.textContent = 'Copy email';
			showTooltip(emailTooltip);
		});
		copyBtn.addEventListener('mouseleave', () => {
			if (!isShowingFeedback) {
				hideTooltip(emailTooltip);
				emailTooltip.textContent = '';
			}
		});
		copyBtn.addEventListener('focus', () => {
			if (isShowingFeedback) return;
			emailTooltip.textContent = 'Copy email';
			showTooltip(emailTooltip);
		});
		copyBtn.addEventListener('blur', () => {
			if (!isShowingFeedback) {
				hideTooltip(emailTooltip);
				emailTooltip.textContent = '';
			}
		});
		copyBtn.addEventListener('click', copyEmail);
	}

	// ── Mobile menu ────────────────────────────────────────────────
	const mobileToggle = document.getElementById('mobile-menu-toggle') as HTMLButtonElement | null;
	const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;
	const mobileBackdrop = document.getElementById('mobile-backdrop') as HTMLElement | null;
	const mobileCloseBtn = mobileMenu?.querySelector('[data-mobile-menu-close]') as HTMLButtonElement | null;

	const main = document.getElementById('main') as HTMLElement | null;
	const skipLink = document.querySelector('.skip-link') as HTMLElement | null;

	const mobileCopyBtn = document.getElementById('email-copy-mobile');
	const mobileEmailTooltip = document.getElementById('email-tooltip-mobile');
	const mobileEmailAddress = mobileCopyBtn?.dataset.email ?? '';
	let mobileIsShowingFeedback = false;

	let menuOpen = false;
	let scrollYBeforeLock = 0;

	let bodyStyleSnapshot: {
		position: string;
		top: string;
		left: string;
		right: string;
		width: string;
		overflow: string;
	} | null = null;

	let mainWasInert = false;
	let mainAriaHiddenBefore: string | null = null;
	let skipWasInert = false;
	let skipAriaHiddenBefore: string | null = null;

	const focusableSelector =
		'a[href],button:not([disabled]),input:not([disabled]):not([type="hidden"]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])';

	const portalMobileLayer = () => {
		if (!mobileMenu || !mobileBackdrop) return;
		if (mobileBackdrop.parentElement !== document.body) document.body.append(mobileBackdrop);
		if (mobileMenu.parentElement !== document.body) document.body.append(mobileMenu);
	};

	const getFocusable = () => {
		if (!mobileMenu) return [];
		return Array.from(mobileMenu.querySelectorAll<HTMLElement>(focusableSelector)).filter((el) => {
			if (el.hasAttribute('disabled')) return false;
			if (el.getAttribute('aria-hidden') === 'true') return false;
			if (el.tabIndex < 0) return false;
			return true;
		});
	};

	const focusFirstInMenu = () => {
		if (!mobileMenu) return;
		const focusables = getFocusable();
		(mobileCloseBtn ?? focusables[0] ?? mobileMenu).focus();
	};

	const lockScroll = () => {
		const body = document.body;
		if (bodyStyleSnapshot) return;

		scrollYBeforeLock = window.scrollY;

		bodyStyleSnapshot = {
			position: body.style.position,
			top: body.style.top,
			left: body.style.left,
			right: body.style.right,
			width: body.style.width,
			overflow: body.style.overflow
		};

		body.style.position = 'fixed';
		body.style.top = `-${scrollYBeforeLock}px`;
		body.style.left = '0';
		body.style.right = '0';
		body.style.width = '100%';
		body.style.overflow = 'hidden';
	};

	const unlockScroll = () => {
		const body = document.body;
		if (!bodyStyleSnapshot) return;

		body.style.position = bodyStyleSnapshot.position;
		body.style.top = bodyStyleSnapshot.top;
		body.style.left = bodyStyleSnapshot.left;
		body.style.right = bodyStyleSnapshot.right;
		body.style.width = bodyStyleSnapshot.width;
		body.style.overflow = bodyStyleSnapshot.overflow;

		bodyStyleSnapshot = null;
		window.scrollTo(0, scrollYBeforeLock);
	};

	const setToggleUI = (open: boolean) => {
		if (!mobileToggle) return;
		mobileToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
		mobileToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
	};

	const setMenuUI = (open: boolean) => {
		if (!mobileMenu || !mobileBackdrop) return;

		mobileMenu.classList.toggle('is-open', open);
		mobileBackdrop.classList.toggle('is-open', open);

		if (open) {
			mobileMenu.removeAttribute('inert');
			mobileMenu.setAttribute('aria-hidden', 'false');
		} else {
			mobileMenu.setAttribute('inert', '');
			mobileMenu.setAttribute('aria-hidden', 'true');
		}
	};

	const setBackgroundInert = (open: boolean) => {
		if (open) {
			if (main) {
				mainWasInert = main.hasAttribute('inert');
				mainAriaHiddenBefore = main.getAttribute('aria-hidden');
				main.setAttribute('inert', '');
				main.setAttribute('aria-hidden', 'true');
			}
			if (skipLink) {
				skipWasInert = skipLink.hasAttribute('inert');
				skipAriaHiddenBefore = skipLink.getAttribute('aria-hidden');
				skipLink.setAttribute('inert', '');
				skipLink.setAttribute('aria-hidden', 'true');
			}
		} else {
			if (main) {
				if (!mainWasInert) main.removeAttribute('inert');
				if (mainAriaHiddenBefore === null) main.removeAttribute('aria-hidden');
				else main.setAttribute('aria-hidden', mainAriaHiddenBefore);
			}
			if (skipLink) {
				if (!skipWasInert) skipLink.removeAttribute('inert');
				if (skipAriaHiddenBefore === null) skipLink.removeAttribute('aria-hidden');
				else skipLink.setAttribute('aria-hidden', skipAriaHiddenBefore);
			}
		}
	};

	const onDocKeydown = (e: KeyboardEvent) => {
		if (!menuOpen) return;

		if (e.key === 'Escape') {
			e.preventDefault();
			setMenuOpen(false);
			return;
		}

		if (e.key !== 'Tab') return;

		const focusables = getFocusable();
		if (!focusables.length || !mobileMenu) {
			e.preventDefault();
			mobileMenu?.focus();
			return;
		}

		const first = focusables[0];
		const last = focusables[focusables.length - 1];
		const active = document.activeElement as HTMLElement | null;

		if (e.shiftKey) {
			if (active === first || active === mobileMenu) {
				e.preventDefault();
				last.focus();
			}
		} else {
			if (active === last) {
				e.preventDefault();
				first.focus();
			}
		}
	};

	const onDocFocusIn = (e: FocusEvent) => {
		if (!menuOpen || !mobileMenu) return;
		const target = e.target as Node | null;
		if (target && mobileMenu.contains(target)) return;
		focusFirstInMenu();
	};

	const setMenuOpen = (open: boolean) => {
		if (!mobileToggle || !mobileMenu || !mobileBackdrop) return;
		if (open === menuOpen) return;

		menuOpen = open;

		setToggleUI(open);
		setMenuUI(open);
		setBackgroundInert(open);

		if (open) {
			portalMobileLayer();
			lockScroll();

			document.addEventListener('keydown', onDocKeydown, true);
			document.addEventListener('focusin', onDocFocusIn, true);

			requestAnimationFrame(() => focusFirstInMenu());
		} else {
			document.removeEventListener('keydown', onDocKeydown, true);
			document.removeEventListener('focusin', onDocFocusIn, true);

			unlockScroll();
			requestAnimationFrame(() => mobileToggle.focus());
		}
	};

	if (mobileToggle && mobileMenu && mobileBackdrop) {
		portalMobileLayer();
		setToggleUI(false);
		setMenuUI(false);

		mobileToggle.addEventListener('click', () => setMenuOpen(!menuOpen));
		mobileBackdrop.addEventListener('click', () => setMenuOpen(false));
		mobileCloseBtn?.addEventListener('click', () => setMenuOpen(false));

		mobileMenu.addEventListener('click', (e) => {
			const target = e.target as HTMLElement | null;
			const navLink = target?.closest('.mobile-menu__nav a');
			if (navLink) setMenuOpen(false);
		});

		const mq = window.matchMedia('(max-width: 720px)');
		const onMQ = () => {
			if (!mq.matches) setMenuOpen(false);
		};
		mq.addEventListener('change', onMQ);
	}

	// Mobile email copy
	const copyMobileEmail = async () => {
		try {
			await navigator.clipboard.writeText(mobileEmailAddress);
			if (!mobileEmailTooltip) return;
			mobileEmailTooltip.textContent = 'Email copied!';
			mobileEmailTooltip.setAttribute('role', 'status');
			mobileEmailTooltip.setAttribute('aria-live', 'polite');
			mobileEmailTooltip.classList.add('show');
			mobileEmailTooltip.setAttribute('aria-hidden', 'false');
			mobileIsShowingFeedback = true;
			setTimeout(() => {
				if (!mobileEmailTooltip) return;
				mobileEmailTooltip.textContent = '';
				mobileEmailTooltip.setAttribute('role', 'tooltip');
				mobileEmailTooltip.removeAttribute('aria-live');
				mobileEmailTooltip.classList.remove('show');
				mobileEmailTooltip.setAttribute('aria-hidden', 'true');
				mobileIsShowingFeedback = false;
			}, 1600);
		} catch (err) {
			console.error('Could not copy email', err);
		}
	};

	if (mobileCopyBtn) {
		mobileCopyBtn.addEventListener('click', copyMobileEmail);
	}
</script>
