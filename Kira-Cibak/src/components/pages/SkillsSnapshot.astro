---
import Button from '../ui/Button.astro';
---

	<div class="snapshot-cta">
		<Button variant="primary" href="/contact">
			Get In Touch
		</Button>
	</div>
</div>

<style>
	.numbers-block {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding-top: 2rem;
	}

	.numbers-subhead {
		font-size: var(--type-size-small);
		font-weight: 600;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin: 0;
	}

	/* Fixed column widths so the 2×2 grid resolves inside an auto-width parent */
	.orb-grid {
		display: grid;
		grid-template-columns: repeat(2, clamp(108px, 9vw, 136px));
		gap: 1rem;
	}

	.snapshot-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		padding-top: 0.5rem;
	}

	.stat-orb {
		width: clamp(108px, 9vw, 136px);
		aspect-ratio: 1 / 1;
		border-radius: 50%;
		flex-shrink: 0;
		border: 1px solid color-mix(in srgb, var(--color-accent) 24%, var(--color-border));
		background: radial-gradient(
			circle at 34% 20%,
			color-mix(in srgb, var(--color-accent-2) 34%, var(--color-card)) 0%,
			color-mix(in srgb, var(--color-accent) 26%, var(--color-card)) 50%,
			color-mix(in srgb, var(--color-accent-warm) 18%, var(--color-card)) 100%
		);
		box-shadow: 0 2px 10px -7px color-mix(in srgb, var(--color-accent) 28%, transparent);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 0.5rem;
		gap: 0.2rem;
	}

	:global(html.dark) .stat-orb {
		background: radial-gradient(
			circle at 34% 20%,
			color-mix(in srgb, var(--color-accent-2) 28%, var(--color-card)) 0%,
			color-mix(in srgb, var(--color-accent) 22%, var(--color-card)) 52%,
			color-mix(in srgb, var(--color-accent-warm) 14%, var(--color-card)) 100%
		);
	}

	.orb-value {
		margin: 0;
		font-size: clamp(1.3rem, 2.2vw, 1.6rem);
		font-weight: 700;
		line-height: 1.1;
		color: var(--color-ink);
	}

	.orb-value sup {
		font-size: 0.52em;
		vertical-align: super;
	}

	.orb-label {
		margin: 0;
		font-size: 0.7rem;
		color: var(--color-muted);
		line-height: 1.3;
		max-width: 10ch;
		text-wrap: pretty;
	}

	@media (max-width: 600px) {
		.orb-grid {
			grid-template-columns: repeat(2, 40vw);
		}

		.stat-orb {
			width: 40vw;
		}
	}
</style>
