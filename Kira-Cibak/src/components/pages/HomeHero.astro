---
import Button from '../ui/Button.astro';
import { Image } from 'astro:assets';
---

<div class="hero-layout">
	<div class="hero-text">
		<div class="section-heading">
			<h1 class="section-title">Hi, I'm <span class="gradient-text">Kira</span></h1>
			<p class="section-subtitle">
				I build things.
			</p>
			<div class="stat-strip">
				<span class="stat-strip-item"><span class="stat-strip-value">5+</span> Client Platforms</span>
				<span class="stat-strip-sep" aria-hidden="true">·</span>
				<span class="stat-strip-item"><span class="stat-strip-value">Azure</span> Certified</span>
				<span class="stat-strip-sep" aria-hidden="true">·</span>
				<span class="stat-strip-item">Revenue Stream Implementation</span>
			</div>
		</div>
	</div>
	<div class="hero-photo-wrap">
		<Image
			src="/pfp.jpeg"
			alt="Kira Cibak"
			class="hero-photo"
			width={400}
			height={400}
			loading="eager"
		/>
	</div>
</div>

<style>
	.hero-layout {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: start;
		gap: 2.5rem;
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 0;
	}

	.hero-text .section-heading {
		margin-bottom: 0;
		row-gap: 0.35rem;
	}

	.hero-text .section-subtitle {
		font-size: 1.5rem;
		line-height: 1.3;
	}

	.hero-photo-wrap {
		position: relative;
		width: clamp(182px, 15.6vw, 247px);
		height: clamp(182px, 15.6vw, 247px);
		margin-top: clamp(0.18rem, 0.45vw, 0.36rem);
		border-radius: 50%;
		overflow: hidden;
		flex-shrink: 0;
		box-shadow:
			0 4px 24px -4px rgb(14 180 200 / 15%),
			0 0 0 3px var(--color-card),
			0 0 0 4px color-mix(in srgb, var(--color-accent) 25%, transparent);
	}

	.hero-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	@media (max-width: 768px) {
		.hero-layout {
			grid-template-columns: 1fr;
			justify-items: start;
			gap: 1.5rem;
		}

		.hero-photo-wrap {
			width: 156px;
			height: 156px;
			order: -1;
		}
	}
</style>
