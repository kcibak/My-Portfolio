---
import Button from '../ui/Button.astro';
---

<div class="section-heading">
	<h1 class="section-title">Full-stack engineer for <span class="gradient-text">React + TypeScript</span> SaaS products.</h1>
	<p class="section-subtitle">
		I build full-stack SaaS products from architecture through launch — with Azure, React, and TypeScript.
	</p>
	<div class="stat-strip">
		<span class="stat-strip-item"><span class="stat-strip-value">5+</span> Client Platforms</span>
		<span class="stat-strip-sep" aria-hidden="true">·</span>
		<span class="stat-strip-item">SaaS Replatforming</span>
		<span class="stat-strip-sep" aria-hidden="true">·</span>
		<span class="stat-strip-item"><span class="stat-strip-value">Azure</span> Certified</span>
		<span class="stat-strip-sep" aria-hidden="true">·</span>
		<span class="stat-strip-item">Stripe Payments</span>
	</div>
</div>
<div class="action-row">
	<Button variant="accent" href="/projects">View projects</Button>
	<Button variant="secondary" href="/contact">Contact</Button>
</div>
