---
import Button from '../ui/Button.astro';
import { Image } from 'astro:assets';
---

<section class="hero-shell" data-reveal>
	<div class="hero-copy">
		<h1 class="hero-title">
			<span class="hero-title-line hero-title-line--intro">
				I'm <span class="hero-accent gradient-text">Kira</span>.
			</span>
			<span class="hero-title-line hero-title-line--promise">
				I take ideas & make them <span class="hero-accent gradient-text">real</span>.
			</span>
		</h1>
		<p class="hero-summary">
			A C.S. grad focused on building practical solutions and staying sharp on what's current.
		</p>
		<div class="hero-actions">
			<Button variant="secondary" href="/about">Who I am</Button>
			<Button variant="accent" href="/contact">Get in touch</Button>
		</div>
	</div>

	<div class="hero-visual">
		<div class="hero-photo-frame">
			<div class="hero-photo-wrap">
				<Image
					src="/pfp.jpeg"
					alt="Kira Cibak"
					class="hero-photo"
					width={520}
					height={520}
					loading="eager"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-shell {
		display: grid;
		grid-template-columns: minmax(0, 1.62fr) minmax(320px, 0.92fr);
		align-items: center;
		gap: clamp(0.85rem, 1.35vw, 1.6rem);
		padding: clamp(0.22rem, 0.7vw, 0.55rem) 0 clamp(0.05rem, 0.22vw, 0.18rem);
	}

	.hero-copy {
		display: grid;
		gap: 0.58rem;
		max-width: 100%;
	}

	.hero-title {
		margin: 0;
		font-family: var(--font-family-sans);
		font-size: clamp(2.53rem, 4.21vw, 3.93rem);
		font-weight: 500;
		line-height: 0.94;
		letter-spacing: -0.052em;
		max-width: 100%;
	}

	.hero-title-line {
		display: block;
		white-space: nowrap;
	}

	.hero-accent {
		filter: saturate(0.9) brightness(1.02);
	}

	.hero-summary {
		margin: 0;
		max-width: none;
		font-size: clamp(0.98rem, 1.18vw, 1.16rem);
		line-height: 1.38;
		color: var(--color-muted);
		font-family: var(--font-family-sans);
		white-space: nowrap;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.68rem;
		padding-top: 0.08rem;
	}

	.hero-actions :global(.button) {
		min-width: 8.9rem;
		font-family: var(--font-family-sans);
	}

	.hero-visual {
		display: flex;
		justify-content: flex-end;
	}

	.hero-photo-frame {
		width: min(100%, 23.3rem);
		padding: 0.42rem;
		border-radius: calc(var(--radius) * 1.65);
		background: linear-gradient(
			160deg,
			color-mix(in srgb, var(--color-card) 94%, white) 0%,
			color-mix(in srgb, var(--color-accent) 3%, var(--color-card)) 100%
		);
		border: 1px solid color-mix(in srgb, var(--color-accent) 10%, var(--color-border));
		box-shadow: 0 16px 42px -36px color-mix(in srgb, var(--color-ink) 28%, transparent);
	}

	.hero-photo-wrap {
		aspect-ratio: 1 / 1.12;
		border-radius: calc(var(--radius) * 1.35);
		overflow: hidden;
		background: color-mix(in srgb, var(--color-accent-2) 8%, var(--color-card));
	}

	.hero-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 18%;
		border-radius: 0;
	}

	@media (max-width: 960px) {
		.hero-shell {
			grid-template-columns: 1fr;
			gap: 1rem;
			padding-bottom: 0.2rem;
		}

		.hero-copy {
			max-width: none;
		}

		.hero-title {
			font-size: clamp(2.35rem, 10vw, 3.8rem);
			max-width: 9.8ch;
			text-wrap: balance;
		}

		.hero-title-line {
			display: inline;
			white-space: normal;
		}

		.hero-summary {
			max-width: 34ch;
			white-space: normal;
		}

		.hero-visual {
			justify-content: flex-start;
		}
	}

	@media (max-width: 640px) {
		.hero-shell {
			gap: 0.85rem;
			padding-top: 0.55rem;
		}

		.hero-copy {
			gap: 0.62rem;
		}

		.hero-actions {
			width: 100%;
		}

		.hero-actions :global(.button) {
			flex: 1 1 12rem;
		}

		.hero-photo-frame {
			width: min(100%, 16rem);
			padding: 0.5rem;
		}
	}
</style>
