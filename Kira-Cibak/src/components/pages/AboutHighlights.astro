---
import Card from '../ui/Card.astro';

const principles = [
  { title: 'Goals Before Code', desc: 'Define what success looks like before writing a line — clarity up front prevents rework later.' },
  { title: 'Accessibility by Default', desc: 'Semantic HTML, keyboard nav, and ARIA from the start — not bolted on before launch.' },
  { title: 'Lean Architecture', desc: 'Pick the simplest stack that solves the problem. Complexity should be earned, not inherited.' },
  { title: 'Ship Then Iterate', desc: 'Get working software in front of users fast, then refine with real feedback over assumptions.' },
  { title: 'Performance as UX', desc: 'Every unnecessary kilobyte is a choice against the user. Bundle size, LCP, CLS — they all matter.' },
  { title: 'Observable Systems', desc: 'If you can\'t see it breaking, you can\'t fix it. Logging, monitoring, and error boundaries everywhere.' },
];
---

<div class="principles-grid">
  {principles.map((p, i) => (
    <Card as="article" padding="dense" class={`stack-card ${i % 3 === 0 ? 'card-accent-top' : i % 3 === 1 ? 'card-accent-top-teal' : 'card-accent-top-warm'}`}>
      <h3 class="heading-reset" style="margin-bottom: 0.2rem;">{p.title}</h3>
      <p class="muted-copy" style="margin: 0; font-size: var(--type-size-small);">{p.desc}</p>
    </Card>
  ))}
