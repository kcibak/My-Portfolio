---
import Card from '../ui/Card.astro';

const principles = [
  { title: 'Establish the Gameplan', desc: 'I define the outcome, timeline, and MVP upfront, then map the system with impactful technical artifacts and project status dashboards/trackers so stakeholders stay aligned.' },
  { title: 'Collaborate & Adjust', desc: 'Engineering is never done in isolation. I stay in sync with teammates and clients as requirements evolve, using clear communication and fast feedback loops to keep projects moving smoothly.'},
  { title: 'Launch & Maintain', desc: 'I create systems that are reliable, tested, and maintainable — then continue adjusting them based on feedback and shifting goals. Client priorities are always mine, and I consistenty exceed expectations.' },
];
---

<div class="principles-grid">
  {principles.map((p, i) => (
    <Card as="article" padding="dense" class={`stack-card ${i % 3 === 0 ? 'card-accent-top' : i % 3 === 1 ? 'card-accent-top-teal' : 'card-accent-top-warm'}`}>
      <h3 class="heading-reset" style="margin-bottom: 0.2rem;">{p.title}</h3>
      <p class="muted-copy" style="margin: 0; font-size: var(--type-size-small);">{p.desc}</p>
    </Card>
  ))}
