---
import Button from '../ui/Button.astro';
---

<div class="not-found-shell">
	<p class="not-found-code">404</p>
	<h1 class="not-found-title">Lost in the layout.</h1>
	<p class="not-found-copy">The page you are looking for doesn’t exist. Head back to the homepage or explore the projects.</p>
	<div class="action-row action-row-center">
		<Button href="/">Go home</Button>
		<Button variant="secondary" href="/projects">See projects</Button>
	</div>
</div>
