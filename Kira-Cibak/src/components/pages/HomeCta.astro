---
import Button from '../ui/Button.astro';
---

<div class="cta-panel">
	<h2 class="cta-title"><span class="gradient-text">I'll help get your ideas on the screen.</span></h2>
	<p class="cta-subtitle">Whether new product ideation or amping up what already works — let's talk.</p>
	<div class="action-row">
		<Button variant="accent" href="/contact">Get in touch</Button>
		<Button variant="secondary" href="/skills">View skills</Button>
	</div>
</div>

<style>
	.cta-panel {
		width: min(100%, 43.5rem);
		height: auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: 0.62rem;
		padding: 0.95rem 1.5rem;
		border-radius: calc(var(--radius) * 1.3);
		background:
			linear-gradient(
				145deg,
				var(--color-card) 0%,
				color-mix(in srgb, var(--color-accent) 4.5%, var(--color-card)) 100%
			);
		border: 1px solid color-mix(in srgb, var(--color-border) 76%, transparent);
		box-shadow:
			0 1px 8px -5px color-mix(in srgb, var(--color-accent) 16%, transparent);
		box-sizing: border-box;
	}

	.cta-title {
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.02em;
		margin: 0;
	}

	.cta-subtitle {
		font-size: var(--type-size-body);
		color: var(--color-muted);
		line-height: 1.5;
		margin: 0;
		max-width: 48ch;
	}

	@media (max-width: 1024px) {
		.cta-panel {
			width: 100%;
			height: auto;
			min-height: 0;
			max-width: none;
			padding: 1.05rem 1.35rem;
		}
	}
</style>
