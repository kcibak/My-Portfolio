---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<Card class="home-cta-card" padding="comfortable">
	<h2 class="section-title section-title-compact"><span class="gradient-text">Let's build something great</span></h2>
	<p class="section-subtitle section-subtitle-compact">I'd love to hear about your project.</p>
	<div class="action-row">
		<Button variant="accent" href="/contact">Get in touch</Button>
		<Button variant="secondary" href="/skills">View skills</Button>
	</div>
</Card>
