---
const testimonials = [
	'She is quick witted and is able to handle stressful and complex scenarios while maintaining professionalism.',
	'What impressed me most was her eagerness to learn, willingness to take on new challenges, and ability to contribute at a high level.',
	'Her independence is invaluable in a busy work environment.',
	'Beyond technical capability, what stands out most is her maturity, organization, and ability to operate independently.'
];

const recommendationsUrl =
	'https://www.linkedin.com/in/kiracibakcodes/details/recommendations/?detailScreenTabIndex=0';
---

<section class="testimonials" aria-labelledby="testimonials-title" data-testimonials>
	<div class="testimonials-heading">
		<p class="testimonials-eyebrow">Receipts</p>
		<h2 id="testimonials-title">Don't just take my word for it.</h2>
	</div>

	<div class="testimonials-slider" aria-live="polite">
		{testimonials.map((quote, index) => (
			<blockquote class:list={['testimonial-slide', index === 0 && 'is-active']} data-testimonial-slide={index}>
				<p>“{quote}”</p>
			</blockquote>
		))}
	</div>

	<div class="testimonials-controls">
		<div class="testimonial-dots" aria-label="Testimonial slides">
			{testimonials.map((_, index) => (
				<button
					type="button"
					class:list={['testimonial-dot', index === 0 && 'is-active']}
					aria-label={`Show testimonial ${index + 1}`}
					aria-current={index === 0 ? 'true' : undefined}
					data-testimonial-dot={index}
				></button>
			))}
		</div>
		<a
			class="testimonials-all-link"
			href={recommendationsUrl}
			target="_blank"
			rel="noreferrer"
		>
			View all recommendations <span aria-hidden="true">↗</span>
		</a>
	</div>
</section>

<script>
	const testimonialRoot = document.querySelector<HTMLElement>('[data-testimonials]');
	const testimonialSlides = Array.from(
		document.querySelectorAll<HTMLElement>('[data-testimonial-slide]')
	);
	const testimonialDots = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-testimonial-dot]')
	);
	const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
	let testimonialIndex = 0;
	let testimonialTimer: number | undefined;

	const showTestimonial = (index: number) => {
		testimonialIndex = (index + testimonialSlides.length) % testimonialSlides.length;
		testimonialSlides.forEach((slide, slideIndex) => {
			slide.classList.toggle('is-active', slideIndex === testimonialIndex);
		});
		testimonialDots.forEach((dot, dotIndex) => {
			const isActive = dotIndex === testimonialIndex;
			dot.classList.toggle('is-active', isActive);
			if (isActive) dot.setAttribute('aria-current', 'true');
			else dot.removeAttribute('aria-current');
		});
	};

	const stopTestimonialTimer = () => {
		if (testimonialTimer) window.clearInterval(testimonialTimer);
		testimonialTimer = undefined;
	};

	const startTestimonialTimer = () => {
		stopTestimonialTimer();
		if (reduceMotionQuery.matches || testimonialSlides.length < 2) return;
		testimonialTimer = window.setInterval(() => showTestimonial(testimonialIndex + 1), 6500);
	};

	if (testimonialRoot && testimonialSlides.length && testimonialDots.length) {
		testimonialDots.forEach((dot, index) => {
			dot.addEventListener('click', () => {
				showTestimonial(index);
				startTestimonialTimer();
			});
		});
		testimonialRoot.addEventListener('mouseenter', stopTestimonialTimer);
		testimonialRoot.addEventListener('mouseleave', startTestimonialTimer);
		testimonialRoot.addEventListener('focusin', stopTestimonialTimer);
		testimonialRoot.addEventListener('focusout', (event) => {
			if (!testimonialRoot.contains(event.relatedTarget as Node | null)) startTestimonialTimer();
		});
		reduceMotionQuery.addEventListener('change', startTestimonialTimer);
		startTestimonialTimer();
	}
</script>

<style>
	.testimonials {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		column-gap: clamp(1rem, 3vw, 3.4rem);
		row-gap: 0.2rem;
		padding: 20px clamp(0.1rem, 1.4vw, 1.25rem);
	}

	.testimonials-heading {
		min-width: 8.5rem;
	}

	.testimonials-eyebrow {
		margin: 0 0 0.1rem;
		color: var(--color-accent);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.13em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.testimonials h2 {
		margin: 0;
		font-size: clamp(1.15rem, 1.7vw, 1.45rem);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.025em;
	}

	.testimonials-slider {
		position: relative;
		min-width: 0;
		min-height: 4.4rem;
	}

	.testimonial-slide {
		display: none;
		margin: 0;
		padding-left: 1.05rem;
		border-left: 1px solid color-mix(in srgb, var(--color-accent) 58%, var(--color-border));
	}

	.testimonial-slide.is-active {
		display: block;
		animation: testimonial-in 360ms ease both;
	}

	.testimonial-slide p {
		margin: 0;
		max-width: 66ch;
		color: var(--color-muted);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(0.98rem, 1.24vw, 1.12rem);
		font-style: italic;
		line-height: 1.42;
	}

	.testimonial-link,
	.testimonials-all-link {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
		margin-top: 0.45rem;
		color: var(--color-accent);
		font-size: 0.76rem;
		font-weight: 600;
		line-height: 1.2;
	}

	.testimonial-link:hover,
	.testimonials-all-link:hover {
		color: var(--color-ink);
	}

	.testimonials-controls {
		grid-column: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-left: 1.05rem;
	}

	.testimonial-dots {
		display: flex;
		align-items: center;
		gap: 0.42rem;
	}

	.testimonial-dot {
		width: 0.42rem;
		height: 0.42rem;
		padding: 0;
		border: 1px solid color-mix(in srgb, var(--color-accent) 52%, var(--color-border));
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-accent) 22%, var(--color-card));
		cursor: pointer;
		transition: transform 160ms ease, background-color 160ms ease;
	}

	.testimonial-dot:hover,
	.testimonial-dot:focus-visible,
	.testimonial-dot.is-active {
		background: var(--color-accent);
		transform: scale(1.3);
	}

	.testimonial-dot:focus-visible {
		outline: 2px solid var(--color-focus-ring);
		outline-offset: 0.2rem;
	}

	.testimonials-all-link {
		margin-top: 0;
		white-space: nowrap;
	}

	@keyframes testimonial-in {
		from {
			opacity: 0;
			transform: translateY(0.28rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 640px) {
		.testimonials {
			grid-template-columns: 1fr;
			gap: 0.72rem;
			padding: 15px 0;
		}

		.testimonials-heading {
			min-width: 0;
		}

		.testimonials-slider {
			min-height: 6.4rem;
		}

		.testimonial-slide {
			padding-left: 0.85rem;
		}

		.testimonial-slide p {
			font-size: 1rem;
			line-height: 1.45;
		}

		.testimonials-controls {
			grid-column: 1;
			padding-left: 0.85rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.testimonial-slide.is-active {
			animation: none;
		}
	}
</style>
