---
type ContactLink = {
	href: string;
	label: string;
	icon: 'linkedin' | 'github';
};

type Props = {
	socials: ContactLink[];
	emailAddress: string;
	resumeHref: string;
};

const {
	socials,
	emailAddress,
	resumeHref
} = Astro.props as Props;
---

<div class="contact-shell">
	<div class="contact-hero">
		<h1 class="section-title"><span class="gradient-text">Get In Touch</span></h1>
	</div>

	<div class="contact-actions">
		{socials.map((link) => (
			<a class="contact-action" href={link.href} target="_blank" rel="noreferrer" aria-label={link.label}>
				<span class="icon-wrap">
					{link.icon === 'linkedin' ? (
						<svg aria-hidden="true" width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
							<path d="M6.94 9.75V18" />
							<circle cx="6.94" cy="6.94" r="1.6" />
							<path d="M12 18v-5.21c0-1.53 1.24-2.77 2.77-2.77s2.77 1.24 2.77 2.77V18" />
						</svg>
					) : (
						<svg aria-hidden="true" width="42" height="42" viewBox="-1 -1 26 26" fill="none" stroke="currentColor" stroke-width="1.8">
							<path d="M9 19c-4 1-4-2-6-2m12 4v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7a5.44 5.44 0 0 0-1.5-3.75 5.07 5.07 0 0 0-.09-3.77S18.16-1 15 1.38a13.38 13.38 0 0 0-6 0C5-1 3.09 1 3.09 1a5.07 5.07 0 0 0-.09 3.77A5.44 5.44 0 0 0 1.5 8.5c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 7 18.13V22" />
						</svg>
					)}
				</span>
				<span class="action-label">{link.label}</span>
			</a>
		))}

		<a class="contact-action" href={resumeHref} target="_blank" rel="noopener noreferrer" aria-label="View Resume">
			<span class="icon-wrap">
				<svg aria-hidden="true" width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
					<path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z" />
					<path d="M14 2v5h5" />
					<path d="M9 13h6" />
					<path d="M9 17h6" />
				</svg>
			</span>
			<span class="action-label">View Resume</span>
		</a>

		<button class="contact-action" type="button" data-copy-email={emailAddress} aria-label={`Copy ${emailAddress}`}>
			<span class="icon-wrap">
				<svg aria-hidden="true" width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
					<path d="m3 8 7.89 4.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z" />
				</svg>
			</span>
			<span class="action-label">Copy Email</span>
		</button>
	</div>
</div>

<script>
	(() => {
		const copyButton = document.querySelector('[data-copy-email]');

		if (!copyButton) return;

		copyButton.addEventListener('click', async () => {
			const email = copyButton.getAttribute('data-copy-email');
			if (!email) return;

			try {
				await navigator.clipboard.writeText(email);
				copyButton.setAttribute('data-copied', 'true');
				window.setTimeout(() => copyButton.setAttribute('data-copied', 'false'), 1200);
			} catch (error) {
				console.error('Could not copy email', error);
			}
		});
	})();
</script>
