---
import Card from '../ui/Card.astro';
---

<Card padding="compact">
	<h2 class="section-title section-title-small section-title-bottom">Values</h2>
	<div class="grid-three">
		<Card padding="dense" class="card-accent-top">
			<h3 class="heading-reset" style="margin-bottom: 0.3rem;">User Respect</h3>
			<p class="muted-copy" style="margin: 0;">Fast, accessible experiences that respect every user's time, device, and ability.</p>
		</Card>
		<Card padding="dense" class="card-accent-top-teal">
			<h3 class="heading-reset" style="margin-bottom: 0.3rem;">Clear Communication</h3>
			<p class="muted-copy" style="margin: 0;">Frequent checkpoints, honest updates, and shared context so nothing gets lost in translation.</p>
		</Card>
		<Card padding="dense" class="card-accent-top-warm">
			<h3 class="heading-reset" style="margin-bottom: 0.3rem;">Ship & Iterate</h3>
			<p class="muted-copy" style="margin: 0;">Ship reliably first, then refine with real data and user feedback rather than assumptions.</p>
		</Card>
	</div>
</Card>
