			<li>GitHub Copilot</li>
			<li>Jira / ClickUp</li>
		</ul>
	</div>
</div>

<style>
	.skills-groups {
		display: grid;
		gap: 1.1rem;
	}

	@media (min-width: 768px) {
		.skills-groups {
			grid-template-columns: 1fr 1fr;
		}
	}

	.skills-cat {
		font-size: var(--type-size-small);
		font-weight: 600;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin: 0 0 0.25rem;
	}

	.skills-list {
		margin: 0;
		padding-left: 1.1rem;
		color: var(--color-muted);
		font-size: var(--type-size-small);
		line-height: 1.6;
		columns: 2;
		column-gap: 0.5rem;
	}

	.skills-list li {
		padding: 0.05rem 0;
		break-inside: avoid;
	}

	.proto-note {
		font-style: italic;
		opacity: 0.75;
	}
</style>