---
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
---

<div class="grid-three">
	<Card as="article" padding="compact" class="card-accent-top">
		<h2 class="section-title section-title-small section-title-bottom">Front-end</h2>
		<div class="tag-row">
			<Tag>React</Tag>
			<Tag>TypeScript</Tag>
			<Tag>Next.js</Tag>
			<Tag>Astro</Tag>
			<Tag>JavaScript</Tag>
			<Tag>HTML5</Tag>
			<Tag>CSS3</Tag>
			<Tag>Responsive Design</Tag>
			<Tag>Accessibility (WCAG)</Tag>
			<Tag>Component Architecture</Tag>
			<Tag>Design Systems</Tag>
			<Tag>WordPress Integration</Tag>
		</div>
	</Card>

	<Card as="article" padding="compact" class="card-accent-top-teal">
		<h2 class="section-title section-title-small section-title-bottom">Back-end & Systems</h2>
		<div class="tag-row">
			<Tag>Node.js</Tag>
			<Tag>NestJS</Tag>
			<Tag>Express</Tag>
			<Tag>GraphQL</Tag>
			<Tag>REST APIs</Tag>
			<Tag>PostgreSQL</Tag>
			<Tag>Redis</Tag>
			<Tag>Sequelize</Tag>
			<Tag>Authentication & RBAC</Tag>
			<Tag>Keycloak</Tag>
			<Tag>API Validation</Tag>
			<Tag>System Replatforming</Tag>
		</div>
	</Card>

	<Card as="article" padding="compact" class="card-accent-top-warm">
		<h2 class="section-title section-title-small section-title-bottom">Cloud & Delivery</h2>
		<div class="tag-row">
			<Tag>Azure</Tag>
			<Tag>Docker</Tag>
			<Tag>CI/CD Pipelines</Tag>
			<Tag>Git / GitHub</Tag>
			<Tag>Netlify</Tag>
			<Tag>Stripe Integration</Tag>
			<Tag>Deployment Automation</Tag>
			<Tag>Performance Optimization</Tag>
			<Tag>SEO Fundamentals</Tag>
			<Tag>Postman</Tag>
			<Tag>GitHub Copilot</Tag>
			<Tag>Cursor</Tag>
		</div>
	</Card>
</div>