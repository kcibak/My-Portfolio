---
const icon = '/placeholder.svg';
---

<div class="skills-groups">

	<div class="skills-group">
		<h3 class="skills-cat">Languages</h3>
		<div class="skills-icon-grid">
			<div class="skill-item"><img src="/typescript-original.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>TypeScript</span></div>
			<div class="skill-item"><img src="/python-original.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Python</span></div>
			<div class="skill-item"><img src={icon} width="24" height="24" alt="" aria-hidden="true" class="skill-icon skill-icon--placeholder" /><span>C</span></div>
			<div class="skill-item"><img src={icon} width="24" height="24" alt="" aria-hidden="true" class="skill-icon skill-icon--placeholder" /><span>C#</span></div>
			<div class="skill-item"><img src="/java.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Java</span></div>
			<div class="skill-item"><img src="/PHP-logo.svg.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>PHP</span></div>
			<div class="skill-item"><img src="/css3-plain.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>CSS</span></div>
		</div>
	</div>

	<div class="skills-group">
		<h3 class="skills-cat">Frameworks & App Development</h3>
		<div class="skills-icon-grid">
			<div class="skill-item"><img src="/react.png" width="32" height="32" alt="" aria-hidden="true" class="skill-icon" /><span>React</span></div>
			<div class="skill-item"><img src="/astro.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Astro</span></div>
			<div class="skill-item"><img src="/nextjs-original.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Next.js</span></div>
			<div class="skill-item"><img src="/nodejs-original-wordmark.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Node.js</span></div>
			<div class="skill-item"><img src="/nestjs.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>NestJS</span></div>
			<div class="skill-item"><img src="/redux-original.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Redux</span></div>
			<div class="skill-item"><img src="/tailwindcss-icon.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Tailwind CSS</span></div>
			<div class="skill-item"><img src="/sequelize.webp" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Sequelize</span></div>
			<div class="skill-item"><img src={icon} width="24" height="24" alt="" aria-hidden="true" class="skill-icon skill-icon--placeholder" /><span>.NET (WinForms)</span></div>
			<div class="skill-item"><img src="/vite.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Vite</span></div>
		</div>
	</div>

	<div class="skills-group">
		<h3 class="skills-cat">APIs & Integrations</h3>
		<div class="skills-icon-grid">
			<div class="skill-item"><img src={icon} width="24" height="24" alt="" aria-hidden="true" class="skill-icon skill-icon--placeholder" /><span>REST APIs</span></div>
			<div class="skill-item"><img src="/graphql.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>GraphQL</span></div>
			<div class="skill-item"><img src="/Keycloak_Logo.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Keycloak</span></div>
			<div class="skill-item"><img src="/openai.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>OpenAI APIs</span></div>
			<div class="skill-item"><img src="/huggingface.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Hugging Face APIs</span></div>
		</div>
	</div>

	<div class="skills-group">
		<h3 class="skills-cat">Databases & Caching</h3>
		<div class="skills-icon-grid">
			<div class="skill-item"><img src="/postgresql.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>PostgreSQL</span></div>
			<div class="skill-item"><img src="/redis.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Redis</span></div>
			<div class="skill-item"><img src="/msaccess.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>MS Access</span></div>
		</div>
	</div>

	<div class="skills-group">
		<h3 class="skills-cat">Cloud & Infrastructure</h3>
		<div class="skills-icon-grid">
			<div class="skill-item"><img src="/azure-original.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Azure</span></div>
			<div class="skill-item"><img src="/docker-original.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Docker</span></div>
			<div class="skill-item"><img src="/netlify-logo-svg-vector.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon skill-icon--netlify" /><span>Netlify</span></div>
			<div class="skill-item"><img src="/godaddy.png" width="54" height="28" alt="" aria-hidden="true" class="skill-icon skill-icon--godaddy" /><span>GoDaddy</span></div>
		</div>
	</div>

	<div class="skills-group">
		<h3 class="skills-cat">Developer Tools</h3>
		<div class="skills-icon-grid">
			<div class="skill-item"><img src="/git-plain.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Git</span></div>
			<div class="skill-item"><img src="/github.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>GitHub</span></div>
			<div class="skill-item"><img src="/visual-studio-code.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>VS Code</span></div>
			<div class="skill-item"><img src="/visualstudio.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Visual Studio</span></div>
			<div class="skill-item"><img src="/getpostman-icon.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Postman</span></div>
			<div class="skill-item"><img src="/dbeaver.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>DBeaver</span></div>
			<div class="skill-item"><img src="/drawio.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Draw.io</span></div>
			<div class="skill-item"><img src="/jira.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Jira</span></div>
			<div class="skill-item"><img src="/clickup.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>ClickUp</span></div>
			<div class="skill-item"><img src="/monday.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Monday.com</span></div>
			<div class="skill-item"><img src="/storybook.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Storybook</span></div>
		</div>
	</div>

	<div class="skills-group">
		<h3 class="skills-cat">AI Development Tools</h3>
		<div class="skills-icon-grid">
			<div class="skill-item"><img src="/githubcopilot.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon skill-icon--copilot" /><span>GitHub Copilot</span></div>
			<div class="skill-item"><img src="/codex-color.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Codex</span></div>
			<div class="skill-item"><img src="/cursor.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Cursor</span></div>
			<div class="skill-item"><img src="/coderabbit.svg" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>CodeRabbit</span></div>
			<div class="skill-item"><img src="/lovable.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Lovable.dev</span></div>
		</div>
	</div>

	<div class="skills-group">
		<h3 class="skills-cat">Platforms</h3>
		<div class="skills-icon-grid">
			<div class="skill-item"><img src="/wordpress.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>WordPress</span></div>
			<div class="skill-item"><img src="/weebly.png" width="24" height="24" alt="" aria-hidden="true" class="skill-icon" /><span>Weebly</span></div>
		</div>
	</div>

</div>

<style>
	.skills-groups {
		display: grid;
		gap: 1.1rem;
		overflow-x: clip;
	}

	@media (min-width: 768px) {
		.skills-groups {
			grid-template-columns: 1fr 1fr;
		}
	}

	.skills-cat {
		font-size: var(--type-size-small);
		font-weight: 600;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin: 0 0 0.35rem;
	}

	.skills-icon-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1rem;
		min-width: 0;
	}

	.skill-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--type-size-base);
		color: var(--color-muted);
		min-width: 0;
	}

	.skill-icon {
		width: 28px;
		height: 28px;
		flex-shrink: 0;
		opacity: 0.7;
		object-fit: contain;
	}

	.skill-icon--godaddy {
		width: 54px;
		height: 28px;
		opacity: 0.85;
	}

	.skill-icon--netlify,
	.skill-icon--copilot {
		width: 34px;
		height: 34px;
	}

	:global(html.dark) .skill-icon--placeholder {
		filter: brightness(0) invert(1);
	}

	@media (max-width: 767px) {
		.skills-groups {
			gap: 0.95rem;
		}

		.skills-group {
			min-width: 0;
		}

		.skills-cat {
			margin-bottom: 0.5rem;
			font-size: 0.78rem;
			letter-spacing: 0.05em;
		}

		.skills-icon-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.7rem 0.9rem;
		}

		.skill-item {
			align-items: flex-start;
			gap: 0.42rem;
			padding: 0;
			border: 0;
			border-radius: 0;
			background: transparent;
			font-size: 0.94rem;
			line-height: 1.24;
		}

		.skill-item span {
			display: block;
			min-width: 0;
			overflow-wrap: anywhere;
			text-wrap: balance;
		}

		.skill-icon {
			width: 20px;
			height: 20px;
			margin-top: 0.08rem;
			opacity: 0.82;
		}

		.skill-icon--netlify,
		.skill-icon--copilot {
			width: 22px;
			height: 22px;
		}

		.skill-icon--godaddy {
			width: 34px;
			height: 18px;
			margin-top: 0.18rem;
		}
	}
</style>
