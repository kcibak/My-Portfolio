---
import Card from '../ui/Card.astro';
---

<div class="grid-three">
	<Card as="article" padding="compact">
		<h2 class="section-title section-title-small section-title-bottom">Front-end</h2>
		<ul class="content-list">
			<li>Astro / React / Next.js</li>
			<li>TypeScript, modern JS patterns</li>
			<li>CSS tooling, motion, accessibility-first</li>
		</ul>
	</Card>
	<Card as="article" padding="compact">
		<h2 class="section-title section-title-small section-title-bottom">Systems</h2>
		<ul class="content-list">
			<li>Design tokens and theming</li>
			<li>Component libraries, Storybook</li>
			<li>Responsive grids and typography scales</li>
		</ul>
	</Card>
	<Card as="article" padding="compact">
		<h2 class="section-title section-title-small section-title-bottom">Delivery</h2>
		<ul class="content-list">
			<li>CI/CD basics, testing strategy</li>
			<li>Performance monitoring and budgets</li>
			<li>SEO fundamentals (metadata, sitemaps)</li>
		</ul>
	</Card>
</div>
