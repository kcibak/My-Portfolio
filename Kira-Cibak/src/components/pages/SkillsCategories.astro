			<li>TypeScript</li>
			<li>Python</li>
			<li>C</li>
			<li>C#</li>
			<li>Java</li>
			<li>PHP</li>
			<li>CSS</li>
			<li>SQL</li>
		</ul>
	</div>

	<div class="skills-group">
		<h3 class="skills-cat">Frameworks & APIs</h3>
		<ul class="skills-list">
			<li>React</li>
			<li>Astro</li>
			<li>Next.js</li>
