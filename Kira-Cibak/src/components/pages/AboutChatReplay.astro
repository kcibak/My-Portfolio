---
import Card from '../ui/Card.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { netlifyImageSrcSet, netlifyImageUrl } from '../../lib/netlify-image';

const chatreplay3 = '/chatreplay3 copy.png';
const chatreplay4 = '/chatreplay4 copy.png';
const chatreplay5 = '/chatreplay5 copy.png';
const chatreplay6 = '/chatreplay6 copy.png';
const chatreplay3Lightbox = netlifyImageUrl({ src: chatreplay3, width: 1600 });
const chatreplay4Lightbox = netlifyImageUrl({ src: chatreplay4, width: 1200 });
const chatreplay5Lightbox = netlifyImageUrl({ src: chatreplay5, width: 1200 });
const chatreplay6Lightbox = netlifyImageUrl({ src: chatreplay6, width: 1600 });
const reviewImageWidths = [360, 640, 900, 1200];
const archetypeImageWidths = [280, 420, 640, 900];
const reviewImageSizes = '(max-width: 767px) 100vw, 50vw';
const archetypeImageSizes = '(max-width: 767px) 50vw, 360px';
---

<div class="chat-heading">
  <SectionHeading
    title="ChatGPT Year in Review"
    subtitle="2025 · A look at how AI showed up in my year."
  />
</div>

<div class="grid-two chat-review-row">
  <Card as="article" class="stack-card" padding="compact">
    <figure class="chat-figure">
      <button
        type="button"
        class="chat-image-button"
        data-chat-open
        data-chat-src={chatreplay3Lightbox}
        data-chat-alt="ChatGPT 2025 — If 2025 gave out awards"
        aria-label="Open image: A Year Worth Celebrating"
      >
        <img
          src={netlifyImageUrl({ src: chatreplay3, width: 640 })}
          srcset={netlifyImageSrcSet(chatreplay3, reviewImageWidths)}
          sizes={reviewImageSizes}
          alt="ChatGPT 2025 — If 2025 gave out awards"
          class="chat-img"
          loading="lazy"
          decoding="async"
          width={1687}
          height={1299}
        />
      </button>
      <figcaption class="eyebrow chat-caption">A Year Worth Celebrating</figcaption>
    </figure>
  </Card>

  <Card as="article" class="stack-card" padding="compact">
    <figure class="chat-figure">
      <button
        type="button"
        class="chat-image-button"
        data-chat-open
        data-chat-src={chatreplay6Lightbox}
        data-chat-alt="ChatGPT 2025 — My year painted in pixels"
        aria-label="Open image: My Year Painted in Pixels"
      >
        <img
          src={netlifyImageUrl({ src: chatreplay6, width: 640 })}
          srcset={netlifyImageSrcSet(chatreplay6, reviewImageWidths)}
          sizes={reviewImageSizes}
          alt="ChatGPT 2025 — My year painted in pixels"
          class="chat-img"
          loading="lazy"
          decoding="async"
          width={1697}
          height={1359}
        />
      </button>
      <figcaption class="eyebrow chat-caption">My Year Painted in Pixels</figcaption>
    </figure>
  </Card>
</div>

<Card as="article" class="stack-card archetype-card" padding="comfortable">
  <h3 class="section-title section-title-small" style="margin-bottom: 0.25rem;">My AI Archetype</h3>
  <p class="muted-copy archetype-excerpt" style="margin: 0;">
    Each year, ChatGPT reveals the lens through which you engaged with it most. Here's mine for 2025.
  </p>
  <div class="archetype-grid">
    <figure class="chat-figure">
      <button
        type="button"
        class="chat-image-button"
        data-chat-open
        data-chat-src={chatreplay4Lightbox}
        data-chat-alt="AI Archetype card — front"
        aria-label="Open image: AI Archetype card front"
      >
        <img
          src={netlifyImageUrl({ src: chatreplay4, width: 420 })}
          srcset={netlifyImageSrcSet(chatreplay4, archetypeImageWidths)}
          sizes={archetypeImageSizes}
          alt="AI Archetype card — front"
          class="chat-img"
          loading="lazy"
          decoding="async"
          width={1047}
          height={1412}
        />
      </button>
    </figure>
    <figure class="chat-figure">
      <button
        type="button"
        class="chat-image-button"
        data-chat-open
        data-chat-src={chatreplay5Lightbox}
        data-chat-alt="AI Archetype card — back"
        aria-label="Open image: AI Archetype card back"
      >
        <img
          src={netlifyImageUrl({ src: chatreplay5, width: 420 })}
          srcset={netlifyImageSrcSet(chatreplay5, archetypeImageWidths)}
          sizes={archetypeImageSizes}
          alt="AI Archetype card — back"
          class="chat-img"
          loading="lazy"
          decoding="async"
          width={1008}
          height={1368}
        />
      </button>
    </figure>
  </div>
</Card>

<div class="chat-lightbox" data-chat-lightbox hidden role="dialog" aria-modal="true" aria-label="Image preview">
  <button type="button" class="chat-lightbox-backdrop" data-chat-close aria-label="Close preview"></button>
  <div class="chat-lightbox-body">
    <button type="button" class="chat-lightbox-close" data-chat-close aria-label="Close preview">✕</button>
    <img src="" alt="" class="chat-lightbox-image" data-chat-lightbox-image />
  </div>
</div>

<style>
  .chat-figure {
    margin: 0;
    padding: 0;
  }

  .chat-heading {
    margin-top: 2rem;
  }

  .chat-heading :global(.section-title) {
    margin-bottom: 0.2rem;
  }

  .chat-heading :global(.section-subtitle) {
    margin: 0;
  }

  .chat-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
    transition: transform 0.3s ease;
  }

  .chat-image-button {
    width: 100%;
    display: block;
    border: 0;
    padding: 0;
    margin: 0;
    background: var(--color-transparent);
    cursor: zoom-in;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .chat-image-button:focus-visible {
    outline: 3px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .chat-image-button:hover .chat-img {
    transform: scale(1.05);
  }

  .chat-review-row .chat-image-button {
    display: block;
    min-height: 0;
  }

  .chat-review-row .chat-img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .chat-caption {
    margin-top: 0.6rem;
    text-align: center;
  }

  .chat-review-row {
    margin-bottom: 1rem;
  }

  .archetype-card {
    margin-top: 0;
  }

  .archetype-excerpt {
    white-space: normal;
  }

  @media (min-width: 768px) {
    .archetype-excerpt {
      white-space: nowrap;
    }
  }

  .archetype-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    max-width: 720px;
    margin-inline: auto;
    margin-top: 0.75rem;
  }

  .chat-lightbox {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    z-index: 1000;
    padding: 0.5rem;
    overflow-x: hidden;
  }

  .chat-lightbox[hidden] {
    display: none !important;
  }

  .chat-lightbox-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    border: 0;
    background: var(--color-overlay);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    cursor: pointer;
  }

  .chat-lightbox-body {
    box-sizing: border-box;
    position: relative;
    z-index: 2;
    width: min(1104px, 100%);
    max-width: 100%;
    max-height: calc(100dvh - 1rem);
    display: grid;
    gap: 0.75rem;
    padding: 3.35rem 1.2rem 1.2rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: 0 8px 40px rgb(11 34 63 / 22%);
    overflow-x: hidden;
    overflow-y: auto;
  }

  .chat-lightbox-close {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    border: 0;
    background: var(--color-card);
    color: var(--color-ink);
    border-radius: var(--radius);
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }

  .chat-lightbox-image {
    box-sizing: border-box;
    display: block;
    width: 100%;
    max-width: 100%;
    max-height: calc(100dvh - 6rem);
    object-fit: contain;
    border-radius: var(--radius);
  }

  @media (min-width: 768px) {
    .chat-review-row .chat-image-button {
      display: grid;
      place-items: center;
      min-height: clamp(240px, 30vw, 320px);
    }

    .chat-review-row .chat-img {
      width: auto;
      max-width: 100%;
      height: clamp(240px, 30vw, 320px);
    }
  }

  @media (max-width: 768px) {
    .chat-heading :global(.section-title) {
      font-size: clamp(2rem, 9vw, 2.35rem);
      line-height: 1.08;
      margin-bottom: 0.22rem;
    }

    .chat-heading :global(.section-subtitle) {
      font-size: clamp(1rem, 4.3vw, 1.1rem);
      line-height: 1.45;
    }
  }

  @media (max-width: 640px) {
    .archetype-grid {
      grid-template-columns: 1fr;
      max-width: 384px;
    }

    .chat-lightbox-body {
      width: 100%;
      max-width: 100%;
      padding: 3rem 0.55rem 0.55rem;
    }

    .chat-lightbox-image {
      width: 100%;
      max-width: 100%;
    }

    .chat-lightbox-close {
      top: 0.5rem;
      right: 0.5rem;
    }
  }
</style>

<script>
  const lightbox = document.querySelector('[data-chat-lightbox]');
  const lightboxImage = document.querySelector('[data-chat-lightbox-image]');

  const openLightbox = () => {
    if (!(lightbox instanceof HTMLElement) || !(lightboxImage instanceof HTMLImageElement)) return;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    if (!(lightbox instanceof HTMLElement) || !(lightboxImage instanceof HTMLImageElement)) return;
    lightbox.hidden = true;
    lightboxImage.src = '';
    lightboxImage.alt = '';
    document.body.style.overflow = '';
  };

  if (lightbox instanceof HTMLElement) {
    lightbox.hidden = true;
  }
  document.body.style.overflow = '';

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const openTrigger = target.closest('[data-chat-open]');
    if (openTrigger instanceof HTMLElement) {
      const src = openTrigger.dataset.chatSrc;
      const alt = openTrigger.dataset.chatAlt ?? 'Image preview';
      if (!src) return;
      if (!(lightboxImage instanceof HTMLImageElement)) return;
      lightboxImage.src = src;
      lightboxImage.alt = alt;
      openLightbox();
      return;
    }

    const closeTrigger = target.closest('[data-chat-close]');
    if (closeTrigger) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (!(lightbox instanceof HTMLElement) || lightbox.hidden) return;
    closeLightbox();
  });

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'hidden') return;
    if (!(lightbox instanceof HTMLElement) || lightbox.hidden) return;
    closeLightbox();
  });
</script>
