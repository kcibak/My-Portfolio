---
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
---

<div class="timeline">
	<!-- Entry 1 — top (odd) -->
	<div class="tl-entry">
		<div class="tl-card">
			<Card as="article" padding="compact">
				<Tag>Aug 2025 – Present</Tag>
				<h3 class="tl-title">Lead Web Developer</h3>
				<p class="tl-org">SCx CMC Solutions</p>
				<p class="tl-desc">Led delivery of 5 client platforms across pharma and nonprofit — architecture, Stripe, deployments.</p>
			</Card>
		</div>
		<div class="tl-dot"></div>
		<div class="tl-pad"></div>
	</div>

	<!-- Entry 2 — bottom (even) · placeholder after present -->
	<div class="tl-entry tl-entry--placeholder">
		<div class="tl-pad"></div>
		<div class="tl-dot tl-dot--muted"></div>
		<div class="tl-card">
			<Card as="article" padding="compact" class="tl-placeholder">
				<Tag>Coming Soon</Tag>
				<h3 class="tl-title">Next Role</h3>
				<p class="tl-org">TBD</p>
				<p class="tl-desc">Placeholder — open to full-time opportunities in full-stack or cloud engineering.</p>
			</Card>
		</div>
	</div>

	<!-- Entry 3 — top (odd) -->
	<div class="tl-entry">
		<div class="tl-card">
			<Card as="article" padding="compact">
				<Tag>May – Aug 2025</Tag>
				<h3 class="tl-title">Software Engineer Intern</h3>
				<p class="tl-org">Martinrea International</p>
				<p class="tl-desc">Replatformed a SaaS license system to React + TypeScript, cutting DB complexity ~25%.</p>
			</Card>
		</div>
		<div class="tl-dot"></div>
		<div class="tl-pad"></div>
	</div>

	<!-- Entry 4 — bottom (even) · placeholder before Azure -->
	<div class="tl-entry tl-entry--placeholder">
		<div class="tl-pad"></div>
		<div class="tl-dot tl-dot--muted"></div>
		<div class="tl-card">
			<Card as="article" padding="compact" class="tl-placeholder">
				<Tag>TBD</Tag>
				<h3 class="tl-title">Placeholder</h3>
				<p class="tl-org">—</p>
				<p class="tl-desc">Another cert, course, or milestone to be added here.</p>
			</Card>
		</div>
	</div>

	<!-- Entry 5 — top (odd) -->
	<div class="tl-entry">
		<div class="tl-card">
			<Card as="article" padding="compact">
				<Tag>Dec 2025</Tag>
				<h3 class="tl-title">Azure Fundamentals</h3>
				<p class="tl-org">AZ-900 Certification</p>
				<p class="tl-desc">Cloud services, security & identity. 44 MS Learn badges, 11 trophies.</p>
			</Card>
		</div>
		<div class="tl-dot"></div>
		<div class="tl-pad"></div>
	</div>

	<!-- Entry 6 — bottom (even) -->
	<div class="tl-entry">
		<div class="tl-pad"></div>
		<div class="tl-dot"></div>
		<div class="tl-card">
			<Card as="article" padding="compact">
				<Tag>Cybersecurity</Tag>
				<h3 class="tl-title">US Cyber Challenge</h3>
				<p class="tl-org">Cyber Quests</p>
				<p class="tl-desc">National cybersecurity pipeline. Ranked 42nd internationally.</p>
			</Card>
		</div>
	</div>
</div>

<style>
	/* ── Alternating horizontal timeline ── */
	.timeline {
		display: grid;
		grid-template-rows: min-content 28px min-content;
		grid-auto-flow: column;
		grid-auto-columns: 1fr;
		column-gap: 1.25rem;
		position: relative;
	}

	/* Horizontal line through the dot row */
	.timeline::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 0;
		right: 0;
		height: 2px;
		background: var(--color-border);
		border-radius: 999px;
		transform: translateY(-50%);
	}

	.tl-entry {
		display: contents;
	}

	/* ── Card cell — rows are fixed so cards fill them exactly ── */
	.tl-card {
		height: 100%;
	}

	.tl-card :global(.ui-card) {
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		overflow: hidden;
	}

	.tl-card :global(.tl-placeholder) {
		opacity: 0.5;
		border-style: dashed;
	}

	/* Muted dot for placeholder entries */
	.tl-dot--muted {
		background: var(--color-border) !important;
	}

	/* Cards fill their fixed-height row — no alignment shift needed */
	.tl-entry:nth-child(odd) .tl-card,
	.tl-entry:nth-child(even) .tl-card {
		align-self: stretch;
	}

	/* ── Dot ── */
	.tl-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--color-accent);
		border: 2px solid var(--color-bg);
		justify-self: center;
		align-self: center;
		z-index: 1;
	}

	/* ── Spacer (holds the empty row opposite the card) ── */
	.tl-pad {
		pointer-events: none;
	}

	/* ── Typography ── */
	.tl-title {
		margin: 0;
		font-size: var(--type-size-h4);
		font-weight: 600;
		line-height: 1.3;
	}

	.tl-org {
		margin: 0;
		font-size: var(--type-size-small);
		font-weight: 500;
		color: var(--color-muted);
	}

	.tl-desc {
		margin: 0;
		font-size: var(--type-size-small);
		color: var(--color-muted);
		line-height: 1.45;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ── Mobile: collapse to vertical timeline ── */
	@media (max-width: 767px) {
		.timeline {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			padding-left: 1.5rem;
		}

		.timeline::after {
			top: 0.5rem;
			bottom: 0.5rem;
			left: 5px;
			right: auto;
			width: 2px;
			height: auto;
			transform: none;
		}

		.tl-entry {
			display: block;
			position: relative;
		}

		.tl-dot,
		.tl-pad {
			display: none;
		}

		.tl-entry::before {
			content: '';
			position: absolute;
			width: 10px;
			height: 10px;
			background: var(--color-accent);
			border: 2px solid var(--color-bg);
			border-radius: 50%;
			top: 1rem;
			left: -1.5rem;
		}

		.tl-entry--placeholder::before {
			background: var(--color-border);
		}

		.tl-card {
			height: auto;
			min-height: 0;
		}
	}
</style>
