---
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';

type TimelineItem = {
	date: string;
	title: string;
	org: string;
	description: string;
};

type ProofItem = {
	tag: string;
	title: string;
	org: string;
	description: string;
	href?: string;
	linkLabel?: string;
};

const timelineItems: TimelineItem[] = [
	{
		date: 'Feb – May 2026',
		title: 'Cybersecurity & Architecture Consultant',
		org: 'Trace Systems Inc.',
		description:
			'Supported enterprise architecture with Zero Trust, secure system design, and workflow artifacts for DoW-aligned evaluations.'
	},
	{
		date: 'Aug 2025 – Present',
		title: 'Lead Web Developer',
		org: 'SCx CMC Solutions',
		description: 'Led delivery of 5 client platforms across pharma and nonprofit — architecture, Stripe, deployments.'
	},
	{
		date: 'Dec 2025',
		title: 'B.S. in Computer Science',
		org: 'University of South Florida',
		description: 'Graduated from the engineering school with a focus on computer science and software engineering.'
	},
	{
		date: 'May – Aug 2025',
		title: 'Software Engineer Intern',
		org: 'Martinrea International',
		description: 'Replatformed a SaaS license system to React + TypeScript, cutting DB complexity ~25%.'
	}
];

const proofItems: ProofItem[] = [
	{
		tag: 'In Progress',
		title: 'Certified CMMC Professional (CCP)',
		org: 'The Cyber AB',
		description: 'Studying CMMC model requirements, assessment processes, security control scoping, evidence collection, and compliance implementation.'
	},
	{
		tag: 'Microsoft Azure',
		title: 'MS Certified: Azure Fundamentals',
		org: 'Microsoft',
		description: 'Cloud services, security & identity. 44 MS Learn badges, 11 trophies.'
	},
	{
		tag: 'Cybersecurity',
		title: 'Cyber Quests',
		org: 'US Cyber Challenge',
		description: 'Competed in 3 US Cyber Challenge competitions. Ranked 42nd internationally most recently.',
		href: 'https://www.uscyberchallenge.org/',
		linkLabel: 'USCC Website'
	}
];

/*
