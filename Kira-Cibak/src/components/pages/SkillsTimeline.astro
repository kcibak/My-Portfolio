	</div>

	<!-- Entry 3 — bottom (even) -->
	<div class="tl-entry">
		<div class="tl-pad"></div>
		<div class="tl-dot"></div>
		<div class="tl-card" role="button" tabindex="0" data-tl-open>
			<Card as="article" padding="compact">
				<Tag>Dec 2025</Tag>
				<h3 class="tl-title">B.S. in Computer Science</h3>
				<p class="tl-org">University of South Florida</p>
				<p class="tl-desc">Graduated from the engineering school with a focus on computer science and software engineering.</p>
			</Card>
		</div>
	</div>

	<!-- Entry 4 — top (odd) · Azure Fundamentals -->
	<div class="tl-entry">
		<div class="tl-card" data-tl-open>
			<Card as="article" padding="compact">
				<Tag>Dec 2025</Tag>
				<h3 class="tl-title">Azure Fundamentals</h3>
				<p class="tl-org">Microsoft Certified</p>
				<p class="tl-desc">Cloud services, security & identity. 44 MS Learn badges, 11 trophies.</p>
			</Card>
		</div>
		<div class="tl-dot"></div>
		<div class="tl-pad"></div>
	</div>

	<!-- Entry 5 — bottom (even) · BS Degree -->
	<div class="tl-entry">
		<div class="tl-pad"></div>
		<div class="tl-dot"></div>
		<div class="tl-card" data-tl-open>
			<Card as="article" padding="compact">
				<Tag>May – Aug 2025</Tag>
				<h3 class="tl-title">Software Engineer Intern</h3>
