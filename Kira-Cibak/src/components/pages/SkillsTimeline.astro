*/

/*
Old proof-tree markup kept for reference:

<div class="proof-tree" aria-label="Certifications and challenges">
	{
		proofItems.map((item, index) => {
			const side = index % 2 === 0 ? 'left' : 'right';

			return (
				<div class="proof-entry" data-side={side}>
					<div class="proof-card-wrap">
						<Card as="article" padding="compact" class="proof-card">
							<Tag>{item.tag}</Tag>
							<h3 class="proof-title">{item.title}</h3>
							<p class="proof-org">{item.org}</p>
							<p class="proof-desc">
								{item.description}
								{item.href && item.linkLabel ? (
									<>
										{' '}
										<a href={item.href} target="_blank" rel="noopener noreferrer">
											{item.linkLabel}
										</a>
									</>
								) : null}
							</p>
						</Card>
					</div>
					<div class="proof-node" aria-hidden="true"></div>
					<div class="proof-pad"></div>
				</div>
			);
		})
	}
</div>
*/
---

<div class="timeline">
	{
		timelineItems.map((item, index) => {
			const isTop = index % 2 === 1;

			return (
				<div class="tl-entry" data-placement={isTop ? 'top' : 'bottom'}>
					{isTop ? (
						<>
							<div class="tl-card" data-tl-open>
								<Card as="article" padding="compact">
									<Tag>{item.date}</Tag>
									<h3 class="tl-title">{item.title}</h3>
									<p class="tl-org">{item.org}</p>
									<p class="tl-desc">{item.description}</p>
								</Card>
							</div>
							<div class="tl-dot"></div>
							<div class="tl-pad"></div>
						</>
					) : (
						<>
							<div class="tl-pad"></div>
							<div class="tl-dot"></div>
							<div class="tl-card" data-tl-open>
								<Card as="article" padding="compact">
									<Tag>{item.date}</Tag>
									<h3 class="tl-title">{item.title}</h3>
									<p class="tl-org">{item.org}</p>
									<p class="tl-desc">{item.description}</p>
								</Card>
							</div>
						</>
					)}
				</div>
			);
		})
	}
</div>

<div class="proof-list" aria-label="Certifications and challenges">
	{
		proofItems.map((item) => (
			<Card as="article" padding="compact" class="proof-list-item">
				<div class="proof-list-heading">
					<Tag>{item.tag}</Tag>
					<h3 class="proof-title">{item.title}</h3>
				</div>
				<div class="proof-list-copy">
					<p class="proof-org">{item.org}</p>
					<p class="proof-desc">
						{item.description}
						{item.href && item.linkLabel ? (
							<>
								{' '}
								<a href={item.href} target="_blank" rel="noopener noreferrer">
									{item.linkLabel}
								</a>
							</>
						) : null}
					</p>
				</div>
			</Card>
		))
	}
</div>

<div class="tl-lightbox" data-tl-lightbox hidden>
	<button type="button" class="tl-lightbox-backdrop" data-tl-close aria-label="Close detail"></button>
	<div
		class="tl-lightbox-body"
		data-tl-body
		tabindex="-1"
		role="dialog"
		aria-modal="true"
		aria-labelledby="tl-lightbox-title"
		aria-describedby="tl-lightbox-desc"
	>
		<button type="button" class="tl-lightbox-close" data-tl-close aria-label="Close detail">✕</button>
		<span class="tl-lightbox-tag" data-tl-date></span>
		<h3 class="tl-lightbox-title" id="tl-lightbox-title" data-tl-title></h3>
		<p class="tl-lightbox-org" data-tl-org></p>
		<p class="tl-lightbox-desc" id="tl-lightbox-desc" data-tl-desc></p>
	</div>
</div>

<style>
	/* ── Alternating horizontal timeline ── */
	.timeline {
		--tl-card-height: 10.3rem;
		--tl-card-width: 180px;
		--tl-card-padding: 0.76rem 0.83rem 0.81rem;
		--tl-card-gap: 0.34rem;
		--tl-stack-gap: 0.85rem;
		--tl-rail-gap: 2rem;
		--tl-side-gutter: 1.6rem;
		--tl-rail-left: 1.6rem;
		--tl-rail-right: 1.6rem;
		display: grid;
		grid-template-rows: var(--tl-card-height) var(--tl-rail-gap) var(--tl-card-height);
		grid-auto-flow: column;
		grid-auto-columns: minmax(var(--tl-card-width), 1fr);
		column-gap: 0.85rem;
		padding-inline: var(--tl-side-gutter);
		margin-inline: calc(var(--tl-side-gutter) * -1);
		position: relative;
	}

	/* Horizontal line through the dot row */
	.timeline::after {
		content: '';
		position: absolute;
		top: 50%;
		left: var(--tl-rail-left);
		right: var(--tl-rail-right);
		height: 2px;
		background: var(--color-border);
		border-radius: 999px;
		transform: translateY(-50%);
	}

	.tl-entry {
		display: contents;
	}

	/* ── Card cell — rows are fixed so cards fill them exactly ── */
	.tl-card {
		height: var(--tl-card-height);
		width: 100%;
		cursor: pointer;
	}

	.tl-card :global(.ui-card) {
		box-sizing: border-box;
		height: 100%;
		min-height: var(--tl-card-height);
		max-height: var(--tl-card-height);
		width: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		position: relative;
		gap: var(--tl-card-gap);
		padding: var(--tl-card-padding);
		overflow: hidden;
		transition:
			transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.3s ease,
			border-color 0.3s ease,
			background-color 0.3s ease;
	}

	.tl-card :global(.ui-tag) {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		align-self: flex-start;
		position: absolute;
		top: 0.76rem;
		left: 0.83rem;
		width: fit-content;
		padding: 0.3rem 0.9rem !important;
		margin-inline-start: 0;
		font-size: 0.82rem;
		line-height: 1.2;
		white-space: nowrap;
		margin-bottom: 0;
		pointer-events: none;
	}

	.tl-card:hover :global(.ui-card),
	.tl-card:focus-visible :global(.ui-card) {
		transform: translateY(-5px);
		box-shadow: var(--ui-card-shadow-warm-glow);
		border-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
		background: color-mix(in srgb, var(--color-accent) 3%, var(--color-card));
	}

	.tl-card:focus-visible {
		outline: none;
	}

	.tl-card:focus-visible :global(.ui-card) {
		outline: 3px solid var(--color-focus-ring);
		outline-offset: 2px;
	}

	/* ── Dot ── */
	.tl-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--color-accent);
		border: 2px solid var(--color-bg);
		justify-self: center;
		align-self: center;
		z-index: 1;
	}

	/* ── Spacer (holds the empty row opposite the card) ── */
	.tl-pad {
		pointer-events: none;
	}

	/* ── Typography ── */
	.tl-title {
		margin: 0;
		font-size: var(--type-size-h4);
		font-weight: 600;
		line-height: 1.3;
	}

	.tl-org {
		margin: 0;
		font-size: var(--type-size-small);
		font-weight: 500;
		color: var(--color-muted);
	}

	.tl-desc {
		margin: 0;
		font-size: var(--type-size-small);
		color: var(--color-muted);
		line-height: 1.45;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-overflow: ellipsis;
		word-break: break-word;
		mask-image: linear-gradient(180deg, #000 78%, transparent 100%);
	}

	.tl-desc a {
		font: inherit;
		color: inherit;
		text-decoration: underline;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.18em;
	}

	.tl-desc a:hover {
		color: var(--color-accent);
	}

	/* Hide descriptions on timeline cards */
	.tl-card .tl-desc {
		display: none;
	}

	/*
	Old proof-tree CSS kept for reference:
	.proof-tree {
		--proof-axis-left: 50%;
		--proof-node-size: 9px;
		position: relative;
		display: grid;
		gap: 0.55rem;
		margin-top: 3.35rem;
		padding: 0.2rem 0;
	}

	.proof-tree::before {
		content: '';
		position: absolute;
		top: 0.45rem;
		bottom: 0.45rem;
		left: var(--proof-axis-left);
		width: 1px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-border) 72%, transparent);
		transform: translateX(-50%);
	}

	.proof-entry {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 1rem minmax(0, 1fr);
		align-items: center;
		column-gap: 1.25rem;
		min-height: 5.8rem;
	}

	.proof-entry[data-side='left'] .proof-card-wrap {
		grid-column: 1;
		justify-self: end;
	}

	.proof-entry[data-side='left'] .proof-node {
		grid-column: 2;
	}

	.proof-entry[data-side='left'] .proof-pad {
		grid-column: 3;
	}

	.proof-entry[data-side='right'] .proof-card-wrap {
		grid-column: 3;
		justify-self: start;
	}

	.proof-entry[data-side='right'] .proof-node {
		grid-column: 2;
		grid-row: 1;
	}

	.proof-entry[data-side='right'] .proof-pad {
		grid-column: 1;
		grid-row: 1;
	}

	.proof-card-wrap {
		width: min(100%, 560px);
	}

	.proof-card-wrap :global(.proof-card) {
		display: grid;
		gap: 0.24rem;
		padding: 0.78rem 0.95rem;
		background: color-mix(in srgb, var(--color-card) 34%, transparent);
		border-color: color-mix(in srgb, var(--color-border) 76%, transparent);
		box-shadow: none;
	}

	.proof-card-wrap :global(.ui-tag) {
		justify-self: start;
		width: fit-content;
		white-space: nowrap;
		padding: 0.16rem 0.52rem;
		font-size: 0.76rem;
		background: color-mix(in srgb, var(--color-accent) 8%, transparent);
	}

	.proof-node {
		width: var(--proof-node-size);
		height: var(--proof-node-size);
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-accent) 78%, var(--color-bg));
		border: 2px solid var(--color-bg);
		justify-self: center;
		z-index: 1;
	}
	*/

	.proof-list {
		display: grid;
		gap: 1rem;
		margin-top: 3.35rem;
		padding-inline: var(--tl-side-gutter);
		margin-inline: calc(var(--tl-side-gutter) * -1);
	}

	.proof-list :global(.proof-list-item) {
		display: grid;
		grid-template-columns: minmax(220px, 0.42fr) minmax(0, 1fr);
		align-items: center;
		gap: 0.85rem 1.4rem;
		padding: 0.95rem 1.1rem;
		background: color-mix(in srgb, var(--color-card) 32%, transparent);
		border-color: color-mix(in srgb, var(--color-border) 78%, transparent);
		box-shadow: none;
	}

	.proof-list-heading {
		display: grid;
		gap: 0.28rem;
		align-content: start;
	}

	.proof-list-copy {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
	}

	.proof-list :global(.ui-tag) {
		justify-self: start;
		width: fit-content;
		white-space: nowrap;
		padding: 0.16rem 0.52rem;
		font-size: 0.76rem;
		background: color-mix(in srgb, var(--color-accent) 8%, transparent);
	}

	.proof-title {
		margin: 0;
		font-size: var(--type-size-h4);
		font-weight: 600;
		line-height: 1.3;
	}

	.proof-org {
		margin: 0;
		font-size: var(--type-size-small);
		font-weight: 500;
		color: var(--color-muted);
	}

	.proof-desc {
		margin: 0;
		font-size: var(--type-size-small);
		line-height: 1.45;
		color: var(--color-muted);
	}

	.proof-desc a {
		font: inherit;
		color: inherit;
		text-decoration: underline;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.18em;
	}

	.proof-desc a:hover {
		color: var(--color-accent);
	}

	.tl-lightbox {
		position: fixed;
		inset: 0;
		display: grid;
		place-items: center;
		z-index: 1000;
		padding: 1rem;
	}

	.tl-lightbox[hidden] {
		display: none !important;
	}

	.tl-lightbox-backdrop {
		position: absolute;
		inset: 0;
		z-index: 0;
		border: 0;
		background: var(--color-overlay);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		cursor: pointer;
	}

	.tl-lightbox-body {
		position: relative;
		z-index: 2;
		width: min(560px, 94vw);
		max-height: 90vh;
		display: grid;
		gap: 0.6rem;
		padding: 2.5rem 1.4rem 1.4rem;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow: 0 8px 40px rgb(11 34 63 / 22%);
		overflow: auto;
	}

	.tl-lightbox-close {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		border: 1px solid var(--color-border);
		background: var(--color-card);
		color: var(--color-ink);
		border-radius: var(--radius);
		width: 2rem;
		height: 2rem;
		display: grid;
		place-items: center;
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
	}

	.tl-lightbox-tag {
		display: inline-flex;
		align-self: flex-start;
		justify-content: flex-start;
		padding: 0.32rem 1rem;
		width: fit-content;
		white-space: nowrap;
		border-radius: calc(var(--radius) * 999);
		font-size: var(--type-size-small);
		font-weight: var(--type-weight-small);
		line-height: var(--type-line-small);
		color: var(--color-ink);
		background: color-mix(in srgb, var(--color-accent) 12%, transparent);
	}

	.tl-lightbox-title {
		margin: 0;
		font-size: var(--type-size-h3);
		font-weight: 600;
		line-height: 1.3;
	}

	.tl-lightbox-org {
		margin: 0;
		font-size: var(--type-size-body);
		font-weight: 500;
		color: var(--color-muted);
	}

	.tl-lightbox-desc {
		margin: 0;
		font-size: var(--type-size-body);
		line-height: 1.6;
		color: var(--color-muted);
	}

	.tl-lightbox-desc a:hover {
		text-decoration: underline;
		color: var(--color-accent);
	}

	@media (min-width: 768px) {
		/*
		Old stagger selectors kept for reference:
		.tl-entry:nth-child(odd) .tl-card {
			align-self: stretch;
			padding-bottom: 0.25rem;
		}

		.tl-entry:nth-child(even) .tl-card {
			align-self: stretch;
			padding-top: 0.25rem;
		}
		*/

		/* Cards fill their fixed-height row; placement is now derived from item index. */
		.tl-entry[data-placement='bottom'] .tl-card {
			align-self: stretch;
			padding-bottom: 0.25rem;
		}

		.tl-entry[data-placement='top'] .tl-card {
			align-self: stretch;
			padding-top: 0.25rem;
		}
	}

	/* ── Mobile: collapse to vertical timeline ── */
	@media (max-width: 767px) {
		.timeline {
			display: flex;
			flex-direction: column;
			grid-template-rows: none;
			grid-auto-columns: unset;
			gap: var(--tl-stack-gap);
			padding-inline: 0;
			margin-inline: 0;
		}

		.timeline::after {
			display: none;
		}

		.tl-entry {
			display: block;
		}

		.tl-dot,
		.tl-pad {
			display: none;
		}

		.tl-card {
			height: auto;
			min-height: 0;
			padding-top: 0;
			padding-bottom: 0;
		}

		.tl-card :global(.ui-card) {
			justify-content: flex-start;
			min-height: 0;
			max-height: none;
			padding: 0.9rem;
			gap: 0.34rem;
		}

		.tl-card :global(.ui-tag) {
			position: static;
			font-size: 0.74rem;
			padding: 0.2rem 0.58rem !important;
			margin-inline-start: 0;
			margin-bottom: 0.08rem;
			white-space: normal;
		}

		.tl-card:hover :global(.ui-card),
		.tl-card:focus-visible :global(.ui-card) {
			transform: none;
		}

		.tl-title {
			margin-bottom: 0;
			font-size: 1rem;
			line-height: 1.28;
		}

		.tl-org {
			margin-bottom: 0;
			font-size: 0.82rem;
			line-height: 1.35;
		}

		.tl-card .tl-desc {
			display: block;
			margin-top: 0;
			font-size: 0.78rem;
			line-height: 1.42;
			-webkit-line-clamp: 2;
			mask-image: none;
		}

		/*
		Old proof-tree mobile CSS kept for reference:
		.proof-tree {
			--proof-axis-left: 0.42rem;
			gap: 0.7rem;
			margin-top: 2rem;
			padding-left: 0;
		}

		.proof-tree::before {
			top: 0.35rem;
			bottom: 0.35rem;
		}

		.proof-entry,
		.proof-entry[data-side='left'],
		.proof-entry[data-side='right'] {
			grid-template-columns: 1rem minmax(0, 1fr);
			column-gap: 0.72rem;
			min-height: 0;
		}

		.proof-entry[data-side='left'] .proof-card-wrap,
		.proof-entry[data-side='right'] .proof-card-wrap {
			grid-column: 2;
			grid-row: 1;
			justify-self: stretch;
			width: 100%;
		}

		.proof-entry[data-side='left'] .proof-node,
		.proof-entry[data-side='right'] .proof-node {
			grid-column: 1;
			grid-row: 1;
		}

		.proof-pad {
			display: none;
		}

		.proof-card-wrap :global(.proof-card) {
			padding: 0.78rem 0.85rem;
		}
		*/

		.proof-list {
			gap: 0.8rem;
			margin-top: 2rem;
			padding-inline: 0;
			margin-inline: 0;
		}

		.proof-list :global(.proof-list-item) {
			grid-template-columns: 1fr;
			gap: 0.55rem;
			padding: 0.85rem;
		}

		.proof-list :global(.ui-tag) {
			font-size: 0.74rem;
			padding: 0.16rem 0.5rem;
			white-space: normal;
		}

		.proof-title {
			font-size: 1rem;
			line-height: 1.28;
		}

		.proof-org {
			font-size: 0.82rem;
			line-height: 1.35;
		}

		.proof-desc {
			font-size: 0.78rem;
			line-height: 1.42;
		}

		.tl-lightbox-body {
			width: min(520px, 96vw);
			padding: 2.4rem 1.2rem 1.2rem;
		}
	}
</style>

<script>
	const timeline = document.querySelector('.timeline');
	const lightbox = document.querySelector('[data-tl-lightbox]');
	const lightboxDate = document.querySelector('[data-tl-date]');
	const lightboxTitle = document.querySelector('[data-tl-title]');
	const lightboxOrg = document.querySelector('[data-tl-org]');
	const lightboxDesc = document.querySelector('[data-tl-desc]');
	const lightboxBody = document.querySelector('[data-tl-body], .tl-lightbox-body');
	let lastTrigger: HTMLElement | null = null;
	let timelineModalOpen = false;

	const syncTimelineRailToDots = () => {
		if (!(timeline instanceof HTMLElement)) return;

		const dots = timeline.querySelectorAll<HTMLElement>('.tl-dot');
		if (dots.length < 2) return;

		const firstDot = dots[0];
		const lastDot = dots[dots.length - 1];
		const timelineRect = timeline.getBoundingClientRect();
		const firstRect = firstDot.getBoundingClientRect();
		const lastRect = lastDot.getBoundingClientRect();

		const firstCenter = firstRect.left + firstRect.width / 2 - timelineRect.left;
		const lastCenter = lastRect.left + lastRect.width / 2 - timelineRect.left;

		const railLeft = Math.max(0, firstCenter);
		const railRight = Math.max(0, timelineRect.width - lastCenter);

		timeline.style.setProperty('--tl-rail-left', `${railLeft}px`);
		timeline.style.setProperty('--tl-rail-right', `${railRight}px`);
	};

	const requestRailSync = () => {
		requestAnimationFrame(() => {
			syncTimelineRailToDots();
		});
	};

	const getLightboxFocusableElements = (): HTMLElement[] => {
		if (!(lightbox instanceof HTMLElement)) return [];

		const selectors = [
			'button:not([disabled])',
			'[href]',
			'input:not([disabled]):not([type="hidden"])',
			'select:not([disabled])',
			'textarea:not([disabled])',
			'[tabindex]:not([tabindex="-1"])'
		].join(',');

		const body = lightbox.querySelector('.tl-lightbox-body');
		if (!(body instanceof HTMLElement)) return [];

		return Array.from(body.querySelectorAll<HTMLElement>(selectors)).filter((element) => {
			return !element.hasAttribute('disabled') && element.getAttribute('aria-hidden') !== 'true';
		});
	};

	const lockBodyScroll = () => {
		if (timelineModalOpen) return;
		timelineModalOpen = true;
		document.documentElement.dataset.modalOpen = 'true';
	};

	const unlockBodyScroll = () => {
		if (!timelineModalOpen) return;
		timelineModalOpen = false;
		delete document.documentElement.dataset.modalOpen;
	};

	const isMobile = () => window.innerWidth < 768;

	const updateCardInteractivity = () => {
		const cards = document.querySelectorAll<HTMLElement>('[data-tl-open]');
		const mobile = isMobile();
		cards.forEach(card => {
			if (mobile) {
				card.removeAttribute('role');
				card.removeAttribute('tabindex');
			} else {
				if (!card.hasAttribute('role')) card.setAttribute('role', 'button');
				if (!card.hasAttribute('tabindex')) card.setAttribute('tabindex', '0');
			}
		});
	};

		const openLightbox = (card: HTMLElement) => {
			if (!(lightbox instanceof HTMLElement)) return;

			const date = card.querySelector('.ui-tag')?.textContent?.trim() ?? '';
			const title = card.querySelector('.tl-title')?.textContent?.trim() ?? '';
			const org = card.querySelector('.tl-org')?.textContent?.trim() ?? '';
			const descSource = card.querySelector('.tl-desc');

			if (lightboxDate instanceof HTMLElement) lightboxDate.textContent = date;
			if (lightboxTitle instanceof HTMLElement) lightboxTitle.textContent = title;
			if (lightboxOrg instanceof HTMLElement) lightboxOrg.textContent = org;
			if (lightboxDesc instanceof HTMLElement) {
				lightboxDesc.replaceChildren();
				if (descSource instanceof HTMLElement) {
					lightboxDesc.append(...Array.from(descSource.childNodes).map((node) => node.cloneNode(true)));
				}
			}

		lastTrigger = card;
		lightbox.hidden = false;
		lockBodyScroll();

		const closeButton = lightbox.querySelector<HTMLElement>('.tl-lightbox-close[data-tl-close]');
		if (closeButton instanceof HTMLElement) {
			closeButton.focus();
		} else if (lightboxBody instanceof HTMLElement) {
			lightboxBody.focus();
		}
	};

	const closeLightbox = () => {
		if (!(lightbox instanceof HTMLElement)) return;
		if (lightbox.hidden) return;
		lightbox.hidden = true;
		unlockBodyScroll();

		if (lastTrigger instanceof HTMLElement && lastTrigger.isConnected) {
			lastTrigger.focus({ preventScroll: true });
		}
		lastTrigger = null;
	};

	if (lightbox instanceof HTMLElement) {
		lightbox.hidden = true;

		lightbox.addEventListener(
			'wheel',
			(event) => {
				if (!lightbox.hidden) event.preventDefault();
			},
			{ passive: false }
		);

		lightbox.addEventListener(
			'touchmove',
			(event) => {
				if (!lightbox.hidden) event.preventDefault();
			},
			{ passive: false }
		);
	}

	requestRailSync();
	window.addEventListener('resize', requestRailSync);

	if (timeline instanceof HTMLElement && 'ResizeObserver' in window) {
		const timelineObserver = new ResizeObserver(() => {
			requestRailSync();
		});

		timelineObserver.observe(timeline);
	}

	updateCardInteractivity();
	window.addEventListener('resize', updateCardInteractivity);

	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		if (target.closest('[data-tl-close]')) {
			closeLightbox();
			return;
		}

		const trigger = target.closest('[data-tl-open]');
		if (trigger instanceof HTMLElement && !isMobile()) {
			openLightbox(trigger);
		}
	});

	document.addEventListener('keydown', (event) => {
		if (!(lightbox instanceof HTMLElement) || lightbox.hidden) {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			const activeElement = document.activeElement;
			if (!(activeElement instanceof HTMLElement) || !activeElement.hasAttribute('data-tl-open')) return;

			event.preventDefault();
			if (!isMobile()) {
				openLightbox(activeElement);
			}
			return;
		}

		if (event.key === 'Escape') {
			closeLightbox();
			return;
		}

		if (['PageUp', 'PageDown', 'Home', 'End', 'ArrowUp', 'ArrowDown'].includes(event.key)) {
			event.preventDefault();
			return;
		}

		if (event.key === 'Tab') {
			const focusable = getLightboxFocusableElements();
			if (focusable.length === 0) {
				event.preventDefault();
				if (lightboxBody instanceof HTMLElement) {
					lightboxBody.focus();
				}
				return;
			}

			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			const activeElement = document.activeElement;

			if (event.shiftKey) {
				if (activeElement === first || !lightbox.contains(activeElement)) {
					event.preventDefault();
					last.focus();
				}
				return;
			}

			if (activeElement === last || !lightbox.contains(activeElement)) {
				event.preventDefault();
				first.focus();
			}
		}
	});
</script>
