---
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
---

<div class="timeline">
	<!-- Entry 1 — bottom (even) -->
	<div class="tl-entry">
		<div class="tl-pad"></div>
		<div class="tl-dot"></div>
		<div class="tl-card" data-tl-open>
			<Card as="article" padding="compact">
				<Tag>Feb 2026 – Present</Tag>
				<h3 class="tl-title">Cybersecurity & Architecture Consultant</h3>
				<p class="tl-org">Trace Systems Inc.</p>
				<p class="tl-desc">Supported enterprise architecture with Zero Trust, secure system design, and workflow artifacts for DoW-aligned evaluations.</p>
			</Card>
		</div>
	</div>

	<!-- Entry 2 — top (odd) -->
	<div class="tl-entry">
		<div class="tl-card" data-tl-open>
			<Card as="article" padding="compact">
				<Tag>Aug 2025 – Present</Tag>
				<h3 class="tl-title">Lead Web Developer</h3>
				<p class="tl-org">SCx CMC Solutions</p>
				<p class="tl-desc">Led delivery of 5 client platforms across pharma and nonprofit — architecture, Stripe, deployments.</p>
			</Card>
		</div>
		<div class="tl-dot"></div>
		<div class="tl-pad"></div>
	</div>

	<!-- Entry 3 — bottom (even) -->
	<div class="tl-entry">
		<div class="tl-pad"></div>
		<div class="tl-dot"></div>
		<div class="tl-card" role="button" tabindex="0" data-tl-open>
			<Card as="article" padding="compact">
				<Tag>Dec 2025</Tag>
				<h3 class="tl-title">B.S. in Computer Science</h3>
				<p class="tl-org">University of South Florida</p>
				<p class="tl-desc">Graduated from the engineering school with a focus on computer science and software engineering.</p>
			</Card>
		</div>
	</div>

	<!-- Entry 4 — top (odd) · Azure Fundamentals -->
	<div class="tl-entry">
		<div class="tl-card" data-tl-open>
			<Card as="article" padding="compact">
				<Tag>Dec 2025</Tag>
				<h3 class="tl-title">Azure Fundamentals</h3>
				<p class="tl-org">Microsoft Certified</p>
				<p class="tl-desc">Cloud services, security & identity. 44 MS Learn badges, 11 trophies.</p>
			</Card>
		</div>
		<div class="tl-dot"></div>
		<div class="tl-pad"></div>
	</div>

	<!-- Entry 5 — bottom (even) · BS Degree -->
	<div class="tl-entry">
		<div class="tl-pad"></div>
		<div class="tl-dot"></div>
		<div class="tl-card" data-tl-open>
			<Card as="article" padding="compact">
				<Tag>May – Aug 2025</Tag>
				<h3 class="tl-title">Software Engineer Intern</h3>
				<p class="tl-org">Martinrea International</p>
				<p class="tl-desc">Replatformed a SaaS license system to React + TypeScript, cutting DB complexity ~25%.</p>
			</Card>
		</div>
	</div>

	<!-- Entry 6 — top (odd) -->
	<div class="tl-entry">
		<div class="tl-card" data-tl-open>
			<Card as="article" padding="compact">
				<Tag>Cybersecurity</Tag>
				<h3 class="tl-title">US Cyber Challenge</h3>
				<p class="tl-org">Cyber Quests</p>
				<p class="tl-desc">Competed in 3 US Cyber Challenge competitions. Ranked 42nd internationally most recently. <a href="https://www.uscyberchallenge.org/" target="_blank" rel="noopener noreferrer">USCC Website</a></p>
			</Card>
		</div>
		<div class="tl-dot"></div>
		<div class="tl-pad"></div>
	</div>
</div>

<div class="tl-lightbox" data-tl-lightbox hidden>
	<button type="button" class="tl-lightbox-backdrop" data-tl-close aria-label="Close detail"></button>
	<div
		class="tl-lightbox-body"
		data-tl-body
		tabindex="-1"
		role="dialog"
		aria-modal="true"
		aria-labelledby="tl-lightbox-title"
		aria-describedby="tl-lightbox-desc"
	>
		<button type="button" class="tl-lightbox-close" data-tl-close aria-label="Close detail">✕</button>
		<span class="tl-lightbox-tag" data-tl-date></span>
		<h3 class="tl-lightbox-title" id="tl-lightbox-title" data-tl-title></h3>
		<p class="tl-lightbox-org" data-tl-org></p>
		<p class="tl-lightbox-desc" id="tl-lightbox-desc" data-tl-desc></p>
	</div>
</div>

<style>
	/* ── Alternating horizontal timeline ── */
	.timeline {
		--tl-card-height: 10.3rem;
		--tl-card-width: 180px;
		--tl-card-padding: 0.76rem 0.83rem 0.81rem;
		--tl-card-gap: 0.34rem;
		--tl-stack-gap: 0.85rem;
		--tl-rail-gap: 2rem;
		--tl-side-gutter: 1.6rem;
		--tl-rail-left: 1.6rem;
		--tl-rail-right: 1.6rem;
		display: grid;
		grid-template-rows: var(--tl-card-height) var(--tl-rail-gap) var(--tl-card-height);
		grid-auto-flow: column;
		grid-auto-columns: minmax(var(--tl-card-width), 1fr);
		column-gap: 0.85rem;
		padding-inline: var(--tl-side-gutter);
		margin-inline: calc(var(--tl-side-gutter) * -1);
		position: relative;
	}

	/* Horizontal line through the dot row */
	.timeline::after {
		content: '';
		position: absolute;
		top: 50%;
		left: var(--tl-rail-left);
		right: var(--tl-rail-right);
		height: 2px;
		background: var(--color-border);
		border-radius: 999px;
		transform: translateY(-50%);
	}

	.tl-entry {
		display: contents;
	}

	/* ── Card cell — rows are fixed so cards fill them exactly ── */
	.tl-card {
		height: var(--tl-card-height);
		width: 100%;
		cursor: pointer;
	}

	.tl-card :global(.ui-card) {
		box-sizing: border-box;
		height: 100%;
		min-height: var(--tl-card-height);
		max-height: var(--tl-card-height);
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: var(--tl-card-gap);
		padding: var(--tl-card-padding);
		overflow: hidden;
		transition:
			transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.3s ease,
			border-color 0.3s ease,
			background-color 0.3s ease;
	}

	.tl-card :global(.ui-tag) {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		align-self: flex-start;
		width: fit-content;
		padding: 0.3rem 0.9rem !important;
		margin-inline-start: 0.08rem;
		font-size: 0.82rem;
		line-height: 1.2;
		white-space: nowrap;
		margin-bottom: 0.15rem;
		pointer-events: none;
	}

	.tl-card:hover :global(.ui-card),
	.tl-card:focus-visible :global(.ui-card) {
		transform: translateY(-5px);
		box-shadow: var(--ui-card-shadow-warm-glow);
		border-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
		background: color-mix(in srgb, var(--color-accent) 3%, var(--color-card));
	}

	.tl-card:focus-visible {
		outline: none;
	}

	.tl-card:focus-visible :global(.ui-card) {
		outline: 3px solid var(--color-focus-ring);
		outline-offset: 2px;
	}

	/* ── Dot ── */
	.tl-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--color-accent);
		border: 2px solid var(--color-bg);
		justify-self: center;
		align-self: center;
		z-index: 1;
	}

	/* ── Spacer (holds the empty row opposite the card) ── */
	.tl-pad {
		pointer-events: none;
	}

	/* ── Typography ── */
	.tl-title {
		margin: 0;
		font-size: var(--type-size-h4);
		font-weight: 600;
		line-height: 1.3;
	}

	.tl-org {
		margin: 0;
		font-size: var(--type-size-small);
		font-weight: 500;
		color: var(--color-muted);
	}

	.tl-desc {
		margin: 0;
		font-size: var(--type-size-small);
		color: var(--color-muted);
		line-height: 1.45;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-overflow: ellipsis;
		word-break: break-word;
		mask-image: linear-gradient(180deg, #000 78%, transparent 100%);
	}

	.tl-desc a {
		font: inherit;
		color: inherit;
		text-decoration: underline;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.18em;
	}

	.tl-desc a:hover {
		color: var(--color-accent);
	}

	/* Hide descriptions on timeline cards */
	.tl-card .tl-desc {
		display: none;
	}

	.tl-lightbox {
		position: fixed;
		inset: 0;
		display: grid;
		place-items: center;
		z-index: 1000;
		padding: 1rem;
	}

	.tl-lightbox[hidden] {
		display: none !important;
	}

	.tl-lightbox-backdrop {
		position: absolute;
		inset: 0;
		z-index: 0;
		border: 0;
		background: var(--color-overlay);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		cursor: pointer;
	}

	.tl-lightbox-body {
		position: relative;
		z-index: 2;
		width: min(560px, 94vw);
		max-height: 90vh;
		display: grid;
		gap: 0.6rem;
		padding: 2.5rem 1.4rem 1.4rem;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow: 0 8px 40px rgb(11 34 63 / 22%);
		overflow: auto;
	}

	.tl-lightbox-close {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		border: 1px solid var(--color-border);
		background: var(--color-card);
		color: var(--color-ink);
		border-radius: var(--radius);
		width: 2rem;
		height: 2rem;
		display: grid;
		place-items: center;
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
	}

	.tl-lightbox-tag {
		display: inline-flex;
		align-self: flex-start;
		justify-content: flex-start;
		padding: 0.32rem 1rem;
		width: fit-content;
		white-space: nowrap;
		border-radius: calc(var(--radius) * 999);
		font-size: var(--type-size-small);
		font-weight: var(--type-weight-small);
		line-height: var(--type-line-small);
		color: var(--color-ink);
		background: color-mix(in srgb, var(--color-accent) 12%, transparent);
	}

	.tl-lightbox-title {
		margin: 0;
		font-size: var(--type-size-h3);
		font-weight: 600;
		line-height: 1.3;
	}

	.tl-lightbox-org {
		margin: 0;
		font-size: var(--type-size-body);
		font-weight: 500;
		color: var(--color-muted);
	}

	.tl-lightbox-desc {
		margin: 0;
		font-size: var(--type-size-body);
		line-height: 1.6;
		color: var(--color-muted);
	}

	.tl-lightbox-desc a:hover {
		text-decoration: underline;
		color: var(--color-accent);
	}

	@media (min-width: 768px) {
		/* Cards fill their fixed-height row — no alignment shift needed */
		.tl-entry:nth-child(odd) .tl-card {
			align-self: stretch;
			padding-bottom: 0.25rem;
		}

		.tl-entry:nth-child(even) .tl-card {
			align-self: stretch;
			padding-top: 0.25rem;
		}
	}

	/* ── Mobile: collapse to vertical timeline ── */
	@media (max-width: 767px) {
		.timeline {
			display: flex;
			flex-direction: column;
			grid-template-rows: none;
			grid-auto-columns: unset;
			gap: var(--tl-stack-gap);
			padding-inline: 0;
			margin-inline: 0;
		}

		.timeline::after {
			display: none;
		}

		.tl-entry {
			display: block;
		}

		.tl-dot,
		.tl-pad {
			display: none;
		}

		.tl-card {
			height: auto;
			min-height: 0;
			padding-top: 0;
			padding-bottom: 0;
		}

		.tl-card :global(.ui-card) {
			min-height: 0;
			max-height: none;
			padding: 0.9rem;
			gap: 0.34rem;
		}

		.tl-card :global(.ui-tag) {
			font-size: 0.74rem;
			padding: 0.2rem 0.58rem !important;
			margin-inline-start: 0;
			margin-bottom: 0.08rem;
			white-space: normal;
		}

		.tl-card:hover :global(.ui-card),
		.tl-card:focus-visible :global(.ui-card) {
			transform: none;
		}

		.tl-title {
			margin-bottom: 0;
			font-size: 1rem;
			line-height: 1.28;
		}

		.tl-org {
			margin-bottom: 0;
			font-size: 0.82rem;
			line-height: 1.35;
		}

		.tl-card .tl-desc {
			display: block;
			margin-top: 0;
			font-size: 0.78rem;
			line-height: 1.42;
			-webkit-line-clamp: 2;
			mask-image: none;
		}

		.tl-lightbox-body {
			width: min(520px, 96vw);
			padding: 2.4rem 1.2rem 1.2rem;
		}
	}
</style>

<script>
	const timeline = document.querySelector('.timeline');
	const lightbox = document.querySelector('[data-tl-lightbox]');
	const lightboxDate = document.querySelector('[data-tl-date]');
	const lightboxTitle = document.querySelector('[data-tl-title]');
	const lightboxOrg = document.querySelector('[data-tl-org]');
	const lightboxDesc = document.querySelector('[data-tl-desc]');
	const lightboxBody = document.querySelector('[data-tl-body], .tl-lightbox-body');
	let lastTrigger: HTMLElement | null = null;
	let scrollYBeforeLock = 0;
	let bodyStyleSnapshot: {
		position: string;
		top: string;
		left: string;
		right: string;
		width: string;
		overflow: string;
	} | null = null;

	const syncTimelineRailToDots = () => {
		if (!(timeline instanceof HTMLElement)) return;

		const dots = timeline.querySelectorAll<HTMLElement>('.tl-dot');
		if (dots.length < 2) return;

		const firstDot = dots[0];
		const lastDot = dots[dots.length - 1];
		const timelineRect = timeline.getBoundingClientRect();
		const firstRect = firstDot.getBoundingClientRect();
		const lastRect = lastDot.getBoundingClientRect();

		const firstCenter = firstRect.left + firstRect.width / 2 - timelineRect.left;
		const lastCenter = lastRect.left + lastRect.width / 2 - timelineRect.left;

		const railLeft = Math.max(0, firstCenter);
		const railRight = Math.max(0, timelineRect.width - lastCenter);

		timeline.style.setProperty('--tl-rail-left', `${railLeft}px`);
		timeline.style.setProperty('--tl-rail-right', `${railRight}px`);
	};

	const requestRailSync = () => {
		requestAnimationFrame(() => {
			syncTimelineRailToDots();
		});
	};

	const getLightboxFocusableElements = (): HTMLElement[] => {
		if (!(lightbox instanceof HTMLElement)) return [];

		const selectors = [
			'button:not([disabled])',
			'[href]',
			'input:not([disabled]):not([type="hidden"])',
			'select:not([disabled])',
			'textarea:not([disabled])',
			'[tabindex]:not([tabindex="-1"])'
		].join(',');

		const body = lightbox.querySelector('.tl-lightbox-body');
		if (!(body instanceof HTMLElement)) return [];

		return Array.from(body.querySelectorAll<HTMLElement>(selectors)).filter((element) => {
			return !element.hasAttribute('disabled') && element.getAttribute('aria-hidden') !== 'true';
		});
	};

	const lockBodyScroll = () => {
		const body = document.body;
		if (bodyStyleSnapshot) return;

		scrollYBeforeLock = window.scrollY;

		bodyStyleSnapshot = {
			position: body.style.position,
			top: body.style.top,
			left: body.style.left,
			right: body.style.right,
			width: body.style.width,
			overflow: body.style.overflow
		};

		body.style.position = 'fixed';
		body.style.top = `-${scrollYBeforeLock}px`;
		body.style.left = '0';
		body.style.right = '0';
		body.style.width = '100%';
		body.style.overflow = 'hidden';
	};

	const unlockBodyScroll = () => {
		const body = document.body;
		if (!bodyStyleSnapshot) return;

		body.style.position = bodyStyleSnapshot.position;
		body.style.top = bodyStyleSnapshot.top;
		body.style.left = bodyStyleSnapshot.left;
		body.style.right = bodyStyleSnapshot.right;
		body.style.width = bodyStyleSnapshot.width;
		body.style.overflow = bodyStyleSnapshot.overflow;

		bodyStyleSnapshot = null;
		window.scrollTo(0, scrollYBeforeLock);
	};

	const isMobile = () => window.innerWidth < 768;

	const updateCardInteractivity = () => {
		const cards = document.querySelectorAll<HTMLElement>('[data-tl-open]');
		const mobile = isMobile();
		cards.forEach(card => {
			if (mobile) {
				card.removeAttribute('role');
				card.removeAttribute('tabindex');
			} else {
				if (!card.hasAttribute('role')) card.setAttribute('role', 'button');
				if (!card.hasAttribute('tabindex')) card.setAttribute('tabindex', '0');
			}
		});
	};

		const openLightbox = (card: HTMLElement) => {
			if (!(lightbox instanceof HTMLElement)) return;

			const date = card.querySelector('.ui-tag')?.textContent?.trim() ?? '';
			const title = card.querySelector('.tl-title')?.textContent?.trim() ?? '';
			const org = card.querySelector('.tl-org')?.textContent?.trim() ?? '';
			const descSource = card.querySelector('.tl-desc');

			if (lightboxDate instanceof HTMLElement) lightboxDate.textContent = date;
			if (lightboxTitle instanceof HTMLElement) lightboxTitle.textContent = title;
			if (lightboxOrg instanceof HTMLElement) lightboxOrg.textContent = org;
			if (lightboxDesc instanceof HTMLElement) {
				lightboxDesc.replaceChildren();
				if (descSource instanceof HTMLElement) {
					lightboxDesc.append(...Array.from(descSource.childNodes).map((node) => node.cloneNode(true)));
				}
			}

		lastTrigger = card;
		lightbox.hidden = false;
		lockBodyScroll();

		const closeButton = lightbox.querySelector<HTMLElement>('.tl-lightbox-close[data-tl-close]');
		if (closeButton instanceof HTMLElement) {
			closeButton.focus();
		} else if (lightboxBody instanceof HTMLElement) {
			lightboxBody.focus();
		}
	};

	const closeLightbox = () => {
		if (!(lightbox instanceof HTMLElement)) return;
		if (lightbox.hidden) return;
		lightbox.hidden = true;
		unlockBodyScroll();

		if (lastTrigger instanceof HTMLElement && lastTrigger.isConnected) {
			lastTrigger.focus();
		}
		lastTrigger = null;
	};

	if (lightbox instanceof HTMLElement) {
		lightbox.hidden = true;
	}

	requestRailSync();
	window.addEventListener('resize', requestRailSync);

	if (timeline instanceof HTMLElement && 'ResizeObserver' in window) {
		const timelineObserver = new ResizeObserver(() => {
			requestRailSync();
		});

		timelineObserver.observe(timeline);
	}

	updateCardInteractivity();
	window.addEventListener('resize', updateCardInteractivity);

	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		if (target.closest('[data-tl-close]')) {
			closeLightbox();
			return;
		}

		const trigger = target.closest('[data-tl-open]');
		if (trigger instanceof HTMLElement && !isMobile()) {
			openLightbox(trigger);
		}
	});

	document.addEventListener('keydown', (event) => {
		if (!(lightbox instanceof HTMLElement) || lightbox.hidden) {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			const activeElement = document.activeElement;
			if (!(activeElement instanceof HTMLElement) || !activeElement.hasAttribute('data-tl-open')) return;

			event.preventDefault();
			if (!isMobile()) {
				openLightbox(activeElement);
			}
			return;
		}

		if (event.key === 'Escape') {
			closeLightbox();
			return;
		}

		if (event.key === 'Tab') {
			const focusable = getLightboxFocusableElements();
			if (focusable.length === 0) {
				event.preventDefault();
				if (lightboxBody instanceof HTMLElement) {
					lightboxBody.focus();
				}
				return;
			}

			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			const activeElement = document.activeElement;

			if (event.shiftKey) {
				if (activeElement === first || !lightbox.contains(activeElement)) {
					event.preventDefault();
					last.focus();
				}
				return;
			}

			if (activeElement === last || !lightbox.contains(activeElement)) {
				event.preventDefault();
				first.focus();
			}
		}
	});
</script>
