---
import Card from '../ui/Card.astro';

type Props = {
	title: string;
	description: string;
};

const {
	title,
	description
} = Astro.props as Props;
---

<Card class="case-section-card" padding="comfortable">
	<h2 class="section-title case-section-title">{title}</h2>
	<p class="section-subtitle section-subtitle-compact">{description}</p>
	<slot />
</Card>
