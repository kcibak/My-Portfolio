---
import ThemeToggle from './islands/ThemeToggle.tsx';

const links = [
	{ href: '/about', label: 'About' },
	{ href: '/skills', label: 'Experience' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/contact', label: 'Contact' }
];

const resumeHref = '/Kira%20Cibak_2025.pdf';

const socials = [
	{ href: 'https://www.linkedin.com/in/kira-cibak/', label: 'LinkedIn', icon: 'linkedin' },
	{ href: 'https://github.com/kcibak', label: 'GitHub', icon: 'github' }
];

const emailAddress = 'cibakkn@gmail.com';
---

<header class="dome-header" id="site-header">
	<ThemeToggle client:load />
	<div class="nav-shell">
		<div class="social-bar">
			{socials.map((link) => (
				<a class="social-icon" href={link.href} aria-label={link.label} target="_blank" rel="noreferrer">
					{link.icon === 'linkedin' ? (
						<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
							<path d="M6.94 9.75V18" />
							<circle cx="6.94" cy="6.94" r="1.44" />
							<path d="M12 18v-5.21c0-1.53 1.24-2.77 2.77-2.77s2.77 1.24 2.77 2.77V18" />
						</svg>
					) : (
						<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
							<path d="M9 19c-4 1-4-2-6-2m12 4v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7a5.44 5.44 0 0 0-1.5-3.75 5.07 5.07 0 0 0-.09-3.77S18.16-1 15 1.38a13.38 13.38 0 0 0-6 0C5-1 3.09 1 3.09 1a5.07 5.07 0 0 0-.09 3.77A5.44 5.44 0 0 0 1.5 8.5c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 7 18.13V22" />
						</svg>
					)}
				</a>
			))}
			<a
				class="social-icon resume-link"
				href={resumeHref}
				aria-label="View Resume"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
					<path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z" />
					<path d="M14 2v5h5" />
					<path d="M9 13h6" />
					<path d="M9 17h6" />
				</svg>
			</a>
			<button
				class="social-icon copy"
				id="email-copy"
				type="button"
				aria-label={`Copy ${emailAddress}`}
				data-email={emailAddress}
			>
				<span class="sr-only">Copy email address</span>
				<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
					<path d="m3 8 7.89 4.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/>
				</svg>
				<span class="copy-tooltip" id="email-tooltip" role="status" aria-live="polite">Email copied!</span>
			</button>
		</div>
		<a href="/" class="brand">Kira Cibak</a>
		<div class="menu-shell" id="menu-shell">
			<button
				class="menu-trigger"
				id="menu-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="parabola-menu"
				aria-label="Open primary navigation"
			>
				<span class="diamond-icon" aria-hidden="true">
					<svg viewBox="0 0 64 64" fill="none" xmlns="http:a//www.w3.org/2000/svg">
						<defs>
							<linearGradient id="diamond-face" x1="16" y1="12" x2="48" y2="52" gradientUnits="userSpaceOnUse">
								<stop stop-color="var(--color-accent)" stop-opacity="0.92" />
								<stop offset="1" stop-color="var(--color-accent)" stop-opacity="0.6" />
							</linearGradient>
							<linearGradient id="diamond-edge" x1="12" y1="10" x2="52" y2="54" gradientUnits="userSpaceOnUse">
								<stop stop-color="var(--color-ink)" stop-opacity="0.7" />
								<stop offset="1" stop-color="var(--color-ink)" stop-opacity="0.4" />
							</linearGradient>
						</defs>
						<path d="M32 4 8 32l24 28 24-28L32 4Z" fill="url(#diamond-face)" />
						<path d="M32 4 18 32l14 28 14-28L32 4Z" fill="url(#diamond-edge)" opacity="0.65" />
						<circle cx="32" cy="20" r="4" fill="var(--color-bg)" opacity="0.9" />
					</svg>
				</span>
			</button>
		</div>
	</div>
	<nav id="parabola-menu" class="parabola-menu" aria-label="Primary navigation" aria-hidden="true">
		{links.map((link, index) => (
			<a href={link.href} style={`--arc-offset:${Math.abs((links.length - 1) / 2 - index)};`}>{link.label}</a>
		))}
	</nav>
</header>

<style>
	:global(.dome-header) {
		position: sticky;
		top: 0;
		z-index: 70;
		backdrop-filter: blur(18px);
		background: var(--color-nav);
		border-bottom: 1px solid var(--color-border);
		height: 96px;
		box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
		transition: height 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}

	:global(.dome-header.is-open) {
		box-shadow: 0 22px 48px rgba(15, 23, 42, 0.15);
	}

	:global(:root[data-theme='dark'] .dome-header) {
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root[data-theme='auto'] .dome-header) {
			box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
		}
	}

	:global(.theme-toggle) {
		position: absolute;
		right: 1.2rem;
		top: 50%;
		transform: translateY(-50%);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		z-index: 75;
		width: 70px;
		height: 38px;
	}

	:global(.theme-toggle__input) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		appearance: none;
		margin: 0;
		cursor: pointer;
		z-index: 2;
	}

	:global(.theme-toggle__track) {
		position: relative;
		width: 70px;
		height: 38px;
		border-radius: 999px;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
		transition: background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 10px;
		box-sizing: border-box;
		pointer-events: none;
	}

	:global(.theme-toggle__knob) {
		position: absolute;
		top: 4px;
		left: 4px;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: var(--color-bg);
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
		transition: transform 0.2s ease, background 0.18s ease, box-shadow 0.18s ease;
	}

	:global(.theme-toggle__icon) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--color-ink);
		opacity: 0.8;
		transition: opacity 0.18s ease;
		pointer-events: none;
		z-index: 1;
	}

	:global(.theme-toggle[data-mode='dark'] .theme-toggle__track) {
		border-color: var(--color-accent);
		background: rgba(37, 99, 235, 0.16);
		box-shadow: 0 12px 34px rgba(0, 0, 0, 0.12);
	}

	:global(.theme-toggle[data-mode='dark'] .theme-toggle__knob) {
		transform: translateX(32px);
		background: var(--color-ink);
	}

	:global(.theme-toggle[data-mode='light'] .theme-toggle__icon.moon) {
		opacity: 0.25;
	}

	:global(.theme-toggle[data-mode='dark'] .theme-toggle__icon.sun) {
		opacity: 1;
		color: rgba(255, 255, 255, 0.9);
	}



	.nav-shell {
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 1.4rem 1.2rem 1rem;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		transition: padding 0.2s ease, grid-template-columns 0.2s ease;
	}

	.social-bar {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.55rem;
	}

	.social-icon {
		height: 44px;
		width: 44px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 14px;
		border: 1px solid var(--color-border);
		background: var(--color-card);
		color: var(--color-ink);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
		cursor: pointer;
	}

	.social-icon:hover,
	.social-icon:focus-visible {
		transform: translateY(-1px);
		box-shadow: 0 14px 34px rgba(0, 0, 0, 0.12);
		border-color: var(--color-accent);
		outline: none;
	}

	.copy {
		position: relative;
	}

	.copy-tooltip {
		position: absolute;
		left: 50%;
		bottom: -2.75rem;
		transform: translateX(-50%) translateY(8px);
		padding: 0.4rem 0.7rem;
		border-radius: 12px;
		background: var(--color-ink);
		color: var(--color-bg);
		font-size: 0.8rem;
		font-weight: 700;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease, transform 0.2s ease;
		white-space: nowrap;
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
	}

	.copy-tooltip.show {
		opacity: 1;
		transform: translateX(-50%) translateY(0);
	}

	.brand {
		justify-self: center;
		font-weight: 800;
		font-size: clamp(1.5rem, 2.2vw, 2.35rem);
		letter-spacing: -0.03em;
		color: var(--color-ink);
		text-decoration: none;
		transition: transform 0.2s ease, font-size 0.2s ease;
	}

	:global(.dome-header.is-condensed) {
		height: 64px;
	}

	:global(.dome-header.is-condensed) .nav-shell {
		grid-template-columns: 1fr;
		padding: 0.7rem 1.2rem;
	}

	:global(.dome-header.is-condensed) .brand {
		justify-self: center;
		transform: translateY(-1px);
		font-size: clamp(1.3rem, 2vw, 2rem);
	}

	:global(.dome-header.is-condensed) .social-bar,
	:global(.dome-header.is-condensed) .menu-shell,
	:global(.dome-header.is-condensed) .parabola-menu,
	:global(.dome-header.is-condensed) .theme-toggle {
		opacity: 0;
		pointer-events: none;
		transform: translateY(-6px);
		transition: opacity 0.16s ease, transform 0.16s ease;
	}


	:global(.dome-header.is-condensed) .social-bar,
	:global(.dome-header.is-condensed) .menu-shell,
	:global(.dome-header.is-condensed) .theme-toggle {
		display: none;
	}


	.menu-shell {
		justify-self: end;
		display: inline-flex;
		align-items: center;
	}

	.menu-trigger {
		display: inline-flex;
		align-items: center;
		padding: 0.4rem;
		border-radius: 12px;
		border: none;
		background: transparent;
		font-weight: 700;
		color: var(--color-ink);
		cursor: pointer;
		box-shadow: none;
		transition: none;
	}

	.menu-trigger:hover {
		outline: none;
	}

	.menu-trigger:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}

	.diamond-icon {
		width: 42px;
		height: 42px;
		display: grid;
		place-items: center;
		filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.14));
		transition: transform 0.28s ease;
	}

	.diamond-icon svg {
		width: 100%;
		height: 100%;
		transform-origin: center;
		transform: rotate(-8deg) scale(0.96);
		transition: transform 0.28s ease;
	}

	.menu-shell:hover .diamond-icon svg,
	.dome-header.is-open .diamond-icon svg {
		transform: rotate(180deg) scale(0.96);
	}

	.dome-header {
		position: sticky;
	}

	.parabola-menu {
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		transform: translateY(0) scale(0.98);
		width: 100%;
		height: clamp(84px, 6vw, 119px);
		opacity: 0;
		pointer-events: none;
		transition: transform 0.28s ease, opacity 0.28s ease;
		z-index: 60;
		clip-path: ellipse(100% 75% at 50% 0%);
		border-radius: 16px 16px 30px 30px;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		box-shadow: 0 24px 46px rgba(15, 23, 42, 0.14);
		backdrop-filter: blur(14px);
		display: flex;
		align-items: center;
		justify-content: space-evenly;
		gap: clamp(0.7rem, 2vw, 2rem);
		padding: 0.2rem 2rem 2rem;
		flex-wrap: nowrap;
		overflow-x: auto;
	}

	:global(.dome-header.is-condensed) .parabola-menu {
		display: none;
	}

	.menu-shell:hover + .parabola-menu,
	.dome-header.is-open .parabola-menu {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0) scale(1);
	}

	.parabola-menu a {
		font-weight: 500;
		font-size: 1.12rem;
		padding: 0.6rem 1rem;
		border-radius: 12px;
		color: var(--color-ink);
		transition: opacity 0.1s ease, transform 0.12s ease-out;
		white-space: nowrap;
		letter-spacing: 0.02em;
		position: relative;
		overflow: hidden;
		isolation: isolate;
	}

	.parabola-menu a::before {
		content: '';
		position: absolute;
		inset: -70% -90%;
		background:
			linear-gradient(
				120deg,
				rgba(91, 192, 235, 0) 0%,
				rgba(91, 192, 235, 0.05) 28%,
				rgba(255, 255, 255, 0.14) 42%,
				rgba(91, 192, 235, 0.12) 56%,
				rgba(255, 255, 255, 0.12) 70%,
				rgba(91, 192, 235, 0.04) 84%,
				rgba(91, 192, 235, 0) 100%
			),
			radial-gradient(circle at 28% 50%, rgba(255, 255, 255, 0.14), transparent 60%),
			radial-gradient(circle at 72% 40%, rgba(91, 192, 235, 0.12), transparent 65%);
		transform: translateX(-80%);
		opacity: 0;
		filter: blur(1.2px);
		transition: opacity 0s;
		pointer-events: none;
	}

	.parabola-menu a:hover::before,
	.parabola-menu a:focus-visible::before {
		opacity: 1;
		animation: nav-shimmer 2.2s ease-in-out infinite;
	}

	.parabola-menu a:hover,
	.parabola-menu a:focus-visible {
		transform: scale(1.03);
	}

	.parabola-menu a:focus-visible {
		outline: none;
		box-shadow: 0 0 0 2px rgba(91, 192, 235, 0.45);
	}

	@keyframes nav-shimmer {
		0% {
			transform: translateX(-80%);
		}
		100% {
			transform: translateX(120%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.parabola-menu a:hover::before,
		.parabola-menu a:focus-visible::before {
			animation: none;
			transform: translateX(0);
			opacity: 0.35;
		}
	}

	@media (max-width: 720px) {
		.nav-shell {
			grid-template-columns: 1fr auto;
			grid-template-rows: auto auto;
			row-gap: 0.75rem;
		}

		.social-bar {
			grid-column: 1 / 2;
			justify-content: flex-start;
		}

		.brand {
			grid-column: 1 / -1;
			justify-self: start;
		}

		.menu-shell {
			grid-column: 2 / 3;
		}
	}

	@media (max-width: 520px) {
		.parabola-menu a {
			font-size: 1.06rem;
		}
	}
</style>

<script>
	const header = document.getElementById('site-header');
	const toggle = document.getElementById('menu-toggle');
	const parabola = document.getElementById('parabola-menu');
	const menuShell = document.getElementById('menu-shell');
	const copyBtn = document.getElementById('email-copy');
	const tooltip = document.getElementById('email-tooltip');
	const emailAddress = copyBtn?.dataset.email ?? '';
	let closeTimer: number | undefined;
	let lastScrollY = window.scrollY;
	let ticking = false;

	const openMenu = () => {
		header?.classList.add('is-open');
		parabola?.setAttribute('aria-hidden', 'false');
		toggle?.setAttribute('aria-expanded', 'true');
	};

	const closeMenu = () => {
		header?.classList.remove('is-open');
		parabola?.setAttribute('aria-hidden', 'true');
		toggle?.setAttribute('aria-expanded', 'false');
	};

	const cancelCloseTimer = () => {
		if (closeTimer) {
			clearTimeout(closeTimer);
			closeTimer = undefined;
		}
	};

	const setCondensed = (condensed: boolean) => {
		if (!header) return;
		if (condensed) {
			header.classList.add('is-condensed');
			closeMenu();
		} else {
			header.classList.remove('is-condensed');
		}
	};

	const handleScroll = () => {
		const currentY = window.scrollY;
		const delta = currentY - lastScrollY;
		if (Math.abs(delta) < 8) return;
		if (currentY <= 0) {
			setCondensed(false);
			lastScrollY = currentY;
			return;
		}
		if (delta > 0) {
			setCondensed(true);
		} else {
			setCondensed(false);
		}
		lastScrollY = currentY;
	};

	window.addEventListener('scroll', () => {
		if (!ticking) {
			window.requestAnimationFrame(() => {
				handleScroll();
				ticking = false;
			});
			ticking = true;
		}
	}, { passive: true });

	handleScroll();

	menuShell?.addEventListener('mouseenter', () => {
		cancelCloseTimer();
		openMenu();
	});

	menuShell?.addEventListener('mouseleave', () => {
		closeTimer = window.setTimeout(closeMenu, 140);
	});

	// No click or focus handlers for menu open; hover-only behavior keeps the icon neutral on click.

	menuShell?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			closeMenu();
		}
	});

	parabola?.addEventListener('mouseenter', cancelCloseTimer);
	parabola?.addEventListener('mouseleave', () => {
		closeTimer = window.setTimeout(closeMenu, 140);
	});

	const copyEmail = async () => {
		try {
			await navigator.clipboard.writeText(emailAddress);
		} catch (error) {
			console.error('Could not copy email', error);
		}
		if (tooltip) {
			tooltip.classList.add('show');
			setTimeout(() => {
				tooltip.classList.remove('show');
			}, 1400);
		}
	};

	copyBtn?.addEventListener('click', copyEmail);
</script>
