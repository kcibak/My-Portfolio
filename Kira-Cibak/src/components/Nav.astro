---
import ThemeToggle from './islands/ThemeToggle.tsx';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/skills', label: 'Skills' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/resume', label: 'Resume' },
	{ href: '/contact', label: 'Contact' }
];

const socials = [
	{ href: 'https://www.linkedin.com/in/kira-cibak/', label: 'LinkedIn', icon: 'linkedin' },
	{ href: 'https://github.com/kcibak', label: 'GitHub', icon: 'github' }
];

const emailAddress = 'cibakkn@gmail.com';
---

<header class="dome-header" id="site-header">
	<ThemeToggle client:load />
	<div class="nav-shell">
		<div class="social-bar">
			{socials.map((link) => (
				<a class="social-icon" href={link.href} aria-label={link.label} target="_blank" rel="noreferrer">
					{link.icon === 'linkedin' ? (
						<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
							<path d="M6.94 9.75V18" />
							<circle cx="6.94" cy="6.94" r="1.44" />
							<path d="M12 18v-5.21c0-1.53 1.24-2.77 2.77-2.77s2.77 1.24 2.77 2.77V18" />
						</svg>
					) : (
						<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
							<path d="M9 19c-4 1-4-2-6-2m12 4v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7a5.44 5.44 0 0 0-1.5-3.75 5.07 5.07 0 0 0-.09-3.77S18.16-1 15 1.38a13.38 13.38 0 0 0-6 0C5-1 3.09 1 3.09 1a5.07 5.07 0 0 0-.09 3.77A5.44 5.44 0 0 0 1.5 8.5c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 7 18.13V22" />
						</svg>
					)}
				</a>
			))}
			<button
				class="social-icon copy"
				id="email-copy"
				type="button"
				aria-label={`Copy ${emailAddress}`}
				data-email={emailAddress}
			>
				<span class="sr-only">Copy email address</span>
				<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
					<path d="m3 8 7.89 4.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/>
				</svg>
				<span class="copy-tooltip" id="email-tooltip" role="status" aria-live="polite">Email copied!</span>
			</button>
		</div>
		<a href="/" class="brand">Kira Cibak</a>
		<div class="menu-shell" id="menu-shell">
			<button class="menu-trigger" id="menu-toggle" type="button" aria-expanded="false" aria-controls="parabola-menu">
				<span class="menu-label">Menu</span>
				<span class="menu-icon" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
			</button>
		</div>
	</div>
	<nav id="parabola-menu" class="parabola-menu" aria-label="Primary navigation" aria-hidden="true">
		{links.map((link, index) => (
			<a href={link.href} style={`--arc-offset:${Math.abs(3 - index)};`}>{link.label}</a>
		))}
		<a class="menu-cta" href="/contact">Let’s talk</a>
	</nav>
</header>

<style>
	:global(.dome-header) {
		position: sticky;
		top: 0;
		z-index: 70;
		backdrop-filter: blur(18px);
		background: var(--color-nav);
		border-bottom: 1px solid var(--color-border);
		height: 96px;
		box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
		transition: height 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}

	:global(.dome-header.is-open) {
		box-shadow: 0 22px 48px rgba(15, 23, 42, 0.15);
	}

	:global(:root[data-theme='dark'] .dome-header) {
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root[data-theme='auto'] .dome-header) {
			box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
		}
	}

	:global(.theme-toggle) {
		position: absolute;
		right: 1.2rem;
		top: 50%;
		transform: translateY(-50%);
		height: 44px;
		width: 44px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 14px;
		border: 1px solid var(--color-border);
		background: var(--color-card);
		color: var(--color-ink);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
		cursor: pointer;
		z-index: 75;
	}


	.nav-shell {
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 1.4rem 1.2rem 1rem;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		transition: padding 0.2s ease, grid-template-columns 0.2s ease;
	}

	.social-bar {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.55rem;
	}

	.social-icon {
		height: 44px;
		width: 44px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 14px;
		border: 1px solid var(--color-border);
		background: var(--color-card);
		color: var(--color-ink);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
		cursor: pointer;
	}

	.social-icon:hover,
	.social-icon:focus-visible {
		transform: translateY(-1px);
		box-shadow: 0 14px 34px rgba(0, 0, 0, 0.12);
		border-color: var(--color-accent);
		outline: none;
	}

	.copy {
		position: relative;
	}

	.copy-tooltip {
		position: absolute;
		left: 50%;
		bottom: -2.75rem;
		transform: translateX(-50%) translateY(8px);
		padding: 0.4rem 0.7rem;
		border-radius: 12px;
		background: var(--color-ink);
		color: var(--color-bg);
		font-size: 0.8rem;
		font-weight: 700;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease, transform 0.2s ease;
		white-space: nowrap;
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
	}

	.copy-tooltip.show {
		opacity: 1;
		transform: translateX(-50%) translateY(0);
	}

	.brand {
		justify-self: center;
		font-weight: 800;
		font-size: clamp(1.5rem, 2.2vw, 2.35rem);
		letter-spacing: -0.03em;
		color: var(--color-ink);
		text-decoration: none;
		transition: transform 0.2s ease, font-size 0.2s ease;
	}

	:global(.dome-header.is-condensed) {
		height: 64px;
	}

	:global(.dome-header.is-condensed) .nav-shell {
		grid-template-columns: 1fr;
		padding: 0.7rem 1.2rem;
	}

	:global(.dome-header.is-condensed) .brand {
		justify-self: center;
		transform: translateY(-1px);
		font-size: clamp(1.3rem, 2vw, 2rem);
	}

	:global(.dome-header.is-condensed) .social-bar,
	:global(.dome-header.is-condensed) .menu-shell,
	:global(.dome-header.is-condensed) .parabola-menu,
	:global(.dome-header.is-condensed) .theme-toggle {
		opacity: 0;
		pointer-events: none;
		transform: translateY(-6px);
		transition: opacity 0.16s ease, transform 0.16s ease;
	}

	:global(.dome-header.is-condensed) .social-bar,
	:global(.dome-header.is-condensed) .menu-shell,
	:global(.dome-header.is-condensed) .theme-toggle {
		display: none;
	}

	.menu-shell {
		justify-self: end;
		display: inline-flex;
		align-items: center;
	}

	.menu-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 0.9rem;
		border-radius: 14px;
		border: 1px solid var(--color-border);
		background: var(--color-card);
		font-weight: 700;
		color: var(--color-ink);
		cursor: pointer;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	.menu-trigger:hover,
	.menu-trigger:focus-visible {
		transform: translateY(-1px);
		box-shadow: 0 14px 34px rgba(0, 0, 0, 0.12);
		border-color: var(--color-accent);
		outline: none;
	}

	.menu-label {
		font-size: 0.95rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.menu-icon {
		display: inline-flex;
		flex-direction: column;
		gap: 3px;
	}

	.menu-icon span {
		display: block;
		width: 18px;
		height: 2px;
		background: currentColor;
		border-radius: 6px;
	}

	.dome-header {
		position: sticky;
	}

	.parabola-menu {
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		transform: translateY(0) scale(0.98);
		width: 100%;
		height: clamp(84px, 9vw, 120px);
		opacity: 0;
		pointer-events: none;
		transition: transform 0.28s ease, opacity 0.28s ease;
		z-index: 60;
		clip-path: ellipse(100% 100% at 50% 0%);
		background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(56, 189, 248, 0.12));
		border: 1px solid var(--color-border);
		box-shadow: 0 24px 46px rgba(15, 23, 42, 0.14);
		backdrop-filter: blur(14px);
		display: flex;
		align-items: flex-end;
		justify-content: space-evenly;
		gap: clamp(0.7rem, 2vw, 2rem);
		padding: 0.6rem 2.2rem 0.9rem;
		flex-wrap: nowrap;
		overflow-x: auto;
	}

	:global(.dome-header.is-condensed) .parabola-menu {
		display: none;
	}

	.menu-shell:hover + .parabola-menu,
	.menu-shell:focus-within + .parabola-menu,
	.dome-header.is-open .parabola-menu {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0) scale(1);
	}

	.parabola-menu a {
		font-weight: 700;
		font-size: 1.12rem;
		padding: 0.6rem 1rem;
		border-radius: 12px;
		color: var(--color-ink);
		transition: background 0.2s ease, transform 0.2s ease;
		transform: translateY(calc(var(--arc-offset, 0) * -6px));
		white-space: nowrap;
		letter-spacing: 0.02em;
	}

	.parabola-menu a:hover,
	.parabola-menu a:focus-visible {
		background: rgba(37, 99, 235, 0.08);
		transform: translateY(calc(var(--arc-offset, 0) * -6px - 2px));
		outline: none;
	}

	.menu-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		white-space: nowrap;
		font-weight: 700;
		font-size: 1.12rem;
		padding: 0.6rem 1rem;
		border-radius: 12px;
		border: 1px solid var(--color-border);
		background: var(--color-nav);
		color: var(--color-ink);
		transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
		transform: translateY(calc(var(--arc-offset, 0) * -6px));
	}

	.menu-cta:hover,
	.menu-cta:focus-visible {
		background: rgba(37, 99, 235, 0.08);
		border-color: var(--color-accent);
		transform: translateY(calc(var(--arc-offset, 0) * -6px - 2px));
		outline: none;
	}

	@media (max-width: 720px) {
		.nav-shell {
			grid-template-columns: 1fr auto;
			grid-template-rows: auto auto;
			row-gap: 0.75rem;
		}

		.social-bar {
			grid-column: 1 / 2;
			justify-content: flex-start;
		}

		.brand {
			grid-column: 1 / -1;
			justify-self: start;
		}

		.menu-shell {
			grid-column: 2 / 3;
		}
	}

	@media (max-width: 520px) {
		.parabola-menu a {
			font-size: 1.06rem;
		}
	}
</style>

<script>
	const header = document.getElementById('site-header');
	const toggle = document.getElementById('menu-toggle');
	const parabola = document.getElementById('parabola-menu');
	const menuShell = document.getElementById('menu-shell');
	const copyBtn = document.getElementById('email-copy');
	const tooltip = document.getElementById('email-tooltip');
	const emailAddress = copyBtn?.dataset.email ?? '';
	let closeTimer: number | undefined;
	let lastScrollY = window.scrollY;
	let ticking = false;

	const openMenu = () => {
		header?.classList.add('is-open');
		parabola?.setAttribute('aria-hidden', 'false');
		toggle?.setAttribute('aria-expanded', 'true');
	};

	const closeMenu = () => {
		header?.classList.remove('is-open');
		parabola?.setAttribute('aria-hidden', 'true');
		toggle?.setAttribute('aria-expanded', 'false');
	};

	const cancelCloseTimer = () => {
		if (closeTimer) {
			clearTimeout(closeTimer);
			closeTimer = undefined;
		}
	};

	const setCondensed = (condensed: boolean) => {
		if (!header) return;
		if (condensed) {
			header.classList.add('is-condensed');
			closeMenu();
		} else {
			header.classList.remove('is-condensed');
		}
	};

	const handleScroll = () => {
		const currentY = window.scrollY;
		const delta = currentY - lastScrollY;
		if (Math.abs(delta) < 8) return;
		if (currentY <= 0) {
			setCondensed(false);
			lastScrollY = currentY;
			return;
		}
		if (delta > 0) {
			setCondensed(true);
		} else {
			setCondensed(false);
		}
		lastScrollY = currentY;
	};

	window.addEventListener('scroll', () => {
		if (!ticking) {
			window.requestAnimationFrame(() => {
				handleScroll();
				ticking = false;
			});
			ticking = true;
		}
	}, { passive: true });

	menuShell?.addEventListener('mouseenter', () => {
		cancelCloseTimer();
		openMenu();
	});

	menuShell?.addEventListener('mouseleave', () => {
		closeTimer = window.setTimeout(closeMenu, 140);
	});

	menuShell?.addEventListener('focusin', openMenu);
	menuShell?.addEventListener('focusout', (event) => {
		const nextTarget = event.relatedTarget;
		if (nextTarget && menuShell.contains(nextTarget as Node)) return;
		closeMenu();
	});

	toggle?.addEventListener('click', () => {
		const isOpen = header?.classList.contains('is-open');
		if (isOpen) {
			closeMenu();
		} else {
			openMenu();
		}
	});

	menuShell?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			closeMenu();
		}
	});

	const copyEmail = async () => {
		try {
			await navigator.clipboard.writeText(emailAddress);
		} catch (error) {
			console.error('Could not copy email', error);
		}
		if (tooltip) {
			tooltip.classList.add('show');
			setTimeout(() => {
				tooltip.classList.remove('show');
			}, 1400);
		}
	};

	copyBtn?.addEventListener('click', copyEmail);
</script>
