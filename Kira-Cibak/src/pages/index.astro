---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import ProjectCard from '../components/project/ProjectCard.astro';
import HomeHero from '../components/pages/HomeHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Tag from '../components/ui/Tag.astro';
import Button from '../components/ui/Button.astro';
import { projects } from '../data/projects';

export const prerender = true;

const whatIDo = [
	{
		statement: 'I deliver full-stack SaaS features from architecture to production with stable release velocity.'
	},
	{
		statement: 'I build React + TypeScript systems that stay maintainable as products and teams scale.'
	},
	{
		statement: 'I design APIs and databases together so data flows cleanly from UI to deployment.'
	}
];

const impactHighlights = [
	{
		signal: 'Reduced Product Complexity',
		context: 'Led Martinrea\'s SaaS replatform, cutting system complexity by ~25% and improving release reliability.',
		tags: ['Replatform', 'Architecture']
	},
	{
		signal: 'Delivered at Client Scale',
		context: 'Shipped 5 client platforms and built Stripe revenue systems from integration through production operations.',
		tags: ['Delivery', 'Payments']
	},
	{
		signal: 'Performance with Cloud Rigor',
		context: 'Improved performance with Redis caching and applied Azure-certified practices for secure, cost-aware decisions.',
		tags: ['Performance', 'Azure']
	}
];

const featuredProjects = projects.slice(0, 3);
---

<MainLayout title="Kira Cibak | Front-end Developer" description="Building fast, responsive web experiences with Astro and modern tooling.">
	<Section class="section" padding="default">
		<Container size="narrow">
			<HomeHero />
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<SectionHeading
				title="What I Do"
				subtitle="I partner with product teams to build clear, scalable front-end systems that ship with confidence."
			/>
			<div class="grid-three">
				{whatIDo.map((item) => (
					<Card as="article" padding="compact">
						<p class="heading-tight">{item.statement}</p>
					</Card>
				))}
			</div>
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<SectionHeading
				title="Impact Highlights"
				subtitle="A quick read on the outcomes I focus on in delivery work."
			/>
			<div class="grid-three">
				{impactHighlights.map((highlight) => (
					<Card as="article" padding="compact" class="stack-card">
						<p class="heading-tight"><strong>{highlight.signal}</strong></p>
						<p class="muted-copy">{highlight.context}</p>
						<div class="tag-row-tight">
							{highlight.tags.map((tag) => (
								<Tag>{tag}</Tag>
							))}
						</div>
					</Card>
				))}
			</div>
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<SectionHeading
				title="Projects Preview"
				subtitle="A compact preview of selected builds. Visit the full projects page for complete case studies."
			/>
			<div class="grid-two">
				{featuredProjects.map((project) => (
					<ProjectCard
						title={project.title}
						description={project.description}
						tags={project.tags}
						image={project.image}
						link={project.link}
						linkLabel={project.linkLabel}
					/>
				))}
			</div>
			<div class="action-row">
				<Button href="/projects">View All Projects</Button>
			</div>
		</Container>
	</Section>
</MainLayout>
