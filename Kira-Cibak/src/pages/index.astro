---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import HomeHero from '../components/pages/HomeHero.astro';
import HomeCta from '../components/pages/HomeCta.astro';

export const prerender = true;

const dotColorMap: Record<string, string> = {
	blue: 'var(--color-accent)',
	warm: 'var(--color-accent-warm)',
	teal: 'var(--color-accent-2)',
};

const howIWork = [
	{
		dot: 'blue',
		heading: 'Build new products',
		statement: 'Architecture, frontend, APIs, and deployment.',
		shortStatement: 'Architecture, frontend, APIs, deployment.'
	},
	{
		dot: 'warm',
		heading: 'Modern web development',
		statement: 'Clean React + TypeScript applications built with intent to scale.',
		shortStatement: 'Clean React + TypeScript, built to scale.'
	},
	{
		dot: 'teal',
		heading: 'Platform integrations',
		statement: 'Payments, memberships, APIs, and cloud deployments.',
		shortStatement: 'Payments, memberships, APIs, cloud.'
	}
];
---

<MainLayout title="Kira Cibak | Front-end Developer" description="Building fast, responsive web experiences with Astro and modern tooling.">
	<Section class="section section-hero">
		<Container>
			<HomeHero />
		</Container>
	</Section>

	<Section class="section section-bottom" padding="compact">
		<Container>
			<div class="landing-bottom">
				<div class="landing-work">
					<div class="work-heading">
						<span class="work-eyebrow">Things I Do</span>
					</div>
					<div class="work-list">
						{howIWork.map((item, i) => (
							<article class="work-pod" style={`--item-accent: ${dotColorMap[item.dot]}`}>
								<div class="work-node">
									<p class="work-item-heading">{item.heading}</p>
									<p class="work-item-body">{item.shortStatement}</p>
								</div>
							</article>
						))}
					</div>
				</div>

				<div class="landing-cta">
					<HomeCta />
				</div>
			</div>
	</Container>
	</Section>
</MainLayout>

<style>
	/* ── Tighten bottom section for above-fold fit ── */
	:global(.section-hero.layout-section) {
		padding-bottom: clamp(0.18rem, 0.5vw, 0.4rem) !important;
	}

	:global(.section-bottom.layout-section) {
		padding-top: clamp(0.25rem, 0.6vw, 0.55rem) !important;
		padding-bottom: 0.65rem !important;
	}

	/* ── Bottom split row ── */
	.landing-bottom {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		column-gap: clamp(1.5rem, 2.2vw, 2.25rem);
		align-items: stretch;
		min-height: 0; /* prevent grid blowout */
	}

	/* ── Left column: How I Work ── */
	.landing-work {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-start;
		gap: 0.55rem;
	}

	.work-heading {
		width: 100%;
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.work-heading::after {
		content: '';
		height: 1px;
		flex: 1;
		background: color-mix(in srgb, var(--color-accent) 28%, transparent);
	}

	.work-eyebrow {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 1.08rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-accent);
		white-space: nowrap;
	}

	.work-list {
		display: grid;
		grid-template-columns: repeat(3, max-content);
		justify-content: start;
		column-gap: clamp(0.55rem, 1.2vw, 0.9rem);
		row-gap: 0.34rem;
		padding-right: 0;
	}

	.work-pod {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.28rem;
	}

	.work-pod:nth-child(1) {
		grid-column: 1;
	}

	.work-pod:nth-child(2) {
		grid-column: 2;
	}

	.work-pod:nth-child(3) {
		grid-column: 3;
	}

	.work-node {
		width: clamp(152px, 11.4vw, 178px);
		aspect-ratio: 1 / 1;
		border-radius: 50%;
		border: 1px solid color-mix(in srgb, var(--color-accent) 24%, var(--color-border));
		background: radial-gradient(
			circle at 34% 20%,
			color-mix(in srgb, var(--color-accent-2) 34%, var(--color-card)) 0%,
			color-mix(in srgb, var(--color-accent) 26%, var(--color-card)) 50%,
			color-mix(in srgb, var(--color-accent-warm) 18%, var(--color-card)) 100%
		);
		box-shadow: 0 2px 10px -7px color-mix(in srgb, var(--color-accent) 28%, transparent);
		padding: 0.52rem 0.58rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		gap: 0.22rem;
	}

	.work-pod:nth-child(2) .work-node {
		background: radial-gradient(
			circle at 32% 18%,
			color-mix(in srgb, var(--color-accent-2) 38%, var(--color-card)) 0%,
			color-mix(in srgb, var(--color-accent) 28%, var(--color-card)) 52%,
			color-mix(in srgb, var(--color-accent-warm) 20%, var(--color-card)) 100%
		);
	}

	.work-pod:nth-child(3) .work-node {
		background: radial-gradient(
			circle at 35% 22%,
			color-mix(in srgb, var(--color-accent-2) 30%, var(--color-card)) 0%,
			color-mix(in srgb, var(--color-accent) 24%, var(--color-card)) 48%,
			color-mix(in srgb, var(--color-accent-warm) 16%, var(--color-card)) 100%
		);
	}

	:global(html.dark) .work-node {
		background: radial-gradient(
			circle at 34% 20%,
			color-mix(in srgb, var(--color-accent-2) 28%, var(--color-card)) 0%,
			color-mix(in srgb, var(--color-accent) 22%, var(--color-card)) 52%,
			color-mix(in srgb, var(--color-accent-warm) 14%, var(--color-card)) 100%
		);
	}

	:global(html.dark) .work-pod:nth-child(2) .work-node {
		background: radial-gradient(
			circle at 32% 18%,
			color-mix(in srgb, var(--color-accent-2) 32%, var(--color-card)) 0%,
			color-mix(in srgb, var(--color-accent) 24%, var(--color-card)) 50%,
			color-mix(in srgb, var(--color-accent-warm) 16%, var(--color-card)) 100%
		);
	}

	:global(html.dark) .work-pod:nth-child(3) .work-node {
		background: radial-gradient(
			circle at 35% 22%,
			color-mix(in srgb, var(--color-accent-2) 26%, var(--color-card)) 0%,
			color-mix(in srgb, var(--color-accent) 20%, var(--color-card)) 48%,
			color-mix(in srgb, var(--color-accent-warm) 12%, var(--color-card)) 100%
		);
	}

	.work-item-heading {
		margin: 0;
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.2;
		color: var(--color-ink);
		max-width: 9ch;
		text-wrap: balance;
	}

	.work-item-body {
		font-size: var(--type-size-small);
		color: var(--color-muted);
		line-height: 1.32;
		margin: 0;
		max-width: 15ch;
		text-align: center;
		text-wrap: pretty;
	}

	/* ── Right column: CTA ── */
	.landing-cta {
		display: flex;
		align-items: stretch;
		padding-top: 0;
		height: 100%;
	}

	:global(.landing-cta .cta-panel) {
		height: 100%;
		justify-content: space-between;
		padding-top: clamp(0.7rem, 0.9vw, 0.95rem);
		padding-bottom: clamp(0.7rem, 0.9vw, 0.95rem);
	}

	@media (max-width: 1024px) {
		.landing-bottom {
			grid-template-columns: 1fr;
			row-gap: 0.9rem;
		}

		.landing-work {
			gap: 0.56rem;
		}

		.work-heading {
			width: 100%;
			margin: 0;
		}

		.work-list {
			display: flex;
			flex-direction: column;
			gap: 0.8rem;
			padding-right: 0;
		}

		.work-pod {
			align-items: flex-start;
		}

		.work-node {
			width: 100%;
			max-width: none;
			aspect-ratio: auto;
			min-height: 0;
			border-radius: calc(var(--radius) * 1.15);
			padding: 0.62rem 0.82rem;
			align-items: flex-start;
			text-align: left;
			box-shadow: none;
			gap: 0.16rem;
		}

		.work-item-heading {
			max-width: none;
			text-wrap: pretty;
		}

		.work-item-body {
			text-align: left;
			max-width: 37ch;
		}

		.landing-cta {
			padding-top: 0;
			height: auto;
		}

		:global(.landing-cta .cta-panel) {
			height: auto;
			justify-content: flex-start;
		}
	}

	@media (max-height: 900px) and (min-width: 1025px) {
		:global(.section-bottom.layout-section) {
			padding-bottom: 0.45rem !important;
		}

		.work-node {
			width: clamp(142px, 10.5vw, 168px);
		}
	}
</style>
