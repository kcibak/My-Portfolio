---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import ProjectCard from '../components/project/ProjectCard.astro';
import HomeHero from '../components/pages/HomeHero.astro';
import HomeCta from '../components/pages/HomeCta.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Tag from '../components/ui/Tag.astro';
import Button from '../components/ui/Button.astro';
import { projects } from '../data/projects';

export const prerender = true;

const howIWork = [
	{
		dot: 'blue',
		heading: 'Architect first',
		statement: 'I start with goals and constraints, then design lean data flows from UI through API to deployment.'
	},
	{
		dot: 'warm',
		heading: 'Build to scale',
		statement: 'I write React + TypeScript systems with clear component boundaries that stay maintainable as teams grow.'
	},
	{
		dot: 'teal',
		heading: 'Measure & iterate',
		statement: 'I validate with performance budgets, analytics, and real user feedback — then ship improvements fast.'
	}
];

const featuredProjects = projects.filter(p => p.featured).slice(0, 3);
---

<MainLayout title="Kira Cibak | Front-end Developer" description="Building fast, responsive web experiences with Astro and modern tooling.">
	<Section class="section" padding="default">
		<Container>
			<HomeHero />
		</Container>
	</Section>

	<Section class="section" reveal={true}>
		<Container>
			<div class="two-col-feature">
				<div class="two-col-feature-text">
					<SectionHeading
						title="How I Work"
						subtitle="I partner with product teams to build clear, scalable front-end systems that ship with confidence."
					/>
				</div>
				<div class="two-col-feature-cards">
					{howIWork.map((item) => (
						<Card as="article" padding="compact">
							<div style="display: flex; align-items: center; gap: 0.5rem;">
								<span class={`card-dot card-dot-${item.dot}`}></span>
								<p class="heading-tight"><strong>{item.heading}</strong></p>
							</div>
							<p class="muted-copy" style="margin: 0;">{item.statement}</p>
						</Card>
					))}
				</div>
			</div>
		</Container>
	</Section>



	<Section class="section" reveal={true}>
		<Container>
			<HomeCta />
		</Container>
	</Section>
</MainLayout>
