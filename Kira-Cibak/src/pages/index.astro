---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import HomeHero from '../components/pages/HomeHero.astro';

export const prerender = true;

const howIWork = [
	{
		title: 'Secure Systems',
		copy: 'I build with Zero Trust principles and keep security and compliance in mind.',
		shape: 'triangle'
	},
	{
		title: 'Web + Product',
		copy: 'I take features + requirements from concept to working product.',
		shape: 'diamond'
	},
	{
		title: 'Always Adapting',
		copy: 'I pick up new tools fast and stay current on where things are heading.',
		shape: 'circle'
	}
];
---

<MainLayout title="Kira Cibak" htmlClass="home-page-root" bodyClass="home-page" mainClass="home-main">
	<Section class="section section-hero">
		<Container>
			<HomeHero />
		</Container>
	</Section>

	<Section class="section section-bottom" padding="compact">
		<section class="shape-row" aria-label="Core strengths" data-reveal>
			{howIWork.map((item, index) => (
				<article id={`strength-${index + 1}`} class:list={['shape-item', `shape-item--${item.shape}`]}>
					<div class:list={['shape-figure', `shape-figure--${item.shape}`]}>
						<div class="shape-figure-inner">
							<h3>{item.title}</h3>
							<p>{item.copy}</p>
						</div>
					</div>
				</article>
			))}
		</section>
		<nav class="shape-progress" aria-label="Core strengths slides">
			{howIWork.map((item, index) => (
				<a href={`#strength-${index + 1}`} aria-label={`View ${item.title}`}></a>
			))}
		</nav>
	</Section>
</MainLayout>

<script>
	const shapeRow = document.querySelector<HTMLElement>('.shape-row');
	const shapeSlides = Array.from(document.querySelectorAll<HTMLElement>('.shape-item'));
	const shapeDots = Array.from(document.querySelectorAll<HTMLAnchorElement>('.shape-progress a'));
	const mobileShapeQuery = window.matchMedia('(max-width: 640px)');
	let shapeScrollFrame = 0;

	const setActiveShapeSlide = (activeIndex: number) => {
		shapeDots.forEach((dot, index) => {
			const isActive = index === activeIndex;
			dot.classList.toggle('is-active', isActive);
			if (isActive) {
				dot.setAttribute('aria-current', 'true');
			} else {
				dot.removeAttribute('aria-current');
			}
		});
	};

	const getCurrentShapeSlide = () => {
		if (!shapeRow || !shapeRow.clientWidth) return 0;

		return Math.min(
			shapeSlides.length - 1,
			Math.max(0, Math.round(shapeRow.scrollLeft / shapeRow.clientWidth))
		);
	};

	const updateShapeProgress = () => {
		shapeScrollFrame = 0;
		setActiveShapeSlide(getCurrentShapeSlide());
	};

	if (shapeRow && shapeSlides.length && shapeDots.length) {
		setActiveShapeSlide(getCurrentShapeSlide());

		shapeRow.addEventListener(
			'scroll',
			() => {
				if (!mobileShapeQuery.matches || shapeScrollFrame) return;
				shapeScrollFrame = window.requestAnimationFrame(updateShapeProgress);
			},
			{ passive: true }
		);

		shapeDots.forEach((dot, index) => {
			dot.addEventListener('click', (event) => {
				if (!mobileShapeQuery.matches) return;

				event.preventDefault();
				shapeSlides[index]?.scrollIntoView({
					behavior: 'smooth',
					block: 'nearest',
					inline: 'center'
				});
				setActiveShapeSlide(index);
			});
		});

		mobileShapeQuery.addEventListener('change', updateShapeProgress);
	}
</script>

<style>
	:global(.home-main) {
		min-height: calc(100svh - 96px);
		padding-bottom: 1.35rem;
		display: flex;
		flex-direction: column;
	}

	:global(.section-hero.layout-section) {
		padding-bottom: clamp(0.12rem, 0.4vw, 0.35rem) !important;
	}

	:global(.section-bottom.layout-section) {
		padding-top: clamp(0.12rem, 0.5vw, 0.4rem) !important;
		padding-bottom: clamp(1.25rem, 3vh, 2.15rem) !important;
	}

	.shape-row {
		--shape-size: clamp(11.85rem, 13.8vw, 13.85rem);
		--shape-triangle-start: color-mix(in srgb, rgb(156 230 246) 44%, var(--color-card));
		--shape-triangle-end: color-mix(in srgb, rgb(75 190 218) 18%, var(--color-card));
		--shape-triangle-border: color-mix(in srgb, rgb(75 190 218) 17%, var(--color-border));
		--shape-diamond-start: color-mix(in srgb, rgb(38 177 196) 18%, var(--color-card));
		--shape-diamond-end: color-mix(in srgb, rgb(88 214 220) 18%, var(--color-card));
		--shape-diamond-border: color-mix(in srgb, rgb(38 177 196) 16%, var(--color-border));
		--shape-circle-start: color-mix(in srgb, rgb(88 196 234) 40%, var(--color-card));
		--shape-circle-end: color-mix(in srgb, rgb(4 96 168) 28%, var(--color-card));
		--shape-circle-border: color-mix(in srgb, rgb(4 96 168) 26%, var(--color-border));
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: end;
		justify-items: center;
		width: 100%;
		gap: clamp(1rem, 3vw, 3rem);
	}

	.shape-progress {
		display: none;
	}

	.shape-item {
		display: flex;
		justify-content: center;
		align-items: end;
		min-height: calc(var(--shape-size) + 0.35rem);
	}

	.shape-item--triangle {
		min-height: calc((var(--shape-size) * 1.18 * 0.8660254) + 0.35rem);
	}

	.shape-figure {
		--shape-content-width: 15.5ch;
		--shape-content-y: 0rem;
		--shape-padding-inline: 1rem;
		--shape-title-width: 8ch;
		--shape-copy-width: 15.5ch;
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		max-width: var(--shape-size);
		color: var(--color-ink);
	}

	.shape-figure-inner {
		box-sizing: border-box;
		display: grid;
		place-items: center;
		gap: 0.28rem;
		width: min(var(--shape-content-width), calc(100% - (var(--shape-padding-inline) * 2)));
		text-align: center;
		transform: translateY(var(--shape-content-y));
	}

	.shape-figure h3 {
		margin: 0;
		font-size: clamp(1rem, 1.05vw, 1.14rem);
		line-height: 1.06;
		max-width: var(--shape-title-width);
		text-wrap: balance;
	}

	.shape-figure p {
		margin: 0;
		font-size: clamp(0.78rem, 0.82vw, 0.88rem);
		line-height: 1.28;
		color: color-mix(in srgb, var(--color-ink) 72%, white);
		max-width: var(--shape-copy-width);
		text-wrap: pretty;
	}

	.shape-figure--triangle {
		--triangle-size: calc(var(--shape-size) * 1.18);
		--shape-content-width: 13.2ch;
		--shape-content-y: 2.12rem;
		--shape-padding-inline: 2.6rem;
		--shape-title-width: 7.4ch;
		--shape-copy-width: 13.2ch;
		position: relative;
		width: var(--triangle-size);
		max-width: var(--triangle-size);
		aspect-ratio: 1 / 0.8660254;
		clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
		background: linear-gradient(
			180deg,
			var(--shape-triangle-start) 0%,
			var(--shape-triangle-end) 100%
		);
	}

	.shape-figure--triangle::before {
		content: '';
		position: absolute;
		inset: -1px;
		clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
		background: var(--shape-triangle-border);
		z-index: -1;
	}

	.shape-figure--diamond {
		--shape-content-width: 18ch;
		--shape-content-y: -0.08rem;
		--shape-padding-inline: 0.45rem;
		--shape-title-width: 10ch;
		--shape-copy-width: 18ch;
		width: var(--shape-size);
		height: var(--shape-size);
		background: linear-gradient(
			160deg,
			var(--shape-diamond-start) 0%,
			var(--shape-diamond-end) 100%
		);
		border: 1px solid var(--shape-diamond-border);
		border-radius: calc(var(--radius) * 0.9);
	}

	.shape-figure--circle {
		--shape-content-width: 16.5ch;
		--shape-content-y: -0.04rem;
		--shape-padding-inline: 0.75rem;
		--shape-title-width: 9ch;
		--shape-copy-width: 16.5ch;
		width: var(--shape-size);
		height: var(--shape-size);
		border-radius: 50%;
		background: radial-gradient(
			circle at 30% 30%,
			var(--shape-circle-start) 0%,
			var(--shape-circle-end) 100%
		);
		border: 1px solid var(--shape-circle-border);
	}

	:global(html.dark) .shape-row {
		--shape-triangle-start: color-mix(in srgb, rgb(125 222 242) 32%, var(--color-card));
		--shape-triangle-end: color-mix(in srgb, rgb(45 169 202) 16%, var(--color-card));
		--shape-triangle-border: color-mix(in srgb, rgb(125 222 242) 24%, var(--color-border));
		--shape-diamond-start: color-mix(in srgb, rgb(36 160 184) 18%, var(--color-card));
		--shape-diamond-end: color-mix(in srgb, rgb(82 204 214) 14%, var(--color-card));
		--shape-diamond-border: color-mix(in srgb, rgb(82 204 214) 17%, var(--color-border));
		--shape-circle-start: color-mix(in srgb, rgb(82 188 228) 34%, var(--color-card));
		--shape-circle-end: color-mix(in srgb, rgb(5 88 158) 34%, var(--color-card));
		--shape-circle-border: color-mix(in srgb, rgb(82 188 228) 26%, var(--color-border));
	}

	@media (min-width: 1024px) {
		:global(html.home-page-root) {
			height: 100svh;
			overflow-y: hidden;
		}

		:global(body.home-page) {
			height: 100svh;
			overflow: hidden;
		}

		:global(body.home-page .home-main) {
			height: calc(100svh - 96px);
			min-height: 0;
			overflow: hidden;
			padding-top: clamp(3.85rem, 8vh, 5.2rem);
			padding-bottom: clamp(0.75rem, 1.8vh, 1.35rem);
		}

		:global(body.home-page .section-hero.layout-section) {
			padding-top: clamp(0.45rem, 1vh, 0.9rem) !important;
			padding-bottom: clamp(0.05rem, 0.28vw, 0.25rem) !important;
		}

		:global(body.home-page .section-bottom.layout-section) {
			padding-top: clamp(0.05rem, 0.28vw, 0.25rem) !important;
			padding-bottom: clamp(0.55rem, 1.3vh, 1.15rem) !important;
		}

		:global(body.home-page) .shape-row {
			--shape-size: clamp(10.6rem, 12.4vw, 13.1rem);
		}
	}

	@media (max-width: 1023px) {
		:global(.home-main) {
			min-height: auto;
		}
	}

	@media (max-width: 820px) {
		.shape-row {
			grid-template-columns: 1fr;
			justify-items: center;
			gap: 1.25rem;
		}

		.shape-item {
			min-height: auto;
			width: 100%;
		}
	}

	@media (max-width: 640px) {
		:global(.home-main) {
			padding-bottom: 0.55rem;
		}

		:global(.section-hero.layout-section) {
			padding-bottom: 0.08rem !important;
		}

		:global(.section-bottom.layout-section) {
			padding-top: 0.18rem !important;
			padding-bottom: 0.78rem !important;
		}

		.shape-row {
			--shape-size: min(68vw, 13rem);
			display: flex;
			grid-template-columns: none;
			align-items: center;
			gap: 0;
			overflow-x: auto;
			overscroll-behavior-x: contain;
			scroll-padding-inline: 0;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
			-webkit-overflow-scrolling: touch;
		}

		.shape-row::-webkit-scrollbar {
			display: none;
		}

		.shape-item {
			display: grid;
			place-items: center;
			flex: 0 0 100%;
			min-width: 100%;
			max-width: 100%;
			width: 100%;
			min-height: calc((var(--shape-size) * 1.18 * 0.8660254) + 0.35rem);
			overflow: hidden;
			scroll-snap-align: center;
			scroll-snap-stop: always;
		}

		.shape-item--triangle {
			min-height: calc((var(--shape-size) * 1.18 * 0.8660254) + 0.35rem);
		}

		.shape-figure {
			width: var(--shape-size);
			max-width: min(var(--shape-size), 100%);
		}

		.shape-figure h3 {
			font-size: clamp(1.1rem, 4.45vw, 1.25rem);
		}

		.shape-figure p {
			font-size: clamp(0.86rem, 3.65vw, 0.97rem);
		}

		.shape-figure--triangle {
			--shape-content-width: 15.4ch;
			--shape-content-y: 1.68rem;
			--shape-copy-width: 15.4ch;
		}

		.shape-figure--triangle p {
			font-size: clamp(0.8rem, 3.25vw, 0.88rem);
			line-height: 1.22;
		}

		.shape-figure--diamond {
			--shape-content-width: 18.5ch;
			--shape-copy-width: 18.5ch;
		}

		.shape-figure--circle {
			--shape-content-width: 17ch;
			--shape-copy-width: 17ch;
		}

		.shape-figure--triangle {
			--triangle-size: min(calc(var(--shape-size) * 1.18), calc(100vw - 2rem));
			width: var(--triangle-size);
			max-width: var(--triangle-size);
		}

		.shape-figure--diamond,
		.shape-figure--circle {
			width: var(--shape-size);
			height: var(--shape-size);
		}

		.shape-progress {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 0.5rem;
			padding-top: 0.5rem;
		}

		.shape-progress a {
			width: 0.56rem;
			height: 0.56rem;
			border-radius: 999px;
			background: color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
			border: 1px solid color-mix(in srgb, var(--color-accent) 46%, var(--color-border));
			box-shadow: 0 0 0 0.22rem color-mix(in srgb, var(--color-card) 74%, transparent);
			transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
		}

		.shape-progress a:hover,
		.shape-progress a:focus-visible,
		.shape-progress a.is-active {
			background: var(--color-accent);
			border-color: var(--color-accent);
			transform: scale(1.18);
		}

		.shape-progress a:focus-visible {
			outline: none;
		}
	}
</style>
