---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import ProjectCard from '../components/project/ProjectCard.astro';
import HomeHero from '../components/pages/HomeHero.astro';
import ServiceCards from '../components/pages/ServiceCards.astro';
import BlogPreviewCard from '../components/pages/BlogPreviewCard.astro';
import HomeCta from '../components/pages/HomeCta.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';

export const prerender = true;

const projects = [
	{
		title: 'Interactive Dev Portfolio',
		description: 'Motion-rich, accessible portfolio built with Astro and smooth islands.',
		tags: ['Astro', 'Islands', 'A11y'],
		image: '/favicon.svg',
		link: '/projects/sample-project',
		linkLabel: 'Read case study'
	},
	{
		title: 'Design System Starter',
		description: 'Token-first system with responsive components and documentation.',
		tags: ['Design Tokens', 'Storybook', 'Figma'],
		link: 'https://github.com',
		linkLabel: 'View GitHub'
	},
	{
		title: 'API-driven Dashboard',
		description: 'Real-time insights with charts, auth, and offline support.',
		tags: ['React', 'Charts', 'Auth'],
		image: '/favicon.svg',
		link: 'https://example.com',
		linkLabel: 'View Live'
	}
];

const posts = [
	{
		title: 'Improving Core Web Vitals',
		summary: 'Quick wins for LCP, CLS, and TBT using image optimization and code-splitting.'
	},
	{
		title: 'Building Design Systems Faster',
		summary: 'Practical workflow for tokens, documentation, and component libraries.'
	}
];
---

<MainLayout title="Kira Cibak | Front-end Developer" description="Building fast, responsive web experiences with Astro and modern tooling.">
	<Section class="section" padding="default">
		<Container size="narrow">
			<HomeHero />
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<SectionHeading
				title="Selected projects"
				subtitle="Replace the placeholders with real work. Each card links to a detailed case study."
			/>
			<div class="grid-two">
				{projects.map((project) => (
					<ProjectCard
						title={project.title}
						description={project.description}
						tags={project.tags}
						image={project.image}
						link={project.link}
						linkLabel={project.linkLabel}
					/>
				))}
			</div>
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<SectionHeading title="Services" subtitle="Mobile-first front-ends, design systems, and performance-focused builds." />
			<ServiceCards />
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<SectionHeading title="Latest posts" />
			<div class="grid-two">
				{posts.map((post) => (
					<BlogPreviewCard title={post.title} summary={post.summary} href="/blog" height="small" />
				))}
			</div>
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<HomeCta />
		</Container>
	</Section>
</MainLayout>
