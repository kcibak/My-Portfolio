---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import ProjectCard from '../../components/project/ProjectCard.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Tag from '../../components/ui/Tag.astro';
import { projects } from '../../data/projects';
import { isExternalHref, sanitizeHref } from '../../lib/url';

export const prerender = true;

const portfolioProjectTitle = 'This Portfolio Site';
const portfolioProject = projects.find((project) => project.title === portfolioProjectTitle);
const showcasedProjects = projects.filter((project) => project.title !== portfolioProjectTitle);
const portfolioProjectUrl = portfolioProject ? sanitizeHref(portfolioProject.repoUrl ?? portfolioProject.link) : undefined;
const isExternalPortfolioLink = portfolioProjectUrl ? isExternalHref(portfolioProjectUrl) : false;
---

<MainLayout title="Projects | Kira Cibak" description="A collection of web projects and technical builds by Kira Cibak.">
	<Section class="section">
		<Container class="page-hero">
			<h1 class="section-title"><span class="gradient-text">Things I've Built</span></h1>
			<p class="section-subtitle">Selected work spanning design, development, and deployment.</p>
		</Container>
	</Section>

	<Section class="section" reveal={true} style="padding-top: 0">
		<Container>
			<div class="grid-projects">
				{showcasedProjects.map((project) => (
					<ProjectCard
						title={project.title}
						description={project.description}
						tags={project.tags}
						image={project.image}
						featured={project.featured}
						link={project.link}
						repoUrl={project.repoUrl}
						liveUrl={project.liveUrl}
					/>
				))}
				{
					portfolioProject && portfolioProjectUrl ? (
						<Card as="article" hover={false} class="project-card project-card-cta" padding="compact">
							<div class="project-card-cta-content">
								<h3 class="heading-reset">{portfolioProject.title}</h3>
								<p class="muted-copy">{portfolioProject.description}</p>
								<div class="tag-row project-card-cta-tags" aria-label="Portfolio site technologies">
									{portfolioProject.tags.map((tag) => (
										<Tag class="project-skill-tag" hover={false}>{tag}</Tag>
									))}
								</div>
							</div>
							<div class="action-row project-card-cta-actions">
									<Button
										variant="secondary"
										href={portfolioProjectUrl}
										target={isExternalPortfolioLink ? '_blank' : undefined}
										rel={isExternalPortfolioLink ? 'noopener noreferrer' : undefined}
									>
									View Project
								</Button>
							</div>
						</Card>
					) : null
				}
			</div>
		</Container>
	</Section>
</MainLayout>
