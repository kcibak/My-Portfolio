---
import Layout from '../../layouts/Layout.astro';
import ProjectCarousel from '../../components/islands/ProjectCarousel.tsx';

export const prerender = true;

const projects = [
	{
		slug: 'sample-project',
		title: 'Sample project name',
		description: 'Brief description of the project focus and outcomes.',
		tags: ['Astro', 'Tailwind', 'A11y']
	},
	{
		slug: 'second-project',
		title: 'Second project',
		description: 'Highlight performance, UX, or business impact here.',
		tags: ['React', 'Design System']
	}
];
---

<Layout title="Projects | Kira Cibak" description="A collection of Kira Cibak’s web projects with case study links.">
	<section class="section">
		<p class="eyebrow">Projects</p>
		<h1 class="section-title">Case studies and builds</h1>
		<p class="section-subtitle">Swap the placeholder cards with your real projects. Each links to /projects/[slug].</p>
	</section>

	<section class="section">
		<h2 class="section-title">Interactive carousel (Astro Island)</h2>
		<p class="section-subtitle">Hydrated client:visible. Replace slides with real thumbnails and summaries.</p>
		<ProjectCarousel
			client:visible
			slides={projects.map((p) => ({
				title: p.title,
				summary: p.description,
				image: '/placeholder-project.jpg' // TODO: replace with real image path or Astro <Image />
			}))}
		/>
	</section>

	<section class="section">
		<h2 class="section-title">All projects</h2>
		<div class="grid-two">
			{projects.map((project) => (
				<article class="card" style="padding:1rem; display:grid; gap:0.6rem;">
					<div class="placeholder-image" style="height:150px;">Thumbnail placeholder</div>
					<h3 style="margin:0;">{project.title}</h3>
					<p style="margin:0; color:var(--color-muted);">{project.description}</p>
					<div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
						{project.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
					<a class="button secondary" href={`/projects/${project.slug}`}>
						Read the case study
					</a>
				</article>
			))}
		</div>
	</section>
</Layout>
