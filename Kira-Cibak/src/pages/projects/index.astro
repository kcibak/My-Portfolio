---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import ProjectCard from '../../components/project/ProjectCard.astro';
import ProjectCarousel from '../../components/project/ProjectCarousel.tsx';

export const prerender = true;

const projects = [
	{
		slug: 'sample-project',
		title: 'Sample project name',
		description: 'Brief description of the project focus and outcomes.',
		tags: ['Astro', 'Tailwind', 'A11y']
	},
	{
		slug: 'second-project',
		title: 'Second project',
		description: 'Highlight performance, UX, or business impact here.',
		tags: ['React', 'Design System']
	}
];
---

<MainLayout title="Projects | Kira Cibak" description="A collection of Kira Cibak’s web projects with case study links.">
	<Section class="section">
		<Container>
			<p class="eyebrow">Projects</p>
			<h1 class="section-title">Case studies and builds</h1>
			<p class="section-subtitle">Swap the placeholder cards with your real projects. Each links to /projects/[slug].</p>
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<h2 class="section-title">Interactive carousel (Astro Island)</h2>
			<p class="section-subtitle">Hydrated client:visible. Replace slides with real thumbnails and summaries.</p>
			<ProjectCarousel
				client:visible
				slides={projects.map((p) => ({
					title: p.title,
					summary: p.description,
					image: '/placeholder-project.jpg'
				}))}
			/>
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<h2 class="section-title">All projects</h2>
			<div class="grid-two">
				{projects.map((project) => (
					<ProjectCard
						title={project.title}
						description={project.description}
						tags={project.tags}
						href={`/projects/${project.slug}`}
						imageLabel="Thumbnail placeholder"
						imageSize="small"
						ctaLabel="Read the case study"
						density="default"
					/>
				))}
			</div>
		</Container>
	</Section>
</MainLayout>
