---
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

const slug = Astro.params.slug || 'post';
const title = slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
---

<Layout title={`${title} | Blog | Kira Cibak`} description={`Read ${title} by Kira Cibak.`}>
	<article class="section card" style="padding:1.2rem; display:grid; gap:0.9rem;">
		<p class="eyebrow">Blog</p>
		<h1 class="section-title">{title}</h1>
		<div class="placeholder-image" style="height:200px;">Featured image placeholder</div>
		<p class="section-subtitle" style="margin:0;">Replace this with your article introduction. Keep paragraphs short for mobile readability.</p>

		<section style="display:grid; gap:0.65rem; color:var(--color-muted); line-height:1.7;">
			<p><!-- Add your first section here. --></p>
			<p><!-- Add more content blocks as needed. --></p>
			<ul style="margin:0; padding-left:1.25rem; list-style:disc;">
				<li>Key takeaway one</li>
				<li>Key takeaway two</li>
				<li>Key takeaway three</li>
			</ul>
		</section>

		<footer style="display:flex; flex-wrap:wrap; gap:0.75rem;">
			<a class="button" href="/blog">Back to blog</a>
			<a class="button secondary" href="/contact">Discuss this topic</a>
		</footer>
	</article>
</Layout>
