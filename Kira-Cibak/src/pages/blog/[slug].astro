---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import BlogArticleContent from '../../components/pages/BlogArticleContent.astro';

export const prerender = true;

export function getStaticPaths() {
	return [
		{ params: { slug: 'example-post' } },
		{ params: { slug: 'performance-tips' } }
	];
}

const slug = Astro.params.slug || 'post';
const title = slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
---

<MainLayout title={`${title} | Blog | Kira Cibak`} description={`Read ${title} by Kira Cibak.`}>
	<Section class="section">
		<Container>
			<BlogArticleContent title={title} />
		</Container>
	</Section>
</MainLayout>
