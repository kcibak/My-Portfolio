---
import MainLayout from '../../layouts/MainLayout.astro';
import Section from '../../components/layout/Section.astro';
import Container from '../../components/layout/Container.astro';
import BlogPreviewCard from '../../components/pages/BlogPreviewCard.astro';

export const prerender = true;

const posts = [
	{
		slug: 'example-post',
		title: 'Example blog post',
		summary: 'Swap with a real article summary. Keep it under 140 characters.'
	},
	{
		slug: 'performance-tips',
		title: 'Performance tips',
		summary: 'Cover image optimization, code splitting, and accessibility wins.'
	}
];
---

<MainLayout title="Blog | Kira Cibak" description="Articles on front-end development, performance, and design systems by Kira Cibak.">
	<Section class="section">
		<Container class="page-hero">
			<h1 class="section-title">Notes on building for the web</h1>
			<p class="section-subtitle">Replace these cards with your real posts. Each should map to /blog/[slug].</p>
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<div class="grid-two">
				{posts.map((post) => (
					<BlogPreviewCard title={post.title} summary={post.summary} href={`/blog/${post.slug}`} height="small" />
				))}
			</div>
		</Container>
	</Section>
</MainLayout>
