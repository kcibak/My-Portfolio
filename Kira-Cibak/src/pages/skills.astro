---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import SkillsCategories from '../components/pages/SkillsCategories.astro';
import SkillsTimeline from '../components/pages/SkillsTimeline.astro';
import SkillsSnapshot from '../components/pages/SkillsSnapshot.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
export const prerender = true;
---

<MainLayout title="Skills | Kira Cibak" description="Technical skills, tools, and capabilities for Kira Cibak.">
	<Section class="section">
		<Container>
			<p class="eyebrow">Skills</p>
			<h1 class="section-title"><span class="gradient-text">Technical range</span></h1>
			<p class="section-subtitle">The tools and technologies I use to build reliable products — organized by domain.</p>
		</Container>
	</Section>

	<Section class="section" reveal={true} style="padding-top: 0">
		<Container>
			<SectionHeading title="Experience & Education" size="sub" />
			<SkillsTimeline />
		</Container>
	</Section>

	<Section class="section" reveal={true} style="padding-top: 0">
		<Container>
			<SectionHeading title="Skills & Tools" size="sub" />
			<div class="skills-split">
				<div class="skills-split-left">
					<SkillsCategories />
				</div>
				<div class="skills-split-right">
					<SkillsSnapshot />
				</div>
			</div>
		</Container>
	</Section>
</MainLayout>

<style>
	.skills-split {
		display: grid;
		grid-template-columns: 1fr 300px;
		gap: 3rem;
		align-items: start;
	}

	.skills-split-right {
	}

	@media (max-width: 900px) {
		.skills-split {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.skills-split-right {
			max-width: none;
		}
	}
</style>
