---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import SkillsCategories from '../components/pages/SkillsCategories.astro';
import SkillsTimeline from '../components/pages/SkillsTimeline.astro';

export const prerender = true;
---

<MainLayout title="Skills | Kira Cibak" description="Technical skills, tools, and capabilities for Kira Cibak.">
	<Section class="section">
		<Container>
			<p class="eyebrow">Skills</p>
			<h1 class="section-title">Technical range</h1>
			<p class="section-subtitle">Swap these lists with your own stack. Keep categories short and scannable for recruiters.</p>
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<SkillsCategories />
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<p class="eyebrow">Experience</p>
			<h2 class="section-title">Experience and education</h2>
			<p class="section-subtitle">Replace the placeholders with your real roles, dates, and achievements.</p>
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<SkillsTimeline />
		</Container>
	</Section>
</MainLayout>
