---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import SkillsCategories from '../components/pages/SkillsCategories.astro';
import SkillsTimeline from '../components/pages/SkillsTimeline.astro';
import SkillsSnapshot from '../components/pages/SkillsSnapshot.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
export const prerender = true;
---

<MainLayout title="Skills | Kira Cibak" description="Technical skills, tools, and capabilities for Kira Cibak.">
	<Section class="section">
		<Container class="page-hero">
			<h1 class="section-title"><span class="gradient-text">Technical range</span></h1>
			<p class="section-subtitle">The arsenal of abilities I've acquired through education, experience, and effort.</p>
		</Container>
	</Section>

	<Section class="section" reveal={true} style="padding-top: 0">
		<Container>
			<SectionHeading title="Experience & Education" size="sub" />
			<SkillsTimeline />
		</Container>
	</Section>

	<Section class="section" reveal={true} style="padding-top: 0">
		<Container>
			<SectionHeading title="Skills & Tools" size="sub" />
			<SkillsCategories />
		</Container>
	</Section>
</MainLayout>

