---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import SkillsCategories from '../components/pages/SkillsCategories.astro';
import SkillsTimeline from '../components/pages/SkillsTimeline.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';

export const prerender = true;
---

<MainLayout title="Skills | Kira Cibak" description="Technical skills, tools, and capabilities for Kira Cibak.">
	<Section class="section">
		<Container>
			<p class="eyebrow">Skills</p>
			<h1 class="section-title"><span class="gradient-text">Technical range</span></h1>
			<p class="section-subtitle">The tools and technologies I use to build reliable products — organized by domain.</p>
		</Container>
	</Section>

	<Section class="section" reveal={true}>
		<Container>
			<SkillsCategories />
		</Container>
	</Section>

	<Section class="section" reveal={true}>
		<Container>
			<SectionHeading title="Experience & education" />
			<SkillsTimeline />
		</Container>
	</Section>
</MainLayout>
