---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import ContactLinksPanel from '../components/pages/ContactLinksPanel.astro';

const socials = [
	{ href: 'https://www.linkedin.com/in/kira-cibak/', label: 'LinkedIn', icon: 'linkedin' },
	{ href: 'https://github.com/kcibak', label: 'GitHub', icon: 'github' }
] as const;

const emailAddress = 'kiracibakcodes@gmail.com';
const resumeHref = '/Kira%20Cibak_2025.pdf';

export const prerender = true;
---

<MainLayout
	title="Contact | Kira Cibak"
	description="Get in touch with Kira Cibak for web projects and collaborations."
	centered={true}
	bodyClass="contact-page"
	mainClass="contact-main"
>
	<Section class="section contact-section">
		<Container class="contact-page-frame">
			<ContactLinksPanel socials={[...socials]} emailAddress={emailAddress} resumeHref={resumeHref} />
		</Container>
	</Section>
</MainLayout>
