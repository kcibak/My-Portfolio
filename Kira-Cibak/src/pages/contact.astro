---
import Layout from '../layouts/Layout.astro';

const socials = [
	{ href: 'https://www.linkedin.com/in/kira-cibak/', label: 'LinkedIn', icon: 'linkedin' },
	{ href: 'https://github.com/kcibak', label: 'GitHub', icon: 'github' }
];

const emailAddress = 'cibakkn@gmail.com';
const resumeHref = '/Kira%20Cibak_2025.pdf';

export const prerender = true;
---

<Layout title="Contact | Kira Cibak" description="Get in touch with Kira Cibak for web projects and collaborations.">
	<section class="contact-shell">
		<div class="contact-hero">
			<h1>Get In Touch</h1>
		</div>

		<div class="contact-actions">
			{socials.map((link) => (
				<a class="contact-action" href={link.href} target="_blank" rel="noreferrer" aria-label={link.label}>
					<span class="icon-wrap">
						{link.icon === 'linkedin' ? (
							<svg aria-hidden="true" width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
								<path d="M6.94 9.75V18" />
								<circle cx="6.94" cy="6.94" r="1.6" />
								<path d="M12 18v-5.21c0-1.53 1.24-2.77 2.77-2.77s2.77 1.24 2.77 2.77V18" />
							</svg>
						) : (
							<svg aria-hidden="true" width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
								<path d="M9 19c-4 1-4-2-6-2m12 4v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7a5.44 5.44 0 0 0-1.5-3.75 5.07 5.07 0 0 0-.09-3.77S18.16-1 15 1.38a13.38 13.38 0 0 0-6 0C5-1 3.09 1 3.09 1a5.07 5.07 0 0 0-.09 3.77A5.44 5.44 0 0 0 1.5 8.5c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 7 18.13V22" />
							</svg>
						)}
					</span>
					<span class="action-label">{link.label}</span>
				</a>
			))}

			<a class="contact-action" href={resumeHref} target="_blank" rel="noopener noreferrer" aria-label="View Resume">
				<span class="icon-wrap">
					<svg aria-hidden="true" width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
						<path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z" />
						<path d="M14 2v5h5" />
						<path d="M9 13h6" />
						<path d="M9 17h6" />
					</svg>
				</span>
				<span class="action-label">View Resume</span>
			</a>

			<button class="contact-action" type="button" data-copy-email={emailAddress} aria-label={`Copy ${emailAddress}`}>
				<span class="icon-wrap">
					<svg aria-hidden="true" width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
						<path d="m3 8 7.89 4.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z" />
					</svg>
				</span>
				<span class="action-label">Copy Email</span>
			</button>
		</div>
	</section>

	<script>
		(() => {
			const copyButton = document.querySelector('[data-copy-email]');

			if (!copyButton) return;

			copyButton.addEventListener('click', async () => {
				const email = copyButton.getAttribute('data-copy-email');
				if (!email) return;

				try {
					await navigator.clipboard.writeText(email);
				} catch (error) {
					console.error('Could not copy email', error);
				}
			});
		})();
	</script>

	<style>
		.contact-shell {
			max-width: 1100px;
			margin: 0 auto;
			padding: 3rem 1.25rem 28rem;
			display: flex;
			flex-direction: column;
			gap: 3rem;
			text-align: center;
			min-height: 100vh;
			justify-content: center;
		}

		.contact-hero h1 {
			font-size: clamp(2.6rem, 3vw + 1rem, 3.6rem);
			line-height: 1.08;
			margin: 0;
			color: var(--color-ink);
		}

		.contact-actions {
			display: flex;
			flex-wrap: nowrap;
			justify-content: center;
			gap: 2rem;
		}

		.contact-action {
			position: relative;
			display: inline-flex;
			flex-direction: column;
			align-items: center;
			gap: 1.2rem;
			padding: 0.4rem 0.6rem;
			border-radius: 18px;
			border: none;
			background: transparent;
			color: var(--color-ink);
			box-shadow: none;
			transition: transform 0.2s ease, color 0.2s ease;
			text-align: center;
			text-decoration: none;
			min-width: 240px;
			cursor: pointer;
		}

		.contact-action:hover,
		.contact-action:focus-visible {
			transform: translateY(-2px) scale(1.04);
			color: var(--color-accent);
			outline: none;
		}

		.contact-action:focus-visible {
			box-shadow: none;
			outline: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
		}

		.contact-action button,
		.contact-action a {
			background: none;
			border: none;
			padding: 0;
			margin: 0;
			font: inherit;
		}

		.icon-wrap {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 5.04rem;
			height: 5.04rem;
			border-radius: 18px;
			border: none;
			background: transparent;
			color: var(--color-ink);
			transition: transform 0.2s ease, color 0.2s ease;
		}

		.contact-action:hover .icon-wrap,
		.contact-action:focus-visible .icon-wrap {
			color: var(--color-accent);
			transform: translateY(-2px) scale(1.08);
		}

		.action-label {
			font-weight: 700;
			color: var(--color-ink);
			letter-spacing: 0.04em;
			font-size: 1.05rem;
		}

		.contact-action[data-copied='true'] .action-label {
			color: var(--color-accent);
		}

		.contact-action[data-copied='true'] .icon-wrap {
			border-color: var(--color-accent);
			color: var(--color-accent);
		}

			@media (max-width: 768px) {
			.contact-actions {
				flex-wrap: wrap;
				gap: 1.8rem;
			}
		}
	</style>

	<style>
		:global(body) {
			overflow: hidden;
		}
	</style>
</Layout>
