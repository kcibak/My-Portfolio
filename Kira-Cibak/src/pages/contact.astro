---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="Contact | Kira Cibak" description="Get in touch with Kira Cibak for web projects and collaborations.">
	<section class="space-y-6">
		<p class="text-sm font-semibold uppercase tracking-[0.18em] text-sand/60">Contact</p>
		<h1 class="text-3xl sm:text-4xl font-semibold">Let’s talk</h1>
		<p class="text-base text-sand/80 max-w-3xl">Use the form to reach out. Replace the action with your preferred endpoint or email service.</p>
	</section>

	<section class="mt-10 grid gap-6 lg:grid-cols-2">
		<form class="rounded-xl border border-white/10 bg-white/5 p-6 space-y-4" method="post" action="#">
			<div>
				<label class="block text-sm font-semibold text-sand" for="name">Name</label>
				<input class="mt-2 w-full rounded-lg border border-white/15 bg-ink/60 px-4 py-3 text-sm text-white placeholder:text-sand/50 focus:border-accent focus:outline-none" id="name" name="name" type="text" placeholder="Your name" required />
			</div>
			<div>
				<label class="block text-sm font-semibold text-sand" for="email">Email</label>
				<input class="mt-2 w-full rounded-lg border border-white/15 bg-ink/60 px-4 py-3 text-sm text-white placeholder:text-sand/50 focus:border-accent focus:outline-none" id="email" name="email" type="email" placeholder="you@example.com" required />
			</div>
			<div>
				<label class="block text-sm font-semibold text-sand" for="message">Project details</label>
				<textarea class="mt-2 w-full rounded-lg border border-white/15 bg-ink/60 px-4 py-3 text-sm text-white placeholder:text-sand/50 focus:border-accent focus:outline-none" id="message" name="message" rows="5" placeholder="Timeline, budget, and goals" required></textarea>
			</div>
			<button class="w-full inline-flex items-center justify-center gap-2 rounded-full bg-accent text-ink px-5 py-3 text-sm font-semibold shadow-lg shadow-accent/30 transition hover:-translate-y-0.5" type="submit">
				Send message
			</button>
		</form>
		<div class="rounded-xl border border-white/10 bg-gradient-to-br from-white/10 to-white/0 p-6 space-y-4">
			<h2 class="text-xl font-semibold">Other ways</h2>
			<ul class="space-y-3 text-sm text-sand/80">
				<li><strong class="text-sand">Email:</strong> hello@kira.dev (update with your email)</li>
				<li><strong class="text-sand">LinkedIn:</strong> Add your profile link</li>
				<li><strong class="text-sand">Calendly:</strong> Swap with your scheduling link</li>
			</ul>
		</div>
	</section>
</Layout>
