---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import AboutIntro from '../components/pages/AboutIntro.astro';
import AboutHighlights from '../components/pages/AboutHighlights.astro';
import AboutValues from '../components/pages/AboutValues.astro';
import AboutChatReplay from '../components/pages/AboutChatReplay.astro';
import Card from '../components/ui/Card.astro';
import Tag from '../components/ui/Tag.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';

export const prerender = true;
---

<MainLayout title="About | Kira Cibak" description="Learn about Kira Cibak’s background, process, and approach to building for the web.">
	<Section class="section">
		<Container>
			<AboutIntro />
		</Container>
	</Section>

	<Section class="section" reveal={true}>
		<Container>
			<AboutHighlights />
		</Container>
	</Section>

	<Section class="section" reveal={true}>
		<Container>
			<AboutValues />
		</Container>
	</Section>

	<Section class="section" reveal={true}>
		<Container>
			<SectionHeading
				title="Credentials"
				subtitle="Certifications and education that ground my technical decisions."
			/>
			<div class="grid-two">
				<Card as="article" class="stack-card" padding="compact">
					<div class="row-between-wrap">
						<h3 class="heading-reset">Microsoft Azure Fundamentals</h3>
						<Tag>AZ-900</Tag>
					</div>
					<p class="muted-copy" style="margin: 0;">Cloud-certified foundation for secure, cost-aware infrastructure.</p>
				</Card>
				<Card as="article" class="stack-card" padding="compact">
					<div class="row-between-wrap">
						<h3 class="heading-reset">Education</h3>
						<Tag>Degree</Tag>
					</div>
					<p class="muted-copy" style="margin: 0;">Formal training plus continuous learning through production work.</p>
				</Card>
			</div>
		</Container>
	</Section>

	<Section class="section" reveal={true}>
		<Container>
			<AboutChatReplay />
		</Container>
	</Section>
</MainLayout>
