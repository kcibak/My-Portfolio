---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import AboutIntro from '../components/pages/AboutIntro.astro';
import AboutHighlights from '../components/pages/AboutHighlights.astro';
import AboutValues from '../components/pages/AboutValues.astro';

export const prerender = true;
---

<MainLayout title="About | Kira Cibak" description="Learn about Kira Cibak’s background, process, and approach to building for the web.">
	<Section class="section">
		<Container>
			<AboutIntro />
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<AboutHighlights />
		</Container>
	</Section>

	<Section class="section">
		<Container>
			<AboutValues />
		</Container>
	</Section>
</MainLayout>
