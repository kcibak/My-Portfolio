---
import '../styles/global.css';
import Container from '../components/layout/Container.astro';
import Header from '../components/layout/Header.astro';
import { themeBootScript } from '../lib/theme';

const {
	title = 'Kira Cibak – Portfolio',
	description = 'I build digital products that help achieve goals.',
	centered = false,
	htmlClass = '',
	bodyClass = '',
	mainClass = ''
} = Astro.props;


const canonical = Astro.site
	? new URL(Astro.url.pathname, Astro.site).href
	: Astro.url.href;
---

<!doctype html>
<html lang="en" class:list={['scroll-smooth', htmlClass]}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline set:html={themeBootScript}></script>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta property="og:title" content="Kira Cibak – Portfolio" />
		<meta property="og:description" content="I build digital products that help achieve goals." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://kiracibak.codes/?v=2" />
		<meta property="og:image" content="https://kiracibak.codes/pfp-og.jpg?v=2" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content="https://kiracibak.codes/pfp-og.jpg?v=2" />
	</head>
	<body class={bodyClass}>
		<a href="#main" class="skip-link">
			Skip to content
		</a>
		<Header />
		<Container as="main" id="main" class:list={[centered && 'main-centered', mainClass]}>
			<slot />
		</Container>
		<script>
			const revealEls = document.querySelectorAll('[data-reveal]');
			if (revealEls.length) {
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((e) => {
							if (e.isIntersecting) {
								e.target.classList.add('is-visible');
								io.unobserve(e.target);
							}
						});
					},
					{ threshold: 0.12 }
				);
				revealEls.forEach((el) => io.observe(el));
			}
		</script>
	</body>
</html>
